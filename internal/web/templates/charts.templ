package templates

import "altalune.id/yasaku/internal/web"

const echartsVersion = "6.1.0"

templ chartAssets(d web.LayoutData) {
	if d.UIMode == web.UIModeVendored {
		<script defer src={ d.Static("echarts.min.js") }></script>
	} else {
		<script defer src={ "https://cdn.jsdelivr.net/npm/echarts@" + echartsVersion + "/dist/echarts.min.js" }></script>
	}
	<script defer src={ d.Static("charts.js") }></script>
}

// Chart renders a container plus its JSON payload; charts.js draws it.
templ Chart(id, kind, payload, class string) {
	<div id={ id } data-chart={ kind } class={ "min-h-[16rem] w-full " + class }></div>
	@chartPayloadScript(id, payload)
}
