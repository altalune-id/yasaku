package templates

// PageHeader renders the page title and an optional subtitle; its children are the page actions.
templ PageHeader(title, subtitle string) {
	<header class="flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
		<div class="min-w-0 flex-[1_1_12rem]">
			<h1 class="flex min-h-11 items-center text-2xl font-bold tracking-tight text-balance">{ title }</h1>
			if subtitle != "" {
				<p class="text-sm text-pretty text-base-content/70">{ subtitle }</p>
			}
		</div>
		<div class="flex shrink-0 items-center gap-2 empty:hidden">
			{ children... }
		</div>
	</header>
}

// AppButton renders a link styled as a kit button that never wraps; class carries the variant.
templ AppButton(href, class string, attrs templ.Attributes) {
	<a href={ templ.SafeURL(href) } class={ "btn shrink-0 whitespace-nowrap", class } { attrs... }>
		{ children... }
	</a>
}
