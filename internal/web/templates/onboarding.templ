package templates

import "altalune.id/yasaku/internal/web"

type OnboardingView struct {
	Email       string
	DisplayName string
	ReturnTo    string
	Error       string
	ErrorCode string
}

templ OnboardingPage(d web.LayoutData, v OnboardingView) {
	<section class="mx-auto max-w-md">
		<h1 class="text-2xl font-semibold">{ d.Tr("onboarding.title") }</h1>
		<p class="mt-2 text-base-content/70">{ d.Tr("onboarding.subtitle_prefix") } { v.Email }{ d.Tr("onboarding.subtitle_suffix") }</p>
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		<form method="post" action={ templ.SafeURL(d.Href("/onboarding")) } class="mt-6 space-y-4">
			if v.ReturnTo != "" {
				<input type="hidden" name="return_to" value={ v.ReturnTo }/>
			}
			{{ nameField := FieldProps{ID: "display_name", Label: d.Tr("onboarding.display_name")} }}
			@FormField(nameField) {
				<input
					{ nameField.Attrs()... }
					name="display_name"
					type="text"
					required
					value={ v.DisplayName }
					class="input w-full"
				/>
			}
			<label class="flex items-start gap-2 text-sm">
				<input type="checkbox" name="accept_terms" value="1" required class="mt-1"/>
				<span>{ d.Tr("onboarding.accept") }</span>
			</label>
			<button type="submit" class="btn btn-primary btn-block">
				{ d.Tr("onboarding.submit") }
			</button>
		</form>
	</section>
}

templ OnboardingLayout(d web.LayoutData, v OnboardingView) {
	@Layout(web.WithContent(d, OnboardingPage(d, v)))
}
