package templates

import (
	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
	"altalune.id/yasaku/money"
)

// YasakuWalletCard is one wallet tile under the overview totals.
type YasakuWalletCard struct {
	ID       string
	Name     string
	Kind     string
	Balance  money.Amount
	Excluded bool
}

// YasakuOverviewView is the project overview: what is left to spend, what moved this period, what just happened.
type YasakuOverviewView struct {
	ProjectSlug string
	ProjectName string
	Spendable   money.Amount
	Total       money.Amount
	HasPeriod   bool
	PeriodName  string
	Income      money.Amount
	Expense     money.Amount
	Net         money.Amount
	Wallets     []YasakuWalletCard
	Form        TxFormView
	List        TxListView
}

templ YasakuOverviewPage(d web.LayoutData, v YasakuOverviewView) {
	<section class="flex flex-col gap-4">
		<header>
			<p class="text-sm text-muted-foreground">{ v.ProjectName }</p>
			<h1 class="mt-0.5 text-sm font-medium text-muted-foreground">{ d.Tr("overview.spendable") }</h1>
			<p class="mt-1 text-4xl font-semibold tabular-nums tracking-tight text-foreground">{ Money(d, v.Spendable) }</p>
			<p class="mt-1 text-sm text-muted-foreground">
				{ d.Tr("overview.total") }
				<span class="ms-1 tabular-nums text-foreground/80">{ Money(d, v.Total) }</span>
			</p>
		</header>
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
			@TransactionForm(d, v.Form)
			<div class="flex flex-col gap-4">
				@yasakuPeriodCard(d, v)
				@yasakuWalletCards(d, v)
			</div>
		</div>
		<div>
			<div class="flex items-baseline justify-between">
				<h2 class="text-sm font-medium text-muted-foreground">{ d.Tr("overview.recent") }</h2>
				<a
					href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/transactions")) }
					class="text-sm font-medium text-primary hover:underline"
				>
					{ d.Tr("overview.see_all") }
				</a>
			</div>
			@TransactionList(d, v.List)
		</div>
		@ToastSlot()
	</section>
}

templ yasakuPeriodCard(d web.LayoutData, v YasakuOverviewView) {
	<div class="rounded-xl border border-border bg-card p-4 shadow-sm">
		<div class="flex items-baseline justify-between">
			<h2 class="text-sm font-medium text-muted-foreground">{ d.Tr("overview.this_period") }</h2>
			if v.HasPeriod {
				<span class="text-xs text-muted-foreground">{ v.PeriodName }</span>
			}
		</div>
		if !v.HasPeriod {
			<p class="mt-3 text-sm text-muted-foreground">{ d.Tr("period.no_period") }</p>
		} else {
			<dl class="mt-3 grid grid-cols-3 gap-2">
				@yasakuStat(d.Tr("overview.income"), Money(d, v.Income), "text-emerald-600 dark:text-emerald-400")
				@yasakuStat(d.Tr("overview.expense"), Money(d, v.Expense), "text-foreground")
				@yasakuStat(d.Tr("overview.net"), SignedMoney(d, v.Net), "text-foreground")
			</dl>
		}
	</div>
}

templ yasakuStat(label, value, tone string) {
	<div>
		<dt class="text-xs text-muted-foreground">{ label }</dt>
		<dd class={ "mt-0.5 text-base font-semibold tabular-nums", tone }>{ value }</dd>
	</div>
}

templ yasakuWalletCards(d web.LayoutData, v YasakuOverviewView) {
	<div class="rounded-xl border border-border bg-card p-4 shadow-sm">
		<div class="flex items-baseline justify-between">
			<h2 class="text-sm font-medium text-muted-foreground">{ d.Tr("nav.wallets") }</h2>
			<a
				href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/wallets")) }
				class="text-sm font-medium text-primary hover:underline"
			>
				{ d.Tr("overview.see_all") }
			</a>
		</div>
		if len(v.Wallets) == 0 {
			<p class="mt-3 text-sm font-medium text-foreground">{ d.Tr("overview.no_wallets") }</p>
			<p class="mt-1 text-sm text-muted-foreground">{ d.Tr("overview.no_wallets_hint") }</p>
		}
		<ul class="mt-3 space-y-2">
			for _, w := range v.Wallets {
				<li class="flex items-center gap-2">
					@icons.Icon("wallet", "h-4 w-4 shrink-0 text-muted-foreground")
					<span class="min-w-0 flex-1 truncate text-sm text-foreground">{ w.Name }</span>
					<span class={ "shrink-0 text-sm tabular-nums", templ.KV("text-muted-foreground", w.Excluded) }>
						{ Money(d, w.Balance) }
					</span>
				</li>
			}
		</ul>
	</div>
}

templ YasakuOverviewLayout(d web.LayoutData, v YasakuOverviewView) {
	@Layout(web.WithContent(d, YasakuOverviewPage(d, v)))
}
