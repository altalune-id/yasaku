package templates

import (
	"cmp"
	"slices"
	"strconv"
	"strings"
	"time"

	"github.com/google/uuid"

	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
	"altalune.id/yasaku/money"
)

// TxWalletOption is one wallet in the add-sheet wallet picker, carrying how its own currency is typed.
type TxWalletOption struct {
	ID       string
	Name     string
	Balance  money.Amount
	Selected bool
	Symbol   string
	Currency string
	Exponent int
}

// TxCategoryOption is one category in the add-sheet grid.
type TxCategoryOption struct {
	ID        string
	Name      string
	Icon      string
	Kind      string
	Selected  bool
	Suggested bool
}

// TxPeriodOption is one selectable budget period on the add sheet.
type TxPeriodOption struct {
	ID       string
	Label    string
	Selected bool
}

// TxRecentOption is one past entry the add sheet offers to refill the form, filtered by its category.
type TxRecentOption struct {
	CategoryID string
	Kind       string
	Icon       string
	Note       string
	Label      string
	Amount     money.Amount
	Input      string
	WalletID   string
}

// TxFormView is the add sheet and edit form: one amount, one kind, one wallet, one date, one note.
type TxFormView struct {
	ProjectSlug   string
	ID            string
	Kind          string
	Amount        string
	WalletID      string
	ToWalletID    string
	CategoryID    string
	PeriodID      string
	Date          string
	Today         string
	Yesterday     string
	Note          string
	Wallets       []TxWalletOption
	Categories    []TxCategoryOption
	Periods       []TxPeriodOption
	RecentEntries []TxRecentOption
	Symbol        string
	Currency      string
	Exponent      int
	Decimal       string
	NoWallet      bool
	Recent        bool
	Return        string
	FullPage      bool
	InDialog      bool
	Error         string
	ErrorCode     string
	AmountError   string
	WalletError   string
	RecordedAt    time.Time
	UpdatedAt     time.Time
}

// TransactionForm is the add sheet, or the "Create a wallet" call to action when the project has no active wallet.
templ TransactionForm(d web.LayoutData, v TxFormView) {
	if v.NoWallet {
		@txNoWallet(d, v)
	} else {
		<form
			id="tx-quick-add"
			method="post"
			action={ templ.SafeURL(txFormAction(d, v)) }
			{ txFormSwap(d, v)... }
			data-tx-sheet
			data-category-picked?={ v.ID != "" && v.CategoryID != "" }
			class="group flex min-h-0 min-w-0 flex-1 flex-col lg:grid lg:grid-cols-5 lg:grid-rows-[auto_minmax(0,1fr)]"
		>
			if v.InDialog {
				<input type="hidden" name="surface" value="dialog"/>
			}
			if v.Recent {
				<input type="hidden" name="list" value="recent"/>
			}
			<input type="hidden" name="return" value={ cmp.Or(v.Return, TxReturnFor(d.CurrentPath)) }/>
			<div class="flex items-center gap-2 border-b border-base-300 px-4 pt-3 pb-2 lg:col-span-5">
				@txKindTabs(d, v)
				if v.InDialog {
					<button type="button" data-dialog-close aria-label={ d.Tr("dialog.close") } class="btn btn-ghost btn-square">
						@icons.Icon("x", "size-5")
					</button>
				}
			</div>
			<div data-tx-fields class="min-h-0 min-w-0 flex-1 overflow-y-auto px-4 pt-3 pb-4 lg:col-span-3">
				<div id="tx-form-errors" class="empty:hidden">
					if v.Error != "" {
						<div data-tx-error="1" class="mb-3">
							@ErrorBanner(d, v.Error, v.ErrorCode)
						</div>
					}
				</div>
				if v.ID != "" {
					<input type="hidden" name="kind" value={ v.Kind } data-tx-kind-locked="1"/>
					<p class="mb-2 text-xs text-base-content/70">{ d.Tr("tx.kind_locked") }</p>
				}
				@txAmountField(d, v)
				@txRecent(d, v)
				@TxCategoryChips(d, v)
				@txChips(d, v)
				<div class="mt-2 hidden group-has-[[data-note-toggle]:checked]:grid">
					{{ noteField := FieldProps{ID: "tx-note", Label: d.Tr("tx.note")} }}
					@FormField(noteField) {
						<input
							{ noteField.Attrs()... }
							name="note"
							type="text"
							autocomplete="off"
							value={ v.Note }
							maxlength="500"
							hx-post={ d.ProjectPath(v.ProjectSlug, "/transactions/suggest") }
							hx-nonce={ d.Nonce }
							hx-trigger="input changed delay:400ms"
							hx-target="#tx-category"
							hx-swap="outerHTML"
							hx-status:4xx="target:#hx-error swap:innerHTML"
							hx-status:5xx="target:#hx-error swap:innerHTML"
							hx-include="[name='kind'],[name='category_id']"
							class="input w-full text-base"
						/>
					}
				</div>
				@DateInputHint(d)
				if len(v.Periods) > 1 {
					<div class="mt-3">
						{{ periodField := FieldProps{ID: "tx-period", Label: d.Tr("tx.period")} }}
						@FormField(periodField) {
							<select { periodField.Attrs()... } name="period_id" class="select w-full">
								<option value="">{ d.Tr("tx.period_auto") }</option>
								for _, p := range v.Periods {
									<option value={ p.ID } selected?={ p.Selected }>{ p.Label }</option>
								}
							</select>
						}
					</div>
				}
			</div>
			<div
				class={ "border-t border-base-300 bg-base-100 px-4 pt-3 pb-[max(1rem,env(safe-area-inset-bottom,0px))] lg:col-span-2 lg:flex lg:flex-col lg:justify-end lg:border-s lg:border-t-0",
					templ.KV("max-lg:sticky max-lg:bottom-16 max-lg:z-10", !v.InDialog) }
			>
				@txKeypad(d, v)
				<button type="submit" data-tx-save class="btn btn-primary btn-block mt-3 h-12 text-base">{ d.Tr("tx.sheet.save") }</button>
				if v.InDialog {
					<p class="mt-2 hidden justify-center gap-3 text-xs text-base-content/70 sm:flex">
						<span>{ d.Tr("tx.sheet.hint_type") }</span>
						<span><kbd class="kbd kbd-xs">Enter</kbd> { d.Tr("tx.sheet.save") }</span>
						<span><kbd class="kbd kbd-xs">Esc</kbd> { d.Tr("dialog.close") }</span>
					</p>
				}
			</div>
			@txSheetAssets(d)
		</form>
	}
}

templ txNoWallet(d web.LayoutData, v TxFormView) {
	@EmptyState(EmptyStateProps{
		Title:        d.Tr("tx.no_wallet.title"),
		Body:         cmp.Or(v.WalletError, d.Tr("tx.no_wallet.body")),
		Icon:         "wallet",
		HeadingLevel: txNoWalletHeading(v),
	}) {
		@AppButton(d.ProjectPath(v.ProjectSlug, "/wallets/new"), "btn-primary", nil) {
			@icons.Icon("plus", "size-4")
			{ d.Tr("tx.no_wallet.cta") }
		}
	}
}

templ txKindTabs(d web.LayoutData, v TxFormView) {
	<div role="radiogroup" aria-label={ d.Tr("tx.kind") } class="tabs tabs-box min-w-0 flex-1">
		@txKindTab(d, v, "expense", "tx.kind_expense")
		@txKindTab(d, v, "income", "tx.kind_income")
		@txKindTab(d, v, "transfer", "tx.kind_transfer")
	</div>
}

templ txKindTab(d web.LayoutData, v TxFormView, kind, key string) {
	<input
		type="radio"
		name="kind"
		class={ "tab flex-1 checked:font-semibold", templ.KV("tab-active font-semibold", v.ID != "" && v.Kind == kind) }
		value={ kind }
		aria-label={ d.Tr(key) }
		checked?={ v.Kind == kind }
		disabled?={ v.ID != "" }
		data-tx-kind={ kind }
	/>
}

// NOTE: the mirror repeats the value invisibly so the underline spans only the digits; the native caret stays hidden.
templ txAmountField(d web.LayoutData, v TxFormView) {
	{{ amountField := FieldProps{ID: "tx-amount", Label: d.Tr("tx.amount"), Error: v.AmountError} }}
	@FormField(amountField) {
		<div class="-mt-1.5 min-w-0">
			<div class="flex min-w-0 items-baseline gap-2">
				<span data-tx-symbol-slot class="text-2xl font-bold text-base-content/70">{ v.Symbol }</span>
				<div class="relative min-w-0 flex-1">
					<input
						{ amountField.Attrs()... }
						name="amount"
						type="text"
						inputmode="decimal"
						enterkeyhint="done"
						autocomplete="off"
						autofocus
						required
						value={ v.Amount }
						placeholder="0"
						data-keypad-input
						data-decimal={ v.Decimal }
						data-exponent={ strconv.Itoa(v.Exponent) }
						data-currency={ v.Currency }
						class="input input-ghost peer block h-11 w-full min-w-0 border-0 bg-transparent p-0 text-4xl font-extrabold tracking-tight tabular-nums shadow-none outline-none placeholder:text-base-content/40 focus:bg-transparent focus:shadow-none focus:outline-none caret-transparent"
					/>
					<div
						aria-hidden="true"
						data-amount-mirror
						class="pointer-events-none absolute inset-0 flex items-center overflow-hidden text-4xl font-extrabold tracking-tight whitespace-pre text-transparent tabular-nums peer-focus:[&>[data-amount-text]]:border-base-content/50 peer-aria-invalid:[&>[data-amount-text]]:border-error"
					>
						<span data-amount-text class="border-b-2 border-base-content/20">{ cmp.Or(v.Amount, "0") }</span>
					</div>
				</div>
				<button type="button" data-key="clear" hidden class="btn btn-ghost btn-circle shrink-0" aria-label={ d.Tr("tx.keypad.clear") }>
					@icons.Icon("x", "size-5")
				</button>
			</div>
			<p id="tx-amount-preview" data-keypad-preview aria-live="polite" class="h-5 text-sm text-base-content/70 tabular-nums"></p>
		</div>
	}
}

templ txRecent(d web.LayoutData, v TxFormView) {
	if len(v.RecentEntries) > 0 {
		<div data-recent-box hidden class="group/recent mt-2 grid min-w-0 gap-1">
			<template data-recent-tip>
				@TipInline(d, "recent-fill")
			</template>
			<p class="text-xs font-semibold text-base-content/70 group-has-[[data-tip]]/recent:hidden">{ d.Tr("tx.recent") }</p>
			<div class="flex min-w-0 gap-2 overflow-x-auto pb-1">
				for _, r := range v.RecentEntries {
					<button
						type="button"
						data-recent
						data-category={ r.CategoryID }
						data-kind={ r.Kind }
						data-amount={ r.Input }
						data-note={ r.Note }
						data-wallet={ r.WalletID }
						hidden
						class="btn h-11 shrink-0 font-medium"
					>
						if r.Icon != "" {
							@icons.Icon(r.Icon, "size-4")
						}
						{ r.Label }
						<span data-compact={ r.Amount.Major() } data-symbol={ CurrencySymbol(d, r.Amount.Currency) } class="text-base-content/70 tabular-nums">{ Money(d, r.Amount) }</span>
					</button>
				}
			</div>
		</div>
	}
}

// TxCategoryChips is the category grid, ordered by use; the note field's suggestion request swaps it.
templ TxCategoryChips(d web.LayoutData, v TxFormView) {
	<div id="tx-category" role="radiogroup" aria-labelledby="tx-category-label" class="mt-2 min-w-0 group-has-[[name=kind][value=transfer]:checked]:hidden">
		<p id="tx-category-label" class="mb-1 text-xs font-semibold text-base-content/70">{ d.Tr("tx.category") }</p>
		@txCategoryGrid(d, v, "expense", "grid group-has-[[name=kind][value=income]:checked]:hidden")
		@txCategoryGrid(d, v, "income", "hidden group-has-[[name=kind][value=income]:checked]:grid")
	</div>
}

templ txCategoryGrid(d web.LayoutData, v TxFormView, kind, class string) {
	{{ cats := txCategoriesOf(v, kind) }}
	<div data-cat-kind={ kind } class={ "group/cats grid-cols-4 gap-2", class }>
		for i, c := range cats {
			<label
				title={ c.Name }
				class={ "btn h-auto min-h-16 min-w-0 flex-col gap-1 px-1 py-2 text-xs font-medium has-checked:btn-primary has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary",
					templ.KV("hidden group-has-[[data-cat-more]:checked]/cats:flex", txCategoryFolded(cats, i)) }
			>
				<input type="radio" name="category_id" value={ c.ID } checked?={ c.Selected } class="sr-only"/>
				if c.Icon != "" {
					@icons.Icon(c.Icon, "size-5")
				}
				<span data-label-fit data-scan-wrap="tile labels take two lines by design" class="line-clamp-2 max-w-full text-center leading-tight text-ellipsis">{ c.Name }</span>
				if c.Suggested {
					<span class="badge badge-xs">{ d.Tr("tx.category_suggested") }</span>
				}
			</label>
			if i == txCategoryFold-1 && len(cats) > txCategoryFold+1 {
				<label class="btn btn-ghost h-auto min-h-16 min-w-0 flex-col gap-1 px-1 py-2 text-xs font-medium has-checked:order-last has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary">
					<input type="checkbox" data-cat-more class="sr-only"/>
					<span class="contents group-has-[[data-cat-more]:checked]/cats:hidden">
						@icons.Icon("ellipsis", "size-5")
						{ d.Tr("tx.sheet.more") }
					</span>
					<span class="hidden group-has-[[data-cat-more]:checked]/cats:contents">
						@icons.Icon("chevron-up", "size-5")
						{ d.Tr("tx.sheet.less") }
					</span>
				</label>
			}
		}
	</div>
}

templ txChips(d web.LayoutData, v TxFormView) {
	<div class="mt-2 flex min-w-0 flex-wrap items-center gap-2">
		<span class="relative">
			@icons.Icon("wallet", "pointer-events-none absolute start-3 top-1/2 z-10 size-4 -translate-y-1/2")
			<select
				id="tx-wallet"
				name="wallet_id"
				required
				aria-label={ d.Tr("tx.wallet") }
				if v.WalletError != "" {
					aria-invalid="true"
					aria-describedby="tx-wallet-hint"
				}
				class="select h-11 w-auto max-w-48 border-base-200 bg-base-200 bg-none ps-9 pe-8 font-medium"
			>
				for _, w := range v.Wallets {
					<option
						value={ w.ID }
						selected?={ w.Selected }
						data-tx-symbol={ w.Symbol }
						data-currency={ w.Currency }
						data-exponent={ strconv.Itoa(w.Exponent) }
					>
						{ w.Name }
					</option>
				}
			</select>
			@icons.Icon("chevron-down", "pointer-events-none absolute end-3 top-1/2 size-3.5 -translate-y-1/2 opacity-60")
		</span>
		<span class="hidden items-center gap-2 group-has-[[name=kind][value=transfer]:checked]:flex">
			@icons.Icon("chevron-right", "size-4 shrink-0 text-base-content/70 rtl:-scale-x-100")
			<span class="relative">
				@icons.Icon("wallet", "pointer-events-none absolute start-3 top-1/2 z-10 size-4 -translate-y-1/2")
				<select id="tx-to-wallet" name="to_wallet_id" aria-label={ d.Tr("tx.to_wallet") } class="select h-11 w-auto max-w-48 border-base-200 bg-base-200 bg-none ps-9 pe-8 font-medium">
					<option value="">{ d.Tr("tx.to_wallet") }</option>
					for _, w := range v.Wallets {
						<option value={ w.ID } selected?={ w.ID == v.ToWalletID }>{ w.Name }</option>
					}
				</select>
				@icons.Icon("chevron-down", "pointer-events-none absolute end-3 top-1/2 size-3.5 -translate-y-1/2 opacity-60")
			</span>
		</span>
		@DateField(d, DateFieldProps{
			ID:        "tx-date",
			Name:      "date",
			Label:     d.Tr("tx.date"),
			Value:     v.Date,
			Today:     v.Today,
			Yesterday: v.Yesterday,
			Max:       max(v.Today, v.Date),
			Chip:      true,
		})
		<label class="btn btn-ghost h-11 gap-1.5 font-medium has-checked:btn-active has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary">
			<input type="checkbox" data-note-toggle checked?={ v.Note != "" } class="sr-only"/>
			@icons.Icon("sticky-note", "size-4")
			{ d.Tr("tx.note") }
		</label>
	</div>
	if v.WalletError != "" {
		<p id="tx-wallet-hint" class="mt-1 text-xs text-error">{ v.WalletError }</p>
	}
}

templ txKeypad(d web.LayoutData, v TxFormView) {
	<div data-keypad hidden dir="ltr" role="group" aria-label={ d.Tr("tx.keypad.label") } class="grid grid-cols-4 gap-1.5">
		for _, k := range []string{"7", "8", "9"} {
			@txDigitKey(k)
		}
		@txOpKey("÷", d.Tr("tx.keypad.divide"))
		for _, k := range []string{"4", "5", "6"} {
			@txDigitKey(k)
		}
		@txOpKey("×", d.Tr("tx.keypad.multiply"))
		for _, k := range []string{"1", "2", "3"} {
			@txDigitKey(k)
		}
		@txOpKey("−", d.Tr("tx.keypad.minus"))
		<button type="button" data-key="000" hidden?={ v.Exponent > 0 } class="btn h-12 text-xl font-semibold">000</button>
		<button type="button" data-key="dec" hidden?={ v.Exponent == 0 } class="btn h-12 text-xl font-semibold" aria-label={ d.Tr("tx.keypad.decimal") }>{ v.Decimal }</button>
		@txDigitKey("0")
		<button type="button" data-key="back" class="btn h-12 text-lg" aria-label={ d.Tr("tx.keypad.back") }>
			@icons.Icon("delete", "size-5")
		</button>
		@txOpKey("+", d.Tr("tx.keypad.plus"))
	</div>
}

templ txDigitKey(k string) {
	<button type="button" data-key={ k } class="btn h-12 text-xl font-semibold">{ k }</button>
}

templ txOpKey(op, label string) {
	<button type="button" data-key={ op } class="btn h-12 text-xl font-semibold text-primary" aria-label={ label }>{ op }</button>
}

templ txSheetAssets(d web.LayoutData) {
	<script src={ d.Static("keypad.js") } nonce={ d.Nonce } defer></script>
	<script src={ d.Static("recent.js") } nonce={ d.Nonce } defer></script>
}

// NOTE: the standalone page keeps its native submit; in the dialog a save answers with HX-Redirect to the allowlisted return page.
func txFormSwap(d web.LayoutData, v TxFormView) templ.Attributes {
	if v.FullPage {
		return templ.Attributes{}
	}
	return templ.Attributes{
		"hx-post":               txFormAction(d, v),
		"hx-nonce":              d.Nonce,
		"hx-swap":               "none",
		"hx-disable":            "find button, find input",
		"hx-status:422":         "target:#tx-quick-add swap:outerHTML",
		"hx-status:4xx":         "target:#hx-error swap:innerHTML",
		"hx-status:5xx":         "target:#hx-error swap:innerHTML",
		"data-clear-on-success": "#tx-amount, #tx-note",
	}
}

var txReturnPages = []string{"overview", "transactions"}

// TxReturnFor maps a page path to the return value TxReturnPage accepts; empty for any other page.
func TxReturnFor(path string) string {
	path, _, _ = strings.Cut(path, "?")
	if _, id, ok := strings.Cut(path, "/wallets/"); ok {
		return TxReturnPage("wallets/" + id)
	}
	return TxReturnPage(path[strings.LastIndex(path, "/")+1:])
}

// TxReturnPage returns raw when it names a page a sheet may return to (overview, transactions or wallets/{uuid}), else empty. SECURITY: the one allowlist for a posted return.
func TxReturnPage(raw string) string {
	if slices.Contains(txReturnPages, raw) {
		return raw
	}
	id, ok := strings.CutPrefix(raw, "wallets/")
	if !ok {
		return ""
	}
	u, err := uuid.Parse(id)
	if err != nil {
		return ""
	}
	return "wallets/" + u.String()
}

func txFormAction(d web.LayoutData, v TxFormView) string {
	if v.ID == "" {
		return d.ProjectPath(v.ProjectSlug, "/transactions")
	}
	return d.ProjectPath(v.ProjectSlug, "/transactions/"+v.ID)
}

func txNoWalletHeading(v TxFormView) int {
	if v.InDialog {
		return 3
	}
	return 2
}

const txCategoryFold = 7

func txCategoriesOf(v TxFormView, kind string) []TxCategoryOption {
	var out []TxCategoryOption
	for _, c := range v.Categories {
		if c.Kind == kind {
			out = append(out, c)
		}
	}
	return out
}

// NOTE: a picked or suggested category stays visible behind the More tile, so the choice never hides.
func txCategoryFolded(cats []TxCategoryOption, i int) bool {
	return i >= txCategoryFold && len(cats) > txCategoryFold+1 && !cats[i].Selected && !cats[i].Suggested
}
