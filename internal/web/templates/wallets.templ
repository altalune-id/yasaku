package templates

import (
	"strconv"

	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
	"altalune.id/yasaku/money"
)

// WalletRow is one wallet as the wallets index renders it; Balance is derived, never stored.
type WalletRow struct {
	ID       string
	Name     string
	KindKey  string
	Kind     string
	Provider string
	Balance  money.Amount
	Excluded bool
	Archived bool
}

// WalletsView is the wallets index: the spendable total, the active wallets and the archived ones.
type WalletsView struct {
	ProjectSlug string
	ProjectName string
	Active      []WalletRow
	Archived    []WalletRow
	Total       money.Amount
	Fragment    bool
	Mixed       bool
	ErrorKey    string
	ErrorMsg    string
	ErrorCode   string
	// OpeningMovedTo is the YYYY-MM-DD an opening balance was moved to, out of a closed period.
	OpeningMovedTo string
}

templ pageBanner(d web.LayoutData, key, msg, code string) {
	if key != "" {
		@ErrorBanner(d, d.Tr(key), code)
	} else if msg != "" {
		@ErrorBanner(d, msg, code)
	}
}

templ walletPost(d web.LayoutData, v WalletsView, r WalletRow, action, label, icon, btnClass string) {
	<form
		method="post"
		action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/wallets/"+r.ID+"/"+action)) }
		hx-post={ d.ProjectPath(v.ProjectSlug, "/wallets/"+r.ID+"/"+action) }
		hx-nonce={ d.Nonce }
		hx-target="#wallet-list"
		hx-swap="outerHTML"
		hx-disable="find button, find input"
		hx-status:4xx="target:#hx-error swap:innerHTML"
		hx-status:5xx="target:#hx-error swap:innerHTML"
	>
		<button type="submit" aria-label={ label + ": " + r.Name } class={ "btn btn-sm max-lg:btn-md", btnClass, templ.KV("max-sm:btn-square", btnClass == "btn-ghost") }>
			@icons.Icon(icon, "size-4")
			if btnClass == "btn-ghost" {
				<span class="max-sm:sr-only">{ label }</span>
			}
		</button>
	</form>
}

templ walletRowActions(d web.LayoutData, v WalletsView, r WalletRow) {
	<div class="flex shrink-0 items-center gap-1">
		if r.Archived {
			@walletPost(d, v, r, "unarchive", d.Tr("wallet.unarchive"), "rotate-ccw", "btn-ghost")
			<button
				type="button"
				data-dialog-open={ walletDeleteID(r) }
				aria-label={ d.Tr("wallet.delete") + ": " + r.Name }
				class="btn btn-ghost btn-square text-error"
			>
				@icons.Icon("trash-2", "size-4")
			</button>
		} else {
			<a
				href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/wallets/"+r.ID+"/adjust")) }
				data-dialog-open={ WalletAdjustDialogID(r.ID) }
				data-dialog-src={ d.ProjectPath(v.ProjectSlug, "/wallets/"+r.ID+"/adjust") }
				aria-label={ d.Tr("wallet.adjust") + ": " + r.Name }
				class="btn h-11 max-sm:btn-square max-sm:btn-ghost"
			>
				@icons.Icon("scale", "size-4")
				<span class="max-sm:sr-only">{ d.Tr("wallet.adjust") }</span>
			</a>
		}
	</div>
}

func walletKindIcon(kind string) string {
	switch kind {
	case "cash":
		return "banknote"
	case "bank":
		return "landmark"
	case "investment":
		return "trending-up"
	case "other":
		return "circle-dashed"
	default:
		return "wallet"
	}
}

func walletDeleteID(r WalletRow) string {
	return "wallet-delete-" + r.ID
}

templ walletDeleteConfirm(d web.LayoutData, v WalletsView, r WalletRow) {
	@ConfirmModal(d, ConfirmModalProps{
		ID:           walletDeleteID(r),
		Title:        d.Tr("wallet.delete_confirm_title", "Name", r.Name),
		Body:         d.Tr("wallet.delete_confirm_body"),
		Action:       d.ProjectPath(v.ProjectSlug, "/wallets/"+r.ID+"/delete"),
		ConfirmLabel: d.Tr("wallet.delete"),
		Attrs: templ.Attributes{
			"hx-post":        d.ProjectPath(v.ProjectSlug, "/wallets/"+r.ID+"/delete"),
			"hx-nonce":       d.Nonce,
			"hx-target":      "#wallet-list",
			"hx-swap":        "outerHTML",
			"hx-disable":     "find button, find input",
			"hx-status:4xx": "target:#hx-error swap:innerHTML",
			"hx-status:5xx": "target:#hx-error swap:innerHTML",
		},
	})
}

templ walletDialogs(d web.LayoutData, v WalletsView, oob bool) {
	<div
		id="wallet-dialogs"
		if oob {
			hx-swap-oob="true"
			hx-nonce={ d.Nonce }
		}
	>
		for _, r := range v.Archived {
			@walletDeleteConfirm(d, v, r)
		}
	</div>
}

templ walletListRow(d web.LayoutData, v WalletsView, r WalletRow) {
	<li class="flex flex-wrap items-center gap-x-3 gap-y-2 p-4 lg:rounded-box lg:border lg:border-base-300">
		<span class="grid size-11 shrink-0 place-items-center rounded-full bg-base-200 text-primary" aria-hidden="true">
			@icons.Icon(walletKindIcon(r.Kind), "size-5")
		</span>
		<a href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/wallets/"+r.ID)) } class="min-w-0 flex-1 basis-20 rounded-field focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
			<span class="block font-semibold break-words">{ r.Name }</span>
			<span class="block text-sm break-words text-base-content/70">
				{ d.Tr(r.KindKey) }
				if r.Provider != "" {
					{ " — " + r.Provider }
				}
				if r.Archived {
					<span class="badge badge-ghost badge-sm ms-1">{ d.Tr("wallet.archived") }</span>
				}
			</span>
		</a>
		<span class="min-w-0 max-w-full text-end font-bold tabular-nums break-words">
			{ Money(d, r.Balance) }
			if r.Excluded {
				<span class="block text-xs font-normal text-base-content/70">{ d.Tr("wallet.exclude_from_total") }</span>
			}
		</span>
		@walletRowActions(d, v, r)
	</li>
}

templ walletsArchivedTitle(d web.LayoutData, n int) {
	<span class="font-semibold">{ d.Tr("wallet.archived") + " (" + strconv.Itoa(n) + ")" }</span>
}

// WalletList is the HTMX-swappable section: every wallet action targets #wallet-list.
templ WalletList(d web.LayoutData, v WalletsView) {
	<div id="wallet-list" class="mt-6 flex flex-col gap-4">
		@pageBanner(d, v.ErrorKey, v.ErrorMsg, v.ErrorCode)
		if v.OpeningMovedTo != "" {
			<div data-wallet-notice="opening-moved" role="status" class="alert alert-soft alert-success">
				{ d.Tr("wallet.opening_moved", "Date", v.OpeningMovedTo) }
			</div>
		}
		<div class="stats w-full bg-base-200">
			<div class="stat min-w-0 px-4">
				<div class="stat-title text-base-content/80">{ d.TrN("wallet.total_across", len(v.Active)) }</div>
				<div class="stat-value tabular-nums whitespace-normal break-words">{ Money(d, v.Total) }</div>
				if v.Mixed {
					<div data-mixed-currency="1" class="stat-desc whitespace-normal text-base-content/70">{ d.Tr("overview.mixed_currency") }</div>
				} else {
					<div class="stat-desc whitespace-normal text-base-content/70">{ d.Tr("wallet.total_desc") }</div>
				}
			</div>
		</div>
		if len(v.Active) == 0 && len(v.Archived) == 0 {
			@EmptyState(EmptyStateProps{Title: d.Tr("wallet.empty_title"), Body: d.Tr("wallet.empty"), Icon: "wallet"}) {
				@AppButton(d.ProjectPath(v.ProjectSlug, "/wallets/new"), "btn-primary", nil) {
					@icons.Icon("circle-plus", "size-4")
					{ d.Tr("wallet.new") }
				}
			}
		} else if len(v.Active) > 0 {
			<ul class="divide-y divide-base-300 rounded-box border border-base-300 bg-base-100 lg:grid lg:grid-cols-2 lg:gap-3 lg:divide-y-0 lg:border-0 lg:bg-transparent">
				for _, r := range v.Active {
					@walletListRow(d, v, r)
				}
			</ul>
		}
		if len(v.Archived) > 0 {
			@AppCollapse("wallet-archived", "border border-base-300 bg-base-100 [&>.collapse-content]:px-0", walletsArchivedTitle(d, len(v.Archived))) {
				<ul class="divide-y divide-base-300 lg:[&>li]:rounded-none lg:[&>li]:border-0">
					for _, r := range v.Archived {
						@walletListRow(d, v, r)
					}
				</ul>
			}
		}
		@AppButton(d.ProjectPath(v.ProjectSlug, "/wallets/new"), "btn-ghost self-start", nil) {
			@icons.Icon("plus", "size-4")
			{ d.Tr("wallet.add") }
		}
		if v.Fragment {
			@walletDialogs(d, v, true)
		}
	</div>
}

templ WalletsPage(d web.LayoutData, v WalletsView) {
	<section>
		@PageHeader(d.Tr("wallet.title"), "") {
			if len(v.Active) > 1 {
				@AppButton(d.ProjectPath(v.ProjectSlug, "/transactions/new?kind=transfer"), "", templ.Attributes{"data-dialog-open": TxAddDialogID, "data-dialog-src": d.ProjectPath(v.ProjectSlug, "/transactions/new?kind=transfer")}) {
					@icons.Icon("arrow-left-right", "size-4")
					{ d.Tr("wallet.transfer") }
				}
			}
		}
		@WalletList(d, v)
	</section>
}

templ WalletsLayout(d web.LayoutData, v WalletsView) {
	@Layout(web.WithDialogs(web.WithContent(d, WalletsPage(d, v)), walletDialogs(d, v, false)))
}
