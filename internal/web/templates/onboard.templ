package templates

import (
	"net/url"

	"altalune.id/yasaku/internal/web"
)

type OnboardView struct {
	Error         string
	ErrorCode string
	FieldErrors   map[string]string
	LocalAuth     bool
	OIDCAuth      bool
	OIDCFinalize  bool
	Email         string
	Name          string
	OrgSlug       string
	OrgName       string
	ProjectSlug   string
	ProjectName   string
	SetupToken    string
}

func fieldErr(m map[string]string, key string) string {
	if m == nil {
		return ""
	}
	return m[key]
}

templ OnboardPage(d web.LayoutData, v OnboardView) {
	<section class="mx-auto flex max-w-2xl flex-col gap-4 lg:gap-6">
		<div>
			<h1 class="text-2xl font-semibold text-base-content">{ d.Tr("onboard.title") }</h1>
			<p class="mt-2 text-sm text-base-content/70">{ d.Tr("onboard.subtitle") }</p>
		</div>
		if v.Error != "" {
			<div class="[&>[role=alert]]:mt-0">
				@ErrorBanner(d, v.Error, v.ErrorCode)
			</div>
		}
		<div class="grid gap-4 lg:gap-6">
			if v.OIDCFinalize {
				<div class="rounded-box border border-base-300 bg-base-200 p-3 text-sm">
					<p class="text-xs font-medium text-base-content/70">{ d.Tr("onboard.finalize_signed_in") }</p>
					<p class="mt-0.5 truncate font-medium">{ v.Email }</p>
				</div>
				<form method="post" action={ templ.SafeURL(d.Href("/onboard/complete")) } class="grid gap-4 lg:gap-6" novalidate>
					@onboardSetupToken(v.SetupToken)
					@FormSection(d.Tr("onboard.org_section")) {
						@onboardSlugField(d, "org_slug", "acme", v.OrgSlug, v.FieldErrors)
						@onboardField(d, "org_name", d.Tr("onboard.display_name"), "text", "organization", d.Tr("org_new.name_placeholder"), v.OrgName, v.FieldErrors, true)
					}
					@FormSection(d.Tr("onboard.project_section")) {
						@onboardSlugField(d, "project_slug", "web", v.ProjectSlug, v.FieldErrors)
						@onboardField(d, "project_name", d.Tr("onboard.display_name"), "text", "off", d.Tr("onboard.default_project_name"), v.ProjectName, v.FieldErrors, false)
					}
					<button
						type="submit"
						class="btn btn-primary w-full"
					>
						{ d.Tr("onboard.submit") }
					</button>
				</form>
			} else if v.OIDCAuth {
				<div class="grid gap-2">
					<a class="btn-sso" href={ templ.SafeURL(d.Href("/onboard/oidc") + onboardTokenQuery(v.SetupToken)) }>
						<img class="btn-sso__logo" src={ d.OIDCButtonLogoURL() } alt="" aria-hidden="true" width="24" height="24"/>
						<span class="btn-sso__label">{ d.OIDCButtonLabel(d.Tr("onboard.oidc_button")) }</span>
						<span class="btn-sso__chev" aria-hidden="true">→</span>
					</a>
					<p class="text-center text-xs text-base-content/70">{ d.Tr("onboard.oidc_hint") }</p>
				</div>
			}
			if v.LocalAuth && !v.OIDCFinalize {
				if v.OIDCAuth {
					<div class="flex items-center gap-3 text-xs text-base-content/70">
						<span class="h-px flex-1 bg-base-300"></span>
						<span>{ d.Tr("onboard.or_local") }</span>
						<span class="h-px flex-1 bg-base-300"></span>
					</div>
				}
				<form method="post" action={ templ.SafeURL(d.Href("/onboard/local")) } class="grid gap-4 lg:gap-6" novalidate>
					@onboardSetupToken(v.SetupToken)
					@FormSection(d.Tr("onboard.admin_section")) {
						@onboardField(d, "email", d.Tr("login.email"), "email", "email", "you@example.com", v.Email, v.FieldErrors, true)
						@onboardField(d, "name", d.Tr("onboard.display_name"), "text", "name", d.Tr("welcome.display_name_placeholder"), v.Name, v.FieldErrors, true)
						@onboardPasswordField(d, v.FieldErrors)
					}
					@FormSection(d.Tr("onboard.org_section")) {
						@onboardSlugField(d, "org_slug", "acme", v.OrgSlug, v.FieldErrors)
						@onboardField(d, "org_name", d.Tr("onboard.display_name"), "text", "organization", d.Tr("org_new.name_placeholder"), v.OrgName, v.FieldErrors, true)
					}
					@FormSection(d.Tr("onboard.project_section")) {
						@onboardSlugField(d, "project_slug", "web", v.ProjectSlug, v.FieldErrors)
						@onboardField(d, "project_name", d.Tr("onboard.display_name"), "text", "off", d.Tr("onboard.default_project_name"), v.ProjectName, v.FieldErrors, false)
					}
					<button
						type="submit"
						class="btn btn-primary w-full"
					>
						{ d.Tr("onboard.submit") }
					</button>
				</form>
			}
			if !v.LocalAuth && !v.OIDCAuth && !v.OIDCFinalize {
				<p class="text-sm text-base-content/70">{ d.Tr("onboard.no_method") }</p>
			}
		</div>
		if v.OIDCFinalize || v.LocalAuth {
			@slugEditScript(d.Nonce)
		}
	</section>
}

templ onboardSetupToken(token string) {
	if token != "" {
		<input type="hidden" name="token" value={ token }/>
	}
}

func onboardTokenQuery(token string) string {
	if token == "" {
		return ""
	}
	return "?token=" + url.QueryEscape(token)
}

func onboardFieldProps(d web.LayoutData, id, label string, errs map[string]string) FieldProps {
	p := FieldProps{ID: "onb-" + id, Label: label}
	if e := fieldErr(errs, id); e != "" {
		p.Error = d.Tr(e)
	}
	return p
}

templ onboardField(d web.LayoutData, id, label, kind, autocomplete, placeholder, value string, errs map[string]string, required bool) {
	{{ f := onboardFieldProps(d, id, label, errs) }}
	@FormField(f) {
		<input
			name={ id }
			type={ kind }
			autocomplete={ autocomplete }
			placeholder={ placeholder }
			value={ value }
			required?={ required }
			dir="auto"
			class={ "input w-full", templ.KV("input-error", f.Error != "") }
			{ f.Attrs()... }
		/>
	}
}

templ onboardSlugField(d web.LayoutData, id, placeholder, value string, errs map[string]string) {
	{{ f := onboardFieldProps(d, id, d.Tr("onboard.slug"), errs) }}
	if slugLocked(value, errs, id) {
		{{ f.Hint = d.Tr("onboard.slug_hint") }}
	}
	@FormField(f) {
		<div class="flex items-center gap-2">
			<input
				name={ id }
				type="text"
				autocomplete="off"
				placeholder={ placeholder }
				value={ value }
				readonly?={ slugLocked(value, errs, id) }
				dir="ltr"
				class={ "input w-full min-w-0 flex-1 font-mono", slugInputTone(slugLocked(value, errs, id)), templ.KV("input-error", f.Error != "") }
				{ f.Attrs()... }
			/>
			if slugLocked(value, errs, id) {
				<button
					type="button"
					data-slug-edit={ "onb-" + id }
					aria-controls={ "onb-" + id }
					class="btn shrink-0"
				>
					{ d.Tr("onboard.slug_edit") }
				</button>
			}
		</div>
	}
}

func slugLocked(value string, errs map[string]string, id string) bool {
	return value != "" && fieldErr(errs, id) == ""
}

func slugInputTone(locked bool) string {
	if locked {
		return "bg-base-200 text-base-content/70"
	}
	return ""
}

templ slugEditScript(nonce string) {
	<script nonce={ nonce }>
	if (!window.yasakuSlugEditBound) {
	window.yasakuSlugEditBound = true;
	document.addEventListener('click', function(e) {
		if (!e.target || !e.target.closest) return;
		var btn = e.target.closest('[data-slug-edit]');
		if (!btn) return;
		var input = document.getElementById(btn.getAttribute('data-slug-edit'));
		if (!input) return;
		input.readOnly = false;
		input.classList.remove('bg-base-200', 'text-base-content/70');
		btn.hidden = true;
		var hint = document.getElementById(input.id + '-hint');
		if (hint) hint.hidden = true;
		input.removeAttribute('aria-describedby');
		input.focus();
		input.select();
	});
	}
	</script>
}

templ onboardPasswordField(d web.LayoutData, errs map[string]string) {
	{{ f := onboardFieldProps(d, "password", d.Tr("onboard.password"), errs) }}
	@FormField(f) {
		<input
			name="password"
			type="password"
			required
			minlength="8"
			autocomplete="new-password"
			placeholder={ d.Tr("onboard.password_placeholder") }
			class={ "input w-full", templ.KV("input-error", f.Error != "") }
			{ f.Attrs()... }
		/>
	}
}

templ OnboardLayout(d web.LayoutData, v OnboardView) {
	@Layout(web.WithContent(d, OnboardPage(d, v)))
}
