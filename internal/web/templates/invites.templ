package templates

import (
	"strconv"
	"time"

	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
)

type InviteRow struct {
	ID        string
	Email     string
	Role      string
	ExpiresAt time.Time
}

func seatsLine(d web.LayoutData, max int, args ...any) string {
	return d.TrN("limits.seats", max, args...)
}

type SeatsView struct {
	Used, Max, Pending int64
}

type InvitesView struct {
	OrgSlug   string
	Seats     *SeatsView
	Invites   []InviteRow
	CanManage bool
	Disabled  bool
	SendBlocked string
	CustomRoles []RoleOption
	Error     string
	ErrorCode string
}

templ InvitesPage(d web.LayoutData, v InvitesView) {
	<section class="flex flex-col gap-4 lg:gap-6">
		@PageHeader(d.Tr("invites.title"), d.Tr("invites.subtitle"))
		if v.Seats != nil {
			{{ used, limit, pending := strconv.FormatInt(v.Seats.Used, 10), strconv.FormatInt(v.Seats.Max, 10), strconv.FormatInt(v.Seats.Pending, 10) }}
			<p class="text-sm text-base-content/70" data-seats={ used + "/" + limit + "/" + pending }>{ seatsLine(d, int(v.Seats.Max), "Used", used, "Max", limit, "Pending", pending) }</p>
		}
		if v.Disabled {
			<p role="status" class={ flashClass("warn"), "text-sm" }>{ d.Tr("invites.disabled_banner") }</p>
		}
		if v.Error != "" {
			<div class="[&>[role=alert]]:mt-0">
				@ErrorBanner(d, v.Error, v.ErrorCode)
			</div>
		}
		if v.CanManage && !v.Disabled {
			<form method="post" action={ templ.SafeURL(d.Href("/orgs/" + v.OrgSlug + "/invites")) } class="grid gap-3 rounded-box border border-base-300 bg-base-100 p-4">
				<div>
					<h2 class="text-base font-semibold">{ d.Tr("invites.form_heading") }</h2>
					<p class="mt-1 text-sm text-base-content/70">{ d.Tr("invites.form_subtitle") }</p>
				</div>
				{{ inviteEmailField := FieldProps{ID: "invite-email", Label: d.Tr("invites.form_email"), Compact: true} }}
				@FormField(inviteEmailField) {
					<input { inviteEmailField.Attrs()... } name="email" type="email" required class="input w-full"/>
				}
				{{ inviteRoleField := FieldProps{ID: "invite-role", Label: d.Tr("invites.form_role"), Compact: true} }}
				@FormField(inviteRoleField) {
					<select { inviteRoleField.Attrs()... } name="role" required class="select w-full">
						<option value="member">{ d.Tr("invites.role_member") }</option>
						<option value="admin">{ d.Tr("invites.role_admin") }</option>
						if len(v.CustomRoles) > 0 {
							<optgroup label={ d.Tr("roles.custom_heading") }>
								for _, c := range v.CustomRoles {
									<option value={ c.Value }>{ c.Label }</option>
								}
							</optgroup>
						}
					</select>
				}
				if v.SendBlocked != "" {
					<div class="flex flex-wrap items-center gap-3">
						<button type="submit" class="btn btn-primary" disabled aria-describedby="invite-send-blocked" data-limit-blocked>
							@icons.Icon("send", "size-4")
							<span>{ d.Tr("invites.submit") }</span>
						</button>
						<p id="invite-send-blocked" role="status" class="text-sm text-base-content/70">{ v.SendBlocked }</p>
					</div>
				} else {
					<button type="submit" class="btn btn-primary justify-self-start">
						@icons.Icon("send", "size-4")
						<span>{ d.Tr("invites.submit") }</span>
					</button>
				}
			</form>
		}
		<ul class="list rounded-box border border-base-300 bg-base-100">
			if len(v.Invites) == 0 {
				<li class="px-4 py-6 text-center text-sm text-base-content/70">{ d.Tr("invites.empty") }</li>
			}
			for _, i := range v.Invites {
				<li class="list-row items-center">
					<div class="min-w-0">
						<p class="truncate text-sm font-medium">{ i.Email }</p>
						<p class="truncate text-xs text-base-content/70">
							{ i.Role } · expires
							@DateTime(d, i.ExpiresAt)
						</p>
					</div>
					if v.CanManage {
						<form method="post" action={ templ.SafeURL(d.Href("/orgs/" + v.OrgSlug + "/invites/" + i.ID + "/revoke")) }>
							<button type="submit" aria-label={ "Revoke invite for " + i.Email } class="btn btn-ghost btn-square">
								@icons.Icon("trash-2", "size-4")
							</button>
						</form>
					}
				</li>
			}
		</ul>
	</section>
}

templ InvitesLayout(d web.LayoutData, v InvitesView) {
	@Layout(web.WithContent(d, InvitesPage(d, v)))
}
