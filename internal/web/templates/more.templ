package templates

import (
	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
)

templ moreRow(href, icon, title, desc string) {
	<li>
		<a href={ templ.SafeURL(href) } class="list-row min-h-11 items-center hover:bg-base-200">
			<span class="grid size-10 place-items-center rounded-full bg-base-200 text-primary">
				@icons.Icon(icon, "size-5")
			</span>
			<span class="list-col-grow min-w-0">
				<span class="block truncate font-medium">{ title }</span>
				<span class="block truncate text-sm text-base-content/70">{ desc }</span>
			</span>
			@icons.Icon("chevron-right", "size-4 text-base-content/70 rtl:rotate-180")
		</a>
	</li>
}

// MorePage lists every project page that has no dock slot, the organization pages, the tips reset and Appearance.
templ MorePage(d web.LayoutData) {
	<section class="flex flex-col gap-4 lg:gap-6">
		@PageHeader(d.Tr("nav.more"), "")
		<div class="flex max-w-xl min-w-0 flex-col gap-4 lg:gap-6">
			<ul class="list rounded-box border border-base-300">
				for _, it := range navVisible(d, true) {
					@moreRow(d.ProjectPath(d.ActiveProject.Slug, it.Path), it.Icon, d.Tr(it.LabelKey), d.Tr(it.DescKey))
				}
				if o := d.ActiveOrg; o != nil {
					@moreRow(d.Href("/orgs/"+o.Slug+"/members"), "users", d.Tr("more.organization"), d.Tr("more.desc_organization", "Org", o.Name))
					@moreRow(d.Href("/orgs/"+o.Slug+"/apikeys"), "key", d.Tr("more.org_apikeys"), d.Tr("more.desc_org_apikeys"))
					if canManageOrg(d) {
						@moreRow(d.Href("/orgs/"+o.Slug+"/roles"), "lock", d.Tr("nav.roles"), d.Tr("more.desc_roles"))
						@moreRow(d.Href("/orgs/"+o.Slug+"/activity"), "list-checks", d.Tr("nav.activity"), d.Tr("more.desc_activity"))
					}
				}
			</ul>
			<form method="post" action={ templ.SafeURL(d.Href("/tips/reset")) } class="contents">
				<input type="hidden" name="redirect" value={ d.CurrentPath }/>
				<ul class="list rounded-box border border-base-300">
					<li>
						<button type="submit" class="list-row min-h-11 w-full items-center text-start hover:bg-base-200">
							<span class="grid size-10 place-items-center rounded-full bg-base-200 text-primary">
								@icons.Icon("lightbulb", "size-5")
							</span>
							<span class="list-col-grow min-w-0">
								<span class="block truncate font-medium">{ d.Tr("more.tips_again") }</span>
								<span class="block truncate text-sm text-base-content/70">{ d.Tr("more.tips_again_desc") }</span>
							</span>
							@icons.Icon("chevron-right", "size-4 text-base-content/70 rtl:rotate-180")
						</button>
					</li>
				</ul>
			</form>
			<section class="min-w-0 rounded-box border border-base-300 p-4" aria-labelledby="more-appearance">
				<h2 id="more-appearance" class="font-semibold">{ d.Tr("more.appearance") }</h2>
				<p class="text-sm text-base-content/70">{ d.Tr("more.appearance_desc") }</p>
				@ThemePicker(d)
			</section>
		</div>
	</section>
}

templ MoreLayout(d web.LayoutData) {
	@Layout(web.WithContent(d, MorePage(d)))
}
