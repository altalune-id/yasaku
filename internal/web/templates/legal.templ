package templates

import (
	"altalune.id/yasaku/internal/legal"
	"altalune.id/yasaku/internal/web"
)

// LegalView carries a parsed legal document to the layout.
type LegalView struct {
	Doc *legal.Document
}

templ LegalPage(d web.LayoutData, v LegalView) {
	<section class="mx-auto max-w-2xl">
		<header class="mb-6">
			<p class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{ d.Tr("legal.eyebrow") }</p>
			<h1 class="mt-1 text-2xl font-semibold text-base-content">{ v.Doc.Title }</h1>
			if !v.Doc.UpdatedAt.IsZero() {
				<p class="mt-1 text-xs text-base-content/70">
					{ d.Tr("legal.updated_at") } { v.Doc.UpdatedAt.Format("2006-01-02") }
				</p>
			}
		</header>
		<article class="rounded-lg border border-base-300 bg-base-100 p-6 text-sm leading-relaxed shadow-sm [&_h2]:mt-6 [&_h2]:mb-2 [&_h2]:text-base [&_h2]:font-semibold [&_h3]:mt-4 [&_h3]:mb-1 [&_h3]:font-semibold [&_p]:my-3 [&_ul]:my-3 [&_ul]:list-disc [&_ul]:ps-6 [&_ol]:my-3 [&_ol]:list-decimal [&_ol]:ps-6 [&_li]:my-1 [&_a]:underline">
			@templ.Raw(v.Doc.HTML)
		</article>
	</section>
}

templ LegalLayout(d web.LayoutData, v LegalView) {
	@Layout(web.WithContent(d, LegalPage(d, v)))
}
