package templates

import (
	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
)

type MemberRow struct {
	UserID string
	Email  string
	Name   string
	Role   string
	System bool
	// IsSelf marks the row belonging to the signed-in user, who cannot remove their own membership.
	IsSelf bool
	// Removable comes from org.RemovalRefusal, so the button only shows where the post would succeed.
	Removable bool
}

type MembersView struct {
	OrgSlug   string
	Members   []MemberRow
	CanManage bool
	Error     string
	ErrorCode string
}

templ MembersPage(d web.LayoutData, v MembersView) {
	<section>
		@PageHeader(d.Tr("members.title"), d.Tr("members.subtitle")) {
			if v.CanManage {
				@AppButton(d.Href("/orgs/"+v.OrgSlug+"/invites"), "btn-primary", nil) {
					@icons.Icon("user-plus", "size-4")
					{ d.Tr("members.invite_button") }
				}
			}
		}
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		<ul class="mt-6 divide-y divide-base-300/50 overflow-hidden rounded-lg border border-base-300 bg-base-100 shadow-sm">
			if len(v.Members) == 0 {
				<li class="px-4 py-6 text-center text-sm text-base-content/70">{ d.Tr("members.empty") }</li>
			}
			for _, m := range v.Members {
				<li class="flex items-center justify-between px-4 py-3">
					<div class="min-w-0">
						<p class="flex items-center gap-2 truncate text-sm font-medium text-base-content">
							<span class="truncate">
								if m.Name != "" {
									{ m.Name }
								} else {
									{ m.Email }
								}
							</span>
							if m.IsSelf {
								<span class="inline-flex items-center rounded-full bg-base-200 px-2 py-0.5 text-xs font-medium text-base-content/70">{ d.Tr("members.you") }</span>
							}
						</p>
						<p class="truncate text-xs text-base-content/70">
							{ m.Email } · { m.Role }
							if m.System {
								<span class="ms-2 inline-flex items-center rounded-full bg-warning/10 px-2 py-0.5 text-xs font-medium text-warning ring-1 ring-inset ring-warning/30">{ d.Tr("common.system") }</span>
							}
						</p>
					</div>
					if v.CanManage && m.Removable {
						<form method="post" action={ templ.SafeURL(d.Href("/orgs/" + v.OrgSlug + "/members/" + m.UserID + "/remove")) } class="ms-4 inline">
							<button type="submit" aria-label={ "Remove " + m.Email } class="rounded p-1.5 text-base-content/70 hover:bg-error/10 hover:text-error">
								@icons.Icon("trash-2", "h-4 w-4")
							</button>
						</form>
					}
				</li>
			}
		</ul>
	</section>
}

templ MembersLayout(d web.LayoutData, v MembersView) {
	@Layout(web.WithContent(d, MembersPage(d, v)))
}
