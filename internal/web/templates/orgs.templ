package templates

import (
	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
)

type OrgsView struct {
	Orgs          []OrgSummary
	CreateBlocked string
	Error string
	ErrorCode string
}

templ OrgsPage(d web.LayoutData, v OrgsView) {
	<section>
		@PageHeader(d.Tr("orgs.title"), d.Tr("orgs.subtitle")) {
			if d.Caps.OrgCreation && v.CreateBlocked != "" {
				<button type="button" class="btn btn-primary" disabled aria-describedby="org-create-blocked">
					@icons.Icon("plus", "size-4")
					{ d.Tr("nav.new_organization") }
				</button>
			} else if d.Caps.OrgCreation {
				@AppButton(d.Href("/orgs/new"), "btn-primary", nil) {
					@icons.Icon("plus", "size-4")
					{ d.Tr("nav.new_organization") }
				}
			}
		}
		if d.Caps.OrgCreation && v.CreateBlocked != "" {
			<p id="org-create-blocked" role="status" class="mt-4 text-sm text-base-content/70">{ v.CreateBlocked }</p>
		}
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		if len(v.Orgs) == 0 {
			<div class="mt-6 rounded-lg border border-dashed border-base-300 bg-base-100 p-8 text-center">
				<p class="text-sm text-base-content/70">{ d.Tr("orgs.empty") }</p>
				if d.Caps.OrgCreation && v.CreateBlocked == "" {
					<a href={ templ.SafeURL(d.Href("/orgs/new")) } class="btn btn-primary mt-4">{ d.Tr("orgs.create_first") }</a>
				}
			</div>
		} else {
			<ul class="mt-6 divide-y divide-base-300/50 overflow-hidden rounded-lg border border-base-300 bg-base-100 shadow-sm">
				for _, o := range v.Orgs {
					<li class="flex items-center justify-between px-4 py-3">
						<div class="min-w-0">
							<p class="flex items-center gap-2 truncate text-sm font-medium text-base-content">
								<span class="truncate">{ o.Name }</span>
								if o.System {
									<span class="inline-flex items-center rounded-full bg-warning/10 px-2 py-0.5 text-xs font-medium text-warning ring-1 ring-inset ring-warning/30">{ d.Tr("common.system") }</span>
								}
							</p>
							<p class="truncate text-xs text-base-content/70">{ o.Slug }</p>
						</div>
						<a href={ templ.SafeURL(d.Href("/orgs/" + o.Slug + "/projects")) } class="ms-4 text-sm font-medium text-base-content/70 hover:text-base-content">{ d.Tr("common.open") }</a>
					</li>
				}
			</ul>
		}
	</section>
}

templ OrgsLayout(d web.LayoutData, v OrgsView) {
	@Layout(web.WithContent(d, OrgsPage(d, v)))
}
