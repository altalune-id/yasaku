package templates

import (
	"time"

	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
)

// API key form error kinds the apikeys screen renders as a banner.
const (
	APIKeyErrorScope         = "scope"
	APIKeyErrorNotFound      = "not_found"
	APIKeyErrorInvalidExpiry = "invalid_expiry"
	APIKeyErrorFailed        = "failed"
	APIKeyErrorNotManager    = "not_manager"
	APIKeyErrorEmptyGrant    = "empty_grant"
	APIKeyErrorGrant         = "grant"
)

type APIKeyScopeOption struct {
	Value    string
	LabelKey string
}

// APIKeyProjectOption is one project an org key or personal token can be granted.
type APIKeyProjectOption struct {
	ID   string
	Name string
}

// APIKeyOrgOption is one org a personal token can be minted in.
type APIKeyOrgOption struct {
	Slug     string
	Name     string
	Selected bool
}

// APIKeyExpiryOption is one lifetime a new key can be minted with.
type APIKeyExpiryOption struct {
	Days     string
	LabelKey string
	Selected bool
}

type APIKeyRow struct {
	ID             string
	Base           string
	OrgName        string
	Name           string
	SecretHint     string
	ScopeLabelKeys []string
	HasGrant       bool
	AllProjects    bool
	ProjectNames   []string
	Grantable      []APIKeyProjectOption
	CreatedAt      time.Time
	HasExpiry      bool
	ExpiresAt      time.Time
	HasLastUsed    bool
	LastUsedAt     time.Time
	Revoked        bool
	RevokedAt      time.Time
}

// APIKeyMinted carries a mint's plaintext secret. SECURITY: rendered once, into the response that follows the mint; never persisted.
type APIKeyMinted struct {
	Name      string
	Plaintext string
}

// APIKeysView renders the project, org or personal key page; Base is the page's own URL and each row carries its own action base.
type APIKeysView struct {
	Base      string
	OrgLevel  bool
	Personal  bool
	HasGrant  bool
	CanManage bool
	Items     []APIKeyRow
	Scopes    []APIKeyScopeOption
	Projects  []APIKeyProjectOption
	Orgs      []APIKeyOrgOption
	Expiries  []APIKeyExpiryOption
	Minted    *APIKeyMinted
	ErrorKind string
	ErrorCode string
}

templ apikeyBanner(d web.LayoutData, kind, code string) {
	if kind == APIKeyErrorScope {
		@ErrorBanner(d, d.Tr("apikey.error_scope"), code)
	} else if kind == APIKeyErrorNotFound {
		@ErrorBanner(d, d.Tr("apikey.error_not_found"), code)
	} else if kind == APIKeyErrorInvalidExpiry {
		@ErrorBanner(d, d.Tr("apikey.error_invalid_expiry"), code)
	} else if kind == APIKeyErrorNotManager {
		@ErrorBanner(d, d.Tr("apikey.error_not_manager"), code)
	} else if kind == APIKeyErrorEmptyGrant {
		@ErrorBanner(d, d.Tr("apikey.error_empty_grant"), code)
	} else if kind == APIKeyErrorGrant {
		@ErrorBanner(d, d.Tr("apikey.error_grant"), code)
	} else if kind == APIKeyErrorFailed {
		@ErrorBanner(d, d.Tr("apikey.error_failed"), code)
	}
}

// apikeyMintedBanner shows the one-time plaintext. It is reachable only through APIKeysView.Minted,
// which the handler sets solely on the response that immediately follows a successful mint.
templ apikeyMintedBanner(d web.LayoutData, m *APIKeyMinted) {
	<div class="mt-4 rounded-md border border-warning/30 bg-warning/10 p-4 text-sm text-warning">
		<p class="font-semibold">{ d.Tr("apikey.minted_heading") }</p>
		<p class="mt-1 text-xs">{ d.Tr("apikey.minted_warning") }</p>
		<code class="mt-2 block select-all break-all rounded border border-warning/30 bg-warning/10 px-3 py-2 font-mono text-sm">{ m.Plaintext }</code>
	</div>
}

templ apikeyChip(label string) {
	<span class="rounded-full border border-base-300 px-2 py-0.5 text-[11px] text-base-content/70">{ label }</span>
}

templ apikeyGrantSummary(d web.LayoutData, k APIKeyRow) {
	<p class="mt-1 flex flex-wrap items-center gap-1 text-xs text-base-content/70">
		<span>{ d.Tr("apikey.access_label") }:</span>
		if k.AllProjects {
			<span class="rounded-full bg-primary/10 px-2 py-0.5 text-[11px] font-medium text-primary">{ d.Tr("apikey.all_projects") }</span>
		} else {
			for _, name := range k.ProjectNames {
				@apikeyChip(name)
			}
		}
	</p>
}

templ apikeyAction(d web.LayoutData, action, confirm string) {
	<form
		method="post"
		action={ templ.SafeURL(action) }
		hx-post={ action }
		hx-nonce={ d.Nonce }
		if confirm != "" {
			hx-confirm={ confirm }
		}
		hx-target="#apikey-list"
		hx-swap="outerHTML"
		hx-disable="find button, find input"
		hx-status:4xx="target:#hx-error swap:innerHTML"
		hx-status:5xx="target:#hx-error swap:innerHTML"
		class="inline"
	>
		{ children... }
	</form>
}

templ apikeyPromote(d web.LayoutData, v APIKeysView, k APIKeyRow) {
	<details class="mt-2 text-xs">
		<summary class="cursor-pointer select-none text-base-content/70 hover:text-base-content">{ d.Tr("apikey.widen_access") }</summary>
		<div class="mt-2 grid gap-2 rounded-box border border-base-300 bg-base-200 p-3 text-sm">
			if len(k.Grantable) > 0 {
				@apikeyAction(d, k.Base+"/"+k.ID+"/projects", "") {
					<div class="flex flex-wrap gap-2">
						for _, p := range k.Grantable {
							<label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-base-300 px-3 py-1 text-base-content/90 hover:bg-base-200 has-[:checked]:border-primary has-[:checked]:bg-primary/10">
								<input type="checkbox" name="project_ids" value={ p.ID } class="h-3.5 w-3.5 rounded border-base-300"/>
								<span>{ p.Name }</span>
							</label>
						}
					</div>
					<button type="submit" class="btn mt-2">{ d.Tr("apikey.add_projects") }</button>
				}
			}
			@apikeyAction(d, k.Base+"/"+k.ID+"/all-projects", d.Tr("apikey.all_projects_confirm")) {
				<button type="submit" class="btn">{ d.Tr("apikey.grant_all_projects") }</button>
			}
			<p class="text-base-content/70">{ d.Tr("apikey.widen_note") }</p>
		</div>
	</details>
}

templ apikeyRowItem(d web.LayoutData, v APIKeysView, k APIKeyRow) {
	<li class="flex flex-wrap items-start gap-3 px-4 py-3">
		<div class="min-w-0 flex-1">
			<p class="flex flex-wrap items-baseline gap-2">
				<span class="truncate text-sm font-medium text-base-content">{ k.Name }</span>
				if k.OrgName != "" {
					@apikeyChip(k.OrgName)
				}
				if k.SecretHint != "" {
					<code class="font-mono text-xs text-base-content/70">…{ k.SecretHint }</code>
				}
			</p>
			if len(k.ScopeLabelKeys) > 0 {
				<p class="mt-1 flex flex-wrap gap-1">
					for _, labelKey := range k.ScopeLabelKeys {
						@apikeyChip(d.Tr(labelKey))
					}
				</p>
			}
			if k.HasGrant {
				@apikeyGrantSummary(d, k)
			}
			<p class="mt-1.5 flex flex-wrap gap-x-1.5 text-xs text-base-content/70">
				<span>
					{ d.Tr("apikey.created_label") }:
					@DateTime(d, k.CreatedAt)
				</span>
				<span>·</span>
				<span>
					{ d.Tr("apikey.expires_col_label") }:
					if k.HasExpiry {
						@DateTime(d, k.ExpiresAt)
					} else {
						{ d.Tr("apikey.never") }
					}
				</span>
				<span>·</span>
				<span>
					{ d.Tr("apikey.last_used_label") }:
					if k.HasLastUsed {
						@DateTime(d, k.LastUsedAt)
					} else {
						{ d.Tr("apikey.never") }
					}
				</span>
			</p>
			if k.HasGrant && v.CanManage && !k.Revoked && !k.AllProjects {
				@apikeyPromote(d, v, k)
			}
		</div>
		if k.Revoked {
			<span class="shrink-0 rounded-full bg-error/10 px-2 py-0.5 text-xs font-medium text-error">
				{ d.Tr("apikey.revoked_badge") }:
				@DateTime(d, k.RevokedAt)
			</span>
		} else if v.CanManage {
			@apikeyAction(d, k.Base+"/"+k.ID+"/revoke", "") {
				<button
					type="submit"
					aria-label={ d.Tr("apikey.revoke") + ": " + k.Name }
					class="shrink-0 rounded p-1.5 text-base-content/70 hover:bg-error/10 hover:text-error"
				>
					@icons.Icon("trash-2", "h-4 w-4")
				</button>
			}
		}
	</li>
}

// APIKeyList is the HTMX-swappable list section — every key form targets #apikey-list.
templ APIKeyList(d web.LayoutData, v APIKeysView) {
	<div id="apikey-list" class="grid gap-4 [&>*]:mt-0">
		if v.Minted != nil {
			@apikeyMintedBanner(d, v.Minted)
		}
		@apikeyBanner(d, v.ErrorKind, v.ErrorCode)
		<ul class="divide-y divide-base-300 overflow-hidden rounded-box border border-base-300 bg-base-100">
			if len(v.Items) == 0 && v.Personal {
				<li class="px-4 py-8 text-center text-sm text-base-content/70">{ d.Tr("pat.empty") }</li>
			} else if len(v.Items) == 0 {
				<li class="px-4 py-8 text-center text-sm text-base-content/70">{ d.Tr("apikey.empty") }</li>
			}
			for _, k := range v.Items {
				@apikeyRowItem(d, v, k)
			}
		</ul>
	</div>
}

templ apikeyGrantFields(d web.LayoutData, v APIKeysView) {
	@FieldGroup(d.Tr("apikey.access_label")) {
		<div class="group grid gap-2">
			<div class="flex flex-wrap gap-2">
				<label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-base-300 px-3 py-1 text-sm text-base-content/90 hover:bg-base-200 has-[:checked]:border-primary has-[:checked]:bg-primary/10">
					<input type="radio" name="grant" value="selected" checked class="h-3.5 w-3.5"/>
					<span>{ d.Tr("apikey.selected_projects") }</span>
				</label>
				<label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-base-300 px-3 py-1 text-sm text-base-content/90 hover:bg-base-200 has-[:checked]:border-primary has-[:checked]:bg-primary/10">
					<input type="radio" name="grant" value="all" class="h-3.5 w-3.5"/>
					<span>{ d.Tr("apikey.all_projects") }</span>
				</label>
			</div>
			@APIKeyGrantProjects(d, v.Projects)
			<p class="text-xs text-base-content/70">{ d.Tr("apikey.all_projects_note") }</p>
		</div>
	}
}

// APIKeyGrantProjects is the project picker a personal token form swaps in when its org changes.
templ APIKeyGrantProjects(d web.LayoutData, projects []APIKeyProjectOption) {
	<div id="apikey-grant-projects" class="flex flex-wrap gap-2 group-has-[input[value=all]:checked]:hidden">
		for _, p := range projects {
			<label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-base-300 px-3 py-1 text-sm text-base-content/90 hover:bg-base-200 has-[:checked]:border-primary has-[:checked]:bg-primary/10">
				<input type="checkbox" name="project_ids" value={ p.ID } class="h-3.5 w-3.5 rounded border-base-300"/>
				<span>{ p.Name }</span>
			</label>
		}
	</div>
}

templ apikeyOrgField(d web.LayoutData, v APIKeysView) {
	{{ apikeyOrgField := FieldProps{ID: "apikey-org", Label: d.Tr("pat.org_label"), Compact: true} }}
	@FormField(apikeyOrgField) {
		<select
			{ apikeyOrgField.Attrs()... }
			name="org"
			required
			hx-get={ v.Base + "/projects" }
			hx-nonce={ d.Nonce }
			hx-trigger="change"
			hx-include="this"
			hx-target="#apikey-grant-projects"
			hx-swap="outerHTML"
			class="select w-full"
		>
			for _, o := range v.Orgs {
				<option value={ o.Slug } selected?={ o.Selected }>{ o.Name }</option>
			}
		</select>
	}
}

templ apikeyMintForm(d web.LayoutData, v APIKeysView) {
	<form
		method="post"
		action={ templ.SafeURL(v.Base) }
		hx-post={ v.Base }
		hx-nonce={ d.Nonce }
		hx-target="#apikey-list"
		hx-swap="outerHTML"
		hx-disable="find button, find input"
		hx-status:4xx="target:#hx-error swap:innerHTML"
		hx-status:5xx="target:#hx-error swap:innerHTML"
		if v.Personal {
			data-clear-on-success="#apikey-name"
		} else {
			data-reset-on-success
		}
		class="grid gap-3 rounded-box border border-base-300 bg-base-100 p-4"
	>
		<div>
			if v.Personal {
				<h2 class="text-base font-semibold">{ d.Tr("pat.form_heading") }</h2>
			} else {
				<h2 class="text-base font-semibold">{ d.Tr("apikey.form_heading") }</h2>
			}
			<p class="mt-1 text-sm text-base-content/70">{ d.Tr("apikey.form_subtitle") }</p>
		</div>
		{{ apikeyNameField := FieldProps{ID: "apikey-name", Label: d.Tr("apikey.name_label"), Compact: true} }}
		@FormField(apikeyNameField) {
			<input
				{ apikeyNameField.Attrs()... }
				name="name"
				type="text"
				required
				class="input w-full"
			/>
		}
		@FieldGroup(d.Tr("apikey.scopes_label")) {
			<div class="flex flex-wrap gap-2">
				for _, opt := range v.Scopes {
					<label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-base-300 px-3 py-1 text-sm text-base-content/90 hover:bg-base-200 has-[:checked]:border-primary has-[:checked]:bg-primary/10">
						<input type="checkbox" name="scopes" value={ opt.Value } class="h-3.5 w-3.5 rounded border-base-300"/>
						<span>{ d.Tr(opt.LabelKey) }</span>
					</label>
				}
			</div>
		}
		if v.Personal {
			@apikeyOrgField(d, v)
		}
		if v.HasGrant {
			@apikeyGrantFields(d, v)
		}
		{{ apikeyExpiresField := FieldProps{ID: "apikey-expires", Label: d.Tr("apikey.expires_label"), Compact: true} }}
		@FormField(apikeyExpiresField) {
			<select
				{ apikeyExpiresField.Attrs()... }
				name="expires_in"
				required
				class="select w-full"
			>
				for _, e := range v.Expiries {
					<option value={ e.Days } selected?={ e.Selected }>{ d.Tr(e.LabelKey) }</option>
				}
			</select>
		}
		<button type="submit" class="btn btn-primary shrink-0 justify-self-start whitespace-nowrap">
			@icons.Icon("plus", "h-4 w-4")
			if v.Personal {
				<span>{ d.Tr("pat.create") }</span>
			} else {
				<span>{ d.Tr("apikey.mint") }</span>
			}
		</button>
	</form>
}

templ APIKeysPage(d web.LayoutData, v APIKeysView) {
	<section class="flex flex-col gap-4 lg:gap-6">
		@PageHeader(apiKeysTitle(d, v), apiKeysSubtitle(d, v))
		if v.Personal && len(v.Orgs) == 0 {
			<p role="status" class="alert alert-soft text-sm">{ d.Tr("pat.no_orgs") }</p>
		} else if v.CanManage {
			@apikeyMintForm(d, v)
		} else {
			<p role="status" class="alert alert-soft text-sm">{ d.Tr("apikey.read_only") }</p>
		}
		@APIKeyList(d, v)
	</section>
}

templ APIKeysLayout(d web.LayoutData, v APIKeysView) {
	@Layout(web.WithContent(d, APIKeysPage(d, v)))
}

func apiKeysTitle(d web.LayoutData, v APIKeysView) string {
	if v.Personal {
		return d.Tr("pat.title")
	}
	return d.Tr("apikey.title")
}

func apiKeysSubtitle(d web.LayoutData, v APIKeysView) string {
	if v.Personal {
		return d.Tr("pat.subtitle")
	}
	if v.OrgLevel {
		return d.Tr("apikey.org_subtitle")
	}
	return d.Tr("apikey.subtitle")
}
