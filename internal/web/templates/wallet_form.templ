package templates

import (
	"strconv"
	"time"

	"altalune.id/yasaku/civil"
	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
	"altalune.id/yasaku/money"
)

// WalletKindOption is one entry in the wallet kind picker.
type WalletKindOption struct {
	Value    string
	LabelKey string
	Selected bool
}

// WalletFormView backs both the new and the edit wallet form; an empty ID means a new wallet.
type WalletFormView struct {
	ProjectSlug string
	ID          string
	Name        string
	Provider    string
	Currency    string
	Opening     string
	Exclude     bool
	Kinds       []WalletKindOption
	ErrorKey    string
	ErrorMsg    string
	ErrorCode   string
}

// Action is the path the form posts to.
func (v WalletFormView) Action() string {
	if v.ID == "" {
		return "/wallets"
	}
	return "/wallets/" + v.ID
}

// WalletTxRow is one movement on the wallet detail page; Signed carries the direction.
type WalletTxRow struct {
	KindKey    string
	Signed     money.Amount
	Note       string
	Day        civil.Date
	OccurredAt time.Time
}

// Adjust outcomes the wallet detail page reports after POST /wallets/{id}/adjust.
const (
	AdjustChanged   = "changed"
	AdjustUnchanged = "unchanged"
)

// WalletDetailView is one wallet with its derived balance and its most recent movements.
type WalletDetailView struct {
	ProjectSlug string
	Wallet      WalletRow
	Balance     money.Amount
	Recent      []WalletTxRow
	AdjustState string
	ErrorKey    string
	ErrorMsg    string
	ErrorCode   string
}

// WalletAdjustView backs the balance-adjustment form.
type WalletAdjustView struct {
	ProjectSlug string
	WalletID    string
	WalletName  string
	Current     money.Amount
	Target      string
	ErrorKey    string
	ErrorMsg    string
	ErrorCode   string
}

// AdjustPreviewView is the live line under the adjust field; Diff counts only when HasDiff, and an empty view renders nothing.
type AdjustPreviewView struct {
	HasDiff  bool
	Diff     money.Amount
	ErrorKey string
	ErrorMsg string
}

func (v AdjustPreviewView) diffAttr() string {
	return strconv.FormatInt(v.Diff.Minor, 10)
}

templ walletKindSelect(d web.LayoutData, v WalletFormView) {
	{{ p := FieldProps{ID: "wallet-kind", Label: d.Tr("wallet.kind")} }}
	@FormField(p) {
		<select name="kind" class="select w-full text-base" { p.Attrs()... }>
			for _, k := range v.Kinds {
				<option value={ k.Value } selected?={ k.Selected }>{ d.Tr(k.LabelKey) }</option>
			}
		</select>
	}
}

templ WalletFormPage(d web.LayoutData, v WalletFormView) {
	<section class="mx-auto max-w-lg">
		if v.ID == "" {
			@PageHeader(d.Tr("wallet.new"), "")
		} else {
			@PageHeader(d.Tr("wallet.edit"), "")
		}
		@pageBanner(d, v.ErrorKey, v.ErrorMsg, v.ErrorCode)
		<form
			method="post"
			action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, v.Action())) }
			class="mt-6 flex flex-col gap-5"
		>
			{{ name := FieldProps{ID: "wallet-name", Label: d.Tr("wallet.name")} }}
			@FormField(name) {
				<input name="name" type="text" dir="auto" required autofocus value={ v.Name } class="input w-full text-base" { name.Attrs()... }/>
			}
			@walletKindSelect(d, v)
			{{ provider := FieldProps{ID: "wallet-provider", Label: d.Tr("wallet.provider")} }}
			@FormField(provider) {
				<input name="provider" type="text" dir="auto" value={ v.Provider } class="input w-full text-base" { provider.Attrs()... }/>
			}
			if v.ID == "" {
				{{ opening := FieldProps{ID: "wallet-opening", Label: d.Tr("wallet.opening_balance"), Hint: d.Tr("wallet.opening_hint")} }}
				@FormField(opening) {
					<div class="join w-full">
						<span class="join-item flex items-center border border-base-300 bg-base-200 px-3 text-sm">{ CurrencySymbol(d, money.Currency(v.Currency)) }</span>
						<input name="opening_balance" type="text" inputmode="decimal" autocomplete="off" value={ v.Opening } class="input join-item min-w-0 flex-1 text-base tabular-nums" { opening.Attrs()... }/>
					</div>
				}
				<input type="hidden" name="currency" value={ v.Currency }/>
			}
			<label class="flex min-h-11 items-start gap-3">
				<input name="exclude_from_total" type="checkbox" checked?={ v.Exclude } class="checkbox mt-0.5"/>
				<span class="min-w-0">
					<span class="block text-sm font-medium">{ d.Tr("wallet.exclude_from_total") }</span>
					<span class="block text-xs text-base-content/70">{ d.Tr("wallet.exclude_hint") }</span>
				</span>
			</label>
			<div class="flex flex-wrap items-center gap-2">
				<button type="submit" class="btn btn-primary">
					if v.ID == "" {
						{ d.Tr("wallet.new") }
					} else {
						{ d.Tr("wallet.edit") }
					}
				</button>
				@AppButton(d.ProjectPath(v.ProjectSlug, "/wallets"), "btn-ghost", nil) {
					{ d.Tr("common.cancel") }
				}
			</div>
		</form>
	</section>
}

templ WalletFormLayout(d web.LayoutData, v WalletFormView) {
	@Layout(web.WithContent(d, WalletFormPage(d, v)))
}

// AdjustPreview is the hx-get target under the adjust field; it names the difference the save would record.
templ AdjustPreview(d web.LayoutData, v AdjustPreviewView) {
	switch {
		case v.ErrorKey != "":
			<span data-adjust-error="1" class="text-error">{ d.Tr(v.ErrorKey) }</span>
		case v.ErrorMsg != "":
			<span data-adjust-error="1" class="text-error">{ v.ErrorMsg }</span>
		case v.HasDiff && v.Diff.IsZero():
			<span data-adjust-diff="0">{ d.Tr("wallet.adjust_none") }</span>
		case v.HasDiff:
			<span data-adjust-diff={ v.diffAttr() }>
				{ d.Tr("wallet.adjust_preview", "Amount", SignedMoney(d, v.Diff)) }
			</span>
	}
}

templ WalletAdjustPage(d web.LayoutData, v WalletAdjustView) {
	<section class="mx-auto max-w-lg">
		@PageHeader(d.Tr("wallet.adjust"), v.WalletName)
		@walletAdjustBody(d, v, false)
	</section>
}

// WalletAdjustDialog is the adjust form in a dialog; the wallets list lazy-loads it, and its no-JS page is WalletAdjustPage.
templ WalletAdjustDialog(d web.LayoutData, v WalletAdjustView) {
	@AppModal(d, WalletAdjustDialogID(v.WalletID), d.Tr("wallet.adjust_named", "Name", v.WalletName)) {
		@walletAdjustBody(d, v, true)
	}
}

// WalletAdjustDialogID is one wallet's adjust dialog id, so a second wallet never reopens the first one's dialog.
func WalletAdjustDialogID(walletID string) string { return "wallet-adjust-" + walletID }

templ walletAdjustBody(d web.LayoutData, v WalletAdjustView, inDialog bool) {
	@pageBanner(d, v.ErrorKey, v.ErrorMsg, v.ErrorCode)
	<p class={ "text-sm text-base-content/70", templ.KV("mt-4", !inDialog) }>{ d.Tr("wallet.adjust_hint") }</p>
	<p class="mt-4 min-w-0 text-sm break-words">
		{ d.Tr("wallet.adjust_current") }
		<span class="font-semibold tabular-nums">{ Money(d, v.Current) }</span>
	</p>
	<form
		method="post"
		action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/wallets/"+v.WalletID+"/adjust")) }
		class="mt-3 flex flex-col gap-2"
	>
		{{ target := FieldProps{ID: "wallet-adjust-target-" + v.WalletID, Label: d.Tr("wallet.adjust_target")} }}
		@FormField(target) {
			<div class="join w-full">
				<span class="join-item flex items-center border border-base-300 bg-base-200 px-3 text-sm">{ CurrencySymbol(d, v.Current.Currency) }</span>
				<input
					name="target"
					type="text"
					inputmode="decimal"
					autocomplete="off"
					required
					autofocus
					value={ v.Target }
					class="input join-item min-w-0 flex-1 text-lg tabular-nums"
					hx-get={ d.ProjectPath(v.ProjectSlug, "/wallets/"+v.WalletID+"/adjust/preview") }
					hx-nonce={ d.Nonce }
					hx-trigger="input changed delay:300ms"
					hx-target={ "#adjust-preview-" + v.WalletID }
					hx-swap="innerHTML"
					hx-sync="this:replace"
					hx-status:5xx="target:#hx-error swap:innerHTML"
					{ target.Attrs()... }
				/>
			</div>
		}
		<p id={ "adjust-preview-" + v.WalletID } aria-live="polite" class="min-h-5 text-sm tabular-nums"></p>
		if inDialog {
			<div class="modal-action mt-2">
				<button type="button" data-dialog-close class="btn btn-ghost">{ d.Tr("common.cancel") }</button>
				<button type="submit" class="btn btn-primary">{ d.Tr("wallet.adjust_save") }</button>
			</div>
		} else {
			<div class="mt-2 flex flex-wrap items-center gap-2">
				<button type="submit" class="btn btn-primary">{ d.Tr("wallet.adjust_save") }</button>
				@AppButton(d.ProjectPath(v.ProjectSlug, "/wallets/"+v.WalletID), "btn-ghost", nil) {
					{ d.Tr("common.cancel") }
				}
			</div>
		}
	</form>
}

templ WalletAdjustLayout(d web.LayoutData, v WalletAdjustView) {
	@Layout(web.WithContent(d, WalletAdjustPage(d, v)))
}

templ walletDetailTxRow(d web.LayoutData, r WalletTxRow) {
	<li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
		<span class="min-w-0 flex-1 basis-40">
			<span class="block text-sm break-words">
				if r.Note != "" {
					{ r.Note }
				} else {
					{ d.Tr(r.KindKey) }
				}
			</span>
			<span class="block text-xs text-base-content/70">
				@LedgerDate(d, r.Day, &r.OccurredAt)
				{ " · " + d.Tr(r.KindKey) }
			</span>
		</span>
		<span class="min-w-0 max-w-full text-sm font-medium tabular-nums break-words">{ SignedMoney(d, r.Signed) }</span>
	</li>
}

templ WalletDetailPage(d web.LayoutData, v WalletDetailView) {
	<section data-adjust-state={ v.AdjustState }>
		@PageHeader(v.Wallet.Name, walletDetailSubtitle(d, v.Wallet)) {
			@AppButton(d.ProjectPath(v.ProjectSlug, "/wallets"), "btn-ghost", nil) {
				{ d.Tr("wallet.title") }
			}
		}
		@pageBanner(d, v.ErrorKey, v.ErrorMsg, v.ErrorCode)
		<div class="mt-6 min-w-0 rounded-box bg-base-200 p-4">
			<p class="text-sm text-base-content/70">{ d.Tr("wallet.balance") }</p>
			<p class="mt-1 text-3xl font-bold tabular-nums break-words">{ Money(d, v.Balance) }</p>
			if v.AdjustState == AdjustUnchanged {
				<p class="mt-2 text-sm text-base-content/70">{ d.Tr("wallet.adjust_unchanged") }</p>
			}
		</div>
		if !v.Wallet.Archived {
			<div class="mt-4 flex flex-wrap gap-2">
				@AppButton(d.ProjectPath(v.ProjectSlug, "/wallets/"+v.Wallet.ID+"/adjust"), "", nil) {
					@icons.Icon("scale", "size-4")
					{ d.Tr("wallet.adjust") }
				}
				@AppButton(d.ProjectPath(v.ProjectSlug, "/transactions/new?kind=transfer&wallet="+v.Wallet.ID), "", templ.Attributes{"data-dialog-open": TxAddDialogID, "data-dialog-src": d.ProjectPath(v.ProjectSlug, "/transactions/new?kind=transfer&wallet="+v.Wallet.ID)}) {
					@icons.Icon("arrow-left-right", "size-4")
					{ d.Tr("wallet.transfer") }
				}
				@AppButton(d.ProjectPath(v.ProjectSlug, "/wallets/"+v.Wallet.ID+"/edit"), "", nil) {
					@icons.Icon("pencil", "size-4")
					{ d.Tr("wallet.edit") }
				}
				<form method="post" action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/wallets/"+v.Wallet.ID+"/archive")) }>
					<button type="submit" class="btn btn-ghost">
						@icons.Icon("lock", "size-4")
						{ d.Tr("wallet.archive") }
					</button>
				</form>
			</div>
		}
		<h2 class="mt-8 text-sm font-semibold text-base-content/70">{ d.Tr("wallet.recent") }</h2>
		<ul class="mt-2 divide-y divide-base-300 rounded-box border border-base-300 bg-base-100">
			if len(v.Recent) == 0 {
				<li class="px-4 py-8 text-center text-sm text-base-content/70">{ d.Tr("tx.empty") }</li>
			}
			for _, r := range v.Recent {
				@walletDetailTxRow(d, r)
			}
		</ul>
	</section>
}

func walletDetailSubtitle(d web.LayoutData, r WalletRow) string {
	out := d.Tr(r.KindKey)
	if r.Provider != "" {
		out += " — " + r.Provider
	}
	if r.Archived {
		out += " — " + d.Tr("wallet.archived")
	}
	return out
}

templ WalletDetailLayout(d web.LayoutData, v WalletDetailView) {
	@Layout(web.WithContent(d, WalletDetailPage(d, v)))
}
