package templates

import (
	"strconv"
	"time"

	"altalune.id/yasaku/civil"
	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
	"altalune.id/yasaku/money"
)

// PeriodRow is one period as the periods page renders it, current or historical.
type PeriodRow struct {
	ID        string
	Name      string
	Start     civil.Date
	End       *civil.Date
	Closed    bool
	ClosedAt  *time.Time
	HasTotals bool
	Income    money.Amount
	Expense   money.Amount
	Net       money.Amount
	Adjust    money.Amount
	TxCount   int
	CanReopen bool
	CanClose  bool
}

// PeriodsView is the periods page model.
type PeriodsView struct {
	OrgSlug     string
	ProjectSlug string
	ProjectName string
	HasCurrent  bool
	Current     PeriodRow
	// CloseEnd is the suggested end date the close dialog posts; HasClose is false when the preview could not be computed.
	CloseEnd    string
	CloseEndDay civil.Date
	HasClose bool
	Close    ClosePreview
	History     []PeriodRow
	Error       string
	ErrorCode   string
}

// CloseWalletRow is one wallet's closing balance inside the close preview.
type CloseWalletRow struct {
	Name    string
	Closing money.Amount
}

// ClosePreview is what closing the period would freeze.
type ClosePreview struct {
	Income  money.Amount
	Expense money.Amount
	Net     money.Amount
	Adjust  money.Amount
	TxCount int
	Wallets []CloseWalletRow
}

// ClosePeriodView is the "tutup buku" confirmation page model.
type ClosePeriodView struct {
	OrgSlug       string
	ProjectSlug   string
	ProjectName   string
	PeriodID      string
	PeriodName    string
	Start         string
	EndDate       string
	MaxDate       string
	DateLocked    bool
	AlreadyClosed bool
	HasPreview    bool
	Preview       ClosePreview
	Error         string
	ErrorCode     string
}

templ periodStatusBadge(d web.LayoutData, closed bool) {
	if closed {
		<span class="badge badge-ghost shrink-0 gap-1">
			@icons.Icon("lock", "size-3")
			{ d.Tr("period.status_closed") }
		</span>
	} else {
		<span class="badge badge-success badge-soft shrink-0 gap-1">
			@icons.Icon("lock-open", "size-3")
			{ d.Tr("period.status_open") }
		</span>
	}
}

templ periodTotals(d web.LayoutData, r PeriodRow) {
	<div class="stats stats-vertical w-full bg-base-200 sm:stats-horizontal">
		<div class="stat min-w-0 px-4">
			<div class="stat-title text-base-content/80">{ d.Tr("overview.money_in") }</div>
			<div class="stat-value text-xl tabular-nums break-words text-success">{ SignedMoney(d, r.Income) }</div>
		</div>
		<div class="stat min-w-0 px-4">
			<div class="stat-title text-base-content/80">{ d.Tr("overview.money_out") }</div>
			<div class="stat-value text-xl tabular-nums break-words">{ SignedMoney(d, r.Expense.Neg()) }</div>
		</div>
		<div class="stat min-w-0 px-4">
			<div class="stat-title text-base-content/80">{ d.Tr("period.snapshot_net") }</div>
			<div class="stat-value text-xl tabular-nums break-words">{ SignedMoney(d, r.Net) }</div>
			<div class="stat-desc text-base-content/80">{ d.TrN("category.entries_period", r.TxCount) }</div>
		</div>
	</div>
	if !r.Adjust.IsZero() {
		<p data-balance-fixes class="flex min-w-0 items-baseline justify-between gap-2 px-1 text-sm text-base-content/80">
			<span>{ d.Tr("overview.balance_fixes") }</span>
			<span class="break-all tabular-nums">{ SignedMoney(d, r.Adjust) }</span>
		</p>
	}
}

templ periodRenameForm(d web.LayoutData, projectSlug string, r PeriodRow) {
	<form
		method="post"
		action={ templ.SafeURL(d.ProjectPath(projectSlug, "/periods/"+r.ID+"/rename")) }
		class="flex flex-wrap items-center gap-2"
	>
		<input
			name="name"
			type="text"
			dir="auto"
			required
			value={ r.Name }
			aria-label={ d.Tr("period.rename") + ": " + r.Name }
			class="input min-w-0 flex-1 text-base"
		/>
		<button type="submit" class="btn">{ d.Tr("period.rename") }</button>
	</form>
}

templ periodRenameCollapse(d web.LayoutData, projectSlug string, r PeriodRow) {
	@AppCollapse("", "border border-base-300", textTitle(d.Tr("period.rename"))) {
		@periodRenameForm(d, projectSlug, r)
	}
}

templ periodCurrentCard(d web.LayoutData, v PeriodsView) {
	<section class="flex min-w-0 flex-col gap-3 rounded-box border border-base-300 bg-base-100 p-4" aria-labelledby="period-current-title">
		<h2 id="period-current-title" class="text-lg font-semibold break-words">{ v.Current.Name }</h2>
		if v.Current.HasTotals {
			@periodTotals(d, v.Current)
		} else {
			<p role="alert" class="alert alert-soft alert-error text-sm">{ d.Tr("period.totals_unavailable") }</p>
		}
		<p class="text-sm text-base-content/70">{ d.Tr("period.close_hint", "Name", v.Current.Name) }</p>
		<div class="flex flex-wrap items-center gap-2">
			if v.HasClose {
				<button type="button" data-dialog-open="close-month-dialog" class="btn btn-primary">
					@icons.Icon("lock", "size-4")
					{ d.Tr("overview.close_named", "Period", v.Current.Name) }
				</button>
			} else {
				@AppButton(d.ProjectPath(v.ProjectSlug, "/periods/"+v.Current.ID+"/close"), "btn-primary", nil) {
					@icons.Icon("lock", "size-4")
					{ d.Tr("overview.close_named", "Period", v.Current.Name) }
				}
			}
			@AppButton(d.ProjectPath(v.ProjectSlug, "/reports?period="+v.Current.ID), "btn-ghost", nil) {
				{ d.Tr("period.see_report_first") }
			}
		</div>
		@periodRenameCollapse(d, v.ProjectSlug, v.Current)
	</section>
}

templ closePreviewList(d web.LayoutData, p ClosePreview) {
	<dl class="flex flex-col gap-2 text-sm">
		<div class="flex items-baseline justify-between gap-4">
			<dt>{ d.Tr("overview.money_in") }</dt>
			<dd class="min-w-0 font-semibold tabular-nums break-words text-success">{ SignedMoney(d, p.Income) }</dd>
		</div>
		<div class="flex items-baseline justify-between gap-4">
			<dt>{ d.Tr("overview.money_out") }</dt>
			<dd class="min-w-0 font-semibold tabular-nums break-words">{ SignedMoney(d, p.Expense.Neg()) }</dd>
		</div>
		if !p.Adjust.IsZero() {
			<div data-balance-fixes class="flex items-baseline justify-between gap-4">
				<dt>{ d.Tr("overview.balance_fixes") }</dt>
				<dd class="min-w-0 font-semibold tabular-nums break-words">{ SignedMoney(d, p.Adjust) }</dd>
			</div>
		}
		<div class="flex items-baseline justify-between gap-4 border-t border-base-300 pt-2">
			<dt>{ d.Tr("period.snapshot_net") }</dt>
			<dd class="min-w-0 font-bold tabular-nums break-words">{ SignedMoney(d, p.Net) }</dd>
		</div>
		<div class="flex items-baseline justify-between gap-4">
			<dt class="text-base-content/70">{ d.Tr("period.tx_count") }</dt>
			<dd class="tabular-nums text-base-content/70">{ strconv.Itoa(p.TxCount) }</dd>
		</div>
	</dl>
}

templ periodCloseDialog(d web.LayoutData, v PeriodsView) {
	@AppModal(d, "close-month-dialog", d.Tr("period.close_title", "Name", v.Current.Name)) {
		<form
			method="post"
			action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/periods/"+v.Current.ID+"/close")) }
			class="flex flex-col gap-4"
		>
			@closePreviewList(d, v.Close)
			<p class="text-sm text-base-content/70">{ d.Tr("period.close_confirm") }</p>
			<p class="text-sm">
				{ d.Tr("period.ends_on") }
				<span class="font-semibold tabular-nums">
					@LedgerDate(d, v.CloseEndDay, nil)
				</span>
				<a class="link ms-1" href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/periods/"+v.Current.ID+"/close")) }>{ d.Tr("period.change_end") }</a>
			</p>
			<input type="hidden" name="end_date" value={ v.CloseEnd }/>
			<div class="modal-action mt-0">
				<button type="button" data-dialog-close class="btn btn-ghost">{ d.Tr("common.cancel") }</button>
				<button type="submit" class="btn btn-primary">
					@icons.Icon("lock", "size-4")
					{ d.Tr("overview.close_named", "Period", v.Current.Name) }
				</button>
			</div>
		</form>
	}
}

templ periodListRow(d web.LayoutData, projectSlug string, r PeriodRow, current bool) {
	<li class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-2 p-4">
		<span class="grid size-10 shrink-0 place-items-center rounded-full bg-base-200" aria-hidden="true">
			if r.Closed {
				@icons.Icon("lock", "size-4")
			} else {
				@icons.Icon("lock-open", "size-4")
			}
		</span>
		<div class="min-w-0 flex-1 basis-32">
			<p class="font-medium break-words">{ r.Name }</p>
			<p class="text-sm tabular-nums text-base-content/70">
				if current {
					{ d.Tr("period.current") + " · " }
				}
				@LedgerDate(d, r.Start, nil)
				if !current {
					if r.End != nil {
						{ " – " }
						@LedgerDate(d, *r.End, nil)
					}
				}
			</p>
		</div>
		if r.CanReopen {
			<form method="post" action={ templ.SafeURL(d.ProjectPath(projectSlug, "/periods/"+r.ID+"/reopen")) }>
				<button type="submit" class="btn btn-ghost">{ d.Tr("period.reopen") }</button>
			</form>
		}
		if r.CanClose {
			@AppButton(d.ProjectPath(projectSlug, "/periods/"+r.ID+"/close"), "btn-ghost", nil) {
				{ d.Tr("period.close") }
			}
		}
		if r.Closed {
			<span class="badge badge-sm badge-ghost shrink-0">{ d.Tr("period.status_closed") }</span>
		} else {
			<span class="badge badge-sm badge-outline shrink-0">{ d.Tr("period.status_open") }</span>
		}
	</li>
}

templ PeriodsPage(d web.LayoutData, v PeriodsView) {
	<section class="flex max-w-2xl flex-col gap-4 lg:gap-6">
		@PageHeader(d.Tr("period.title"), "")
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		if v.HasCurrent {
			@periodCurrentCard(d, v)
		} else {
			@EmptyState(EmptyStateProps{Title: d.Tr("period.no_period"), Icon: "calendar-range"}) {
				@AppButton(d.ProjectPath(v.ProjectSlug, "/transactions/new"), "btn-primary", nil) {
					@icons.Icon("circle-plus", "size-4")
					{ d.Tr("overview.quick_add") }
				}
			}
		}
		if v.HasCurrent || len(v.History) > 0 {
			<section aria-labelledby="period-list-title">
				<h2 id="period-list-title" class="mb-2 text-sm font-semibold text-base-content/70">{ d.Tr("period.all") }</h2>
				<ul class="divide-y divide-base-300 rounded-box border border-base-300 bg-base-100">
					if v.HasCurrent {
						@periodListRow(d, v.ProjectSlug, v.Current, true)
					}
					for _, r := range v.History {
						@periodListRow(d, v.ProjectSlug, r, false)
					}
				</ul>
			</section>
		}
	</section>
}

templ PeriodsLayout(d web.LayoutData, v PeriodsView) {
	if v.HasCurrent && v.HasClose {
		@Layout(web.WithDialogs(web.WithContent(d, PeriodsPage(d, v)), periodCloseDialog(d, v)))
	} else {
		@Layout(web.WithContent(d, PeriodsPage(d, v)))
	}
}

// ClosePreviewFragment is the hx-get target the end-date input refreshes on change.
templ ClosePreviewFragment(d web.LayoutData, v ClosePeriodView) {
	<div id="close-preview" class="mt-6 flex flex-col gap-3 rounded-box border border-base-300 bg-base-100 p-4">
		<h2 class="text-sm font-semibold text-base-content/70">{ d.Tr("period.preview") }</h2>
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		if v.HasPreview {
			@closePreviewList(d, v.Preview)
			if len(v.Preview.Wallets) > 0 {
				<h3 class="mt-2 text-xs font-semibold text-base-content/70">{ d.Tr("period.snapshot_wallets") }</h3>
				<ul class="divide-y divide-base-300">
					for _, wrow := range v.Preview.Wallets {
						<li class="flex items-baseline justify-between gap-4 py-2 text-sm">
							<span class="min-w-0 break-words">{ wrow.Name }</span>
							<span class="min-w-0 tabular-nums break-words">{ Money(d, wrow.Closing) }</span>
						</li>
					}
				</ul>
			}
		} else if v.Error == "" {
			<p class="text-sm text-base-content/70">{ d.Tr("report.no_data") }</p>
		}
	</div>
}

templ ClosePeriodPage(d web.LayoutData, v ClosePeriodView) {
	<section class="max-w-2xl">
		@PageHeader(d.Tr("period.close"), v.PeriodName+" · "+v.Start) {
			@AppButton(d.ProjectPath(v.ProjectSlug, "/periods"), "btn-ghost", nil) {
				{ d.Tr("period.title") }
			}
		}
		if v.AlreadyClosed {
			<div class="mt-6 flex flex-col gap-3 rounded-box border border-base-300 bg-base-100 p-4">
				<div class="flex flex-wrap items-center gap-2">
					@periodStatusBadge(d, true)
					<span class="text-sm break-words">{ v.PeriodName }</span>
				</div>
				<p class="text-sm text-base-content/70">{ d.Tr("period.locked_hint") }</p>
			</div>
			@ClosePreviewFragment(d, v)
		} else {
			<form
				method="post"
				action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/periods/"+v.PeriodID+"/close")) }
				class="mt-6"
			>
				{{ end := FieldProps{ID: "close-end-date", Label: d.Tr("period.end_date")} }}
				{{ end.Hint = d.Tr("period.end_date_hint") }}
				if v.DateLocked {
					{{ end.Hint = d.Tr("period.locked_hint") }}
				}
				@FormField(end) {
					<input
						name="end_date"
						type="date"
						required
						value={ v.EndDate }
						max={ v.MaxDate }
						disabled?={ v.DateLocked }
						hx-get={ d.ProjectPath(v.ProjectSlug, "/periods/"+v.PeriodID+"/close") }
						hx-nonce={ d.Nonce }
						hx-trigger="change"
						hx-target="#close-preview"
						hx-swap="outerHTML"
						hx-status:4xx="target:#hx-error swap:innerHTML"
						hx-status:5xx="target:#hx-error swap:innerHTML"
						class="input w-full text-base sm:max-w-xs"
						{ end.Attrs()... }
					/>
				}
				if v.DateLocked {
					<input type="hidden" name="end_date" value={ v.EndDate }/>
				} else {
					@DateInputHint(d)
				}
				@ClosePreviewFragment(d, v)
				<p class="mt-6 text-sm text-base-content/70">{ d.Tr("period.close_confirm") }</p>
				<div class="mt-3 flex flex-wrap gap-2">
					<button type="submit" class="btn btn-primary w-full sm:w-auto">
						@icons.Icon("lock", "size-4")
						{ d.Tr("period.close") }
					</button>
					@AppButton(d.ProjectPath(v.ProjectSlug, "/periods"), "w-full sm:w-auto", nil) {
						{ d.Tr("common.cancel") }
					}
				</div>
			</form>
		}
	</section>
}

templ ClosePeriodLayout(d web.LayoutData, v ClosePeriodView) {
	@Layout(web.WithContent(d, ClosePeriodPage(d, v)))
}
