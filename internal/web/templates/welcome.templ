package templates

import "altalune.id/yasaku/internal/web"

// WelcomeView is the payload for the T&C acceptance / display-name page.
type WelcomeView struct {
	Email          string
	Name           string
	AskDisplayName bool
	AskAccept      bool
	TermsURL       string
	PrivacyURL     string
	ReturnTo       string
	Error          string
	ErrorCode string
}

templ WelcomePage(d web.LayoutData, v WelcomeView) {
	<section class="mx-auto flex max-w-xl flex-col gap-4 lg:gap-6">
		<header class="border-b border-base-300 pb-4">
			<p class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{ d.Tr("welcome.eyebrow") }</p>
			<h1 class="mt-1 text-2xl font-semibold text-base-content">{ d.Tr("welcome.title") }</h1>
			<p class="mt-2 text-sm text-base-content/70">
				{ d.Tr("welcome.subtitle_prefix") }
				<strong class="text-base-content">{ v.Email }</strong>{ d.Tr("welcome.subtitle_suffix") }
			</p>
		</header>
		if v.Error != "" {
			<div class="[&>[role=alert]]:mt-0">
				@ErrorBanner(d, v.Error, v.ErrorCode)
			</div>
		}
		<form method="post" action={ templ.SafeURL(d.Href("/welcome")) } class="flex flex-col gap-4" novalidate>
			<input type="hidden" name="return_to" value={ v.ReturnTo }/>
			if v.AskDisplayName {
				{{ name := FieldProps{ID: "welcome-name", Label: d.Tr("welcome.display_name_label"), Hint: d.Tr("welcome.display_name_hint")} }}
				@FormField(name) {
					<input name="name" type="text" required autofocus value={ v.Name } placeholder={ d.Tr("welcome.display_name_placeholder") } class="input w-full text-base" { name.Attrs()... }/>
				}
			}
			if v.AskAccept {
				@acceptTermsField(d, "welcome-accept", v.TermsURL, v.PrivacyURL)
			}
			<button type="submit" class="btn btn-primary w-full sm:w-auto">{ d.Tr("welcome.submit") }</button>
		</form>
		<form method="post" action={ templ.SafeURL(d.Href("/logout")) } class="flex justify-center">
			<button type="submit" class="btn btn-ghost">{ d.Tr("welcome.wrong_account") }</button>
		</form>
	</section>
}

templ acceptTermsField(d web.LayoutData, id, termsURL, privacyURL string) {
	<label class="flex min-h-11 cursor-pointer items-center gap-3 text-sm">
		<input id={ id } name="accept_terms" type="checkbox" value="1" required class="checkbox shrink-0"/>
		<span>
			{ d.Tr("welcome.accept_prefix") }
			if termsURL != "" {
				<a href={ templ.SafeURL(termsURL) } target="_blank" rel="noopener" class="link">{ d.Tr("welcome.terms_link") }</a>
			}
			if termsURL != "" && privacyURL != "" {
				{ " " }{ d.Tr("welcome.and") }{ " " }
			}
			if privacyURL != "" {
				<a href={ templ.SafeURL(privacyURL) } target="_blank" rel="noopener" class="link">{ d.Tr("welcome.privacy_link") }</a>{ d.Tr("welcome.accept_suffix") }
			} else {
				{ d.Tr("welcome.accept_suffix") }
			}
		</span>
	</label>
}

templ WelcomeLayout(d web.LayoutData, v WelcomeView) {
	@Layout(web.WithContent(d, WelcomePage(d, v)))
}
