package templates

import (
	"fmt"

	"altalune.id/yasaku/internal/web"
)

type OverviewView struct {
	OrgSlug string
	ProjectID   string
	ProjectSlug string
	ProjectName string
	TotalTodos  int
	OpenTodos   int
	DoneTodos   int
}

templ OverviewPage(d web.LayoutData, v OverviewView) {
	<section class="flex flex-col gap-6">
		<header class="border-b border-base-300 pb-4">
			<p class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{ d.Tr("nav.overview") }</p>
			<h1 class="mt-1 text-2xl font-semibold text-base-content">{ v.ProjectName }</h1>
			<div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-base-content/70">
				@copyValue(d, v.OrgSlug)
				<span aria-hidden="true" class="text-base-content/70">/</span>
				@copyValue(d, v.ProjectSlug)
				<span aria-hidden="true" class="text-base-content/70">·</span>
				@copyValue(d, v.ProjectID)
			</div>
		</header>
		<div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
			@statCard(d.Tr("nav.todos"), fmt.Sprintf("%d", v.TotalTodos))
			@statCard(d.Tr("overview.stat_open"), fmt.Sprintf("%d", v.OpenTodos))
			@statCard(d.Tr("overview.stat_done"), fmt.Sprintf("%d", v.DoneTodos))
		</div>
		<div class="rounded-lg border border-base-300 bg-base-100 p-6 shadow-sm">
			<h2 class="text-sm font-semibold text-base-content">{ d.Tr("overview.quick_actions") }</h2>
			<div class="mt-4 flex flex-wrap gap-2">
				<a
					href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/todos")) }
					class="inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-content shadow-sm hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
				>
					{ d.Tr("overview.open_todos") }
				</a>
				<a
					href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/posts")) }
					class="inline-flex items-center rounded-md border border-base-300 px-4 py-2 text-sm font-medium text-base-content/90 shadow-sm hover:bg-base-200 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
				>
					{ d.Tr("overview.open_posts") }
				</a>
			</div>
		</div>
	</section>
}

templ copyValue(d web.LayoutData, value string) {
	@copyButton(d, value, value, d.Tr("common.copy")+": "+value)
}

templ copyButton(d web.LayoutData, value, text, label string) {
	<button
		type="button"
		data-copy={ value }
		data-copy-text={ text }
		data-copy-label={ label }
		data-copied-label={ d.Tr("common.copied") }
		aria-label={ label }
		class="rounded-md font-mono text-xs text-base-content/70 hover:text-base-content focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-1"
	>{ text }</button>
}

templ statCard(label, value string) {
	<div class="rounded-lg border border-base-300 bg-base-100 p-4 shadow-sm">
		<p class="text-xs font-semibold uppercase tracking-wide text-base-content/70">{ label }</p>
		<p class="mt-2 text-2xl font-semibold text-base-content">{ value }</p>
	</div>
}

templ OverviewLayout(d web.LayoutData, v OverviewView) {
	@Layout(web.WithContent(d, OverviewPage(d, v)))
}
