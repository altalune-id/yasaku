package templates

import "altalune.id/yasaku/internal/web"

type LoginView struct {
	Error      string
	ErrorCode string
	Message    string
	ReturnTo   string
	LastEmail  string
	AdminForce bool
	LocalAuth  bool
	TermsURL   string
	PrivacyURL string
}

templ LoginPage(d web.LayoutData, v LoginView) {
	<section class="mx-auto max-w-sm">
		<h1 class="text-2xl font-semibold text-center">{ d.Tr("login.title") }</h1>
		if v.Message != "" {
			<div class="mt-4 p-3 rounded bg-success/10 text-success text-sm border border-success/30">{ v.Message }</div>
		}
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		if d.Caps.ExternalIdentity && !v.AdminForce {
			if v.LastEmail != "" {
				<a
					class="btn-sso mt-6"
					title={ d.Tr("login.continue_as") + " " + v.LastEmail }
					href={ templ.SafeURL(d.Href("/login/oidc?return_to=" + v.ReturnTo)) }
				>
					<img class="btn-sso__logo" src={ d.OIDCButtonLogoURL() } alt="" aria-hidden="true" width="24" height="24"/>
					<span class="btn-sso__label">{ d.Tr("login.continue_as") } { v.LastEmail }</span>
					<span class="btn-sso__chev" aria-hidden="true">→</span>
				</a>
				<p class="mt-3 text-center text-sm text-base-content/70">
					<a class="hover:underline" href={ templ.SafeURL(d.Href("/login/oidc?switch=1&return_to=" + v.ReturnTo)) }>{ d.Tr("login.switch_account") }</a>
				</p>
			} else {
				<a
					class="btn-sso mt-6"
					href={ templ.SafeURL(d.Href("/login/oidc?return_to=" + v.ReturnTo)) }
				>
					<img class="btn-sso__logo" src={ d.OIDCButtonLogoURL() } alt="" aria-hidden="true" width="24" height="24"/>
					<span class="btn-sso__label">{ d.OIDCButtonLabel(d.Tr("login.oidc_button")) }</span>
					<span class="btn-sso__chev" aria-hidden="true">→</span>
				</a>
			}
			if v.LocalAuth {
				<div class="mt-6 text-center">
					<a href={ templ.SafeURL(d.Href("/admin-login")) } class="text-sm text-base-content/70 hover:underline">
						{ d.Tr("login.admin_link") }
					</a>
				</div>
			}
		}
		if v.LocalAuth && (v.AdminForce || !d.Caps.ExternalIdentity) {
			<form method="post" action={ templ.SafeURL(d.Href("/login")) } class="mt-6 space-y-4">
				if v.ReturnTo != "" {
					<input type="hidden" name="return_to" value={ v.ReturnTo }/>
				}
				if v.AdminForce {
					<input type="hidden" name="admin" value="1"/>
				}
				{{ emailField := FieldProps{ID: "email", Label: d.Tr("login.email")} }}
				@FormField(emailField) {
					<input
						{ emailField.Attrs()... }
						name="email"
						type="email"
						required
						autocomplete="username"
						class="input w-full"
					/>
				}
				{{ passwordField := FieldProps{ID: "password", Label: d.Tr("login.password")} }}
				@FormField(passwordField) {
					<input
						{ passwordField.Attrs()... }
						name="password"
						type="password"
						required
						autocomplete="current-password"
						class="input w-full"
					/>
				}
				<button
					type="submit"
					class="btn btn-primary w-full"
				>
					{ d.Tr("login.submit") }
				</button>
			</form>
		}
		if !v.LocalAuth && !d.Caps.ExternalIdentity {
			<p class="mt-6 text-center text-sm text-base-content/70">
				{ d.Tr("login.no_method") }
			</p>
		}
		if v.TermsURL != "" || v.PrivacyURL != "" {
			<p data-legal-links class="mt-8 flex items-center justify-center gap-2 text-xs text-base-content/70">
				if v.TermsURL != "" {
					<a href={ templ.SafeURL(v.TermsURL) } class="link link-hover">{ d.Tr("title.terms") }</a>
				}
				if v.TermsURL != "" && v.PrivacyURL != "" {
					<span aria-hidden="true">·</span>
				}
				if v.PrivacyURL != "" {
					<a href={ templ.SafeURL(v.PrivacyURL) } class="link link-hover">{ d.Tr("title.privacy") }</a>
				}
			</p>
		}
	</section>
}

templ LoginLayout(d web.LayoutData, v LoginView) {
	@Layout(web.WithContent(d, LoginPage(d, v)))
}
