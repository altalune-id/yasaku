package templates

import "altalune.id/yasaku/internal/web"

// SignupCompleteView backs the /signup/complete form.
type SignupCompleteView struct {
	Email          string
	Name           string
	AskDisplayName bool
	AskAccept      bool
	TermsURL       string
	PrivacyURL     string
	FieldErrors    map[string]string
	Error          string
	ErrorCode      string
}

func signupFieldError(d web.LayoutData, key string) string {
	if key == "" {
		return ""
	}
	return d.Tr(key)
}

templ SignupCompletePage(d web.LayoutData, v SignupCompleteView) {
	<section class="mx-auto flex max-w-xl flex-col gap-4 lg:gap-6">
		@PageHeader(d.Tr("signup.title"), d.Tr("signup.lead"))
		if v.Error != "" {
			<div class="[&>[role=alert]]:mt-0">
				@ErrorBanner(d, d.Tr(v.Error), v.ErrorCode)
			</div>
		}
		<form method="post" action={ templ.SafeURL(d.Href("/signup/complete")) } class="card border border-base-300 bg-base-100" novalidate>
			<div class="card-body gap-4 p-4 sm:p-6">
				<p class="text-sm text-base-content/70">
					{ d.Tr("common.signed_in_as") }
					<strong class="break-all font-semibold text-base-content">{ v.Email }</strong>
				</p>
				<fieldset class="fieldset min-w-0 p-0">
					if v.AskDisplayName {
						{{ name := FieldProps{ID: "signup-name", Label: d.Tr("welcome.display_name_label"), Hint: d.Tr("signup.name_hint"), Error: signupFieldError(d, v.FieldErrors["name"])} }}
						@FormField(name) {
							<input
								name="name"
								type="text"
								required
								maxlength="200"
								autocomplete="name"
								value={ v.Name }
								placeholder={ d.Tr("welcome.display_name_placeholder") }
								class={ "input w-full text-base", templ.KV("input-error", name.Error != "") }
								{ name.Attrs()... }
							/>
						}
					} else {
						<p class="label text-sm text-base-content">{ d.Tr("signup.workspace_name") }</p>
						<p class="text-base font-semibold break-words">{ v.Name }</p>
						<p class="label whitespace-normal text-base-content/70">{ d.Tr("signup.name_hint") }</p>
					}
				</fieldset>
				if v.AskAccept {
					@acceptTermsField(d, "signup-accept", v.TermsURL, v.PrivacyURL)
				}
				<button type="submit" class="btn btn-primary w-full sm:w-auto sm:self-end">{ d.Tr("signup.submit") }</button>
			</div>
		</form>
		<form method="post" action={ templ.SafeURL(d.Href("/logout")) } class="flex justify-center">
			<button type="submit" class="btn btn-ghost">{ d.Tr("welcome.wrong_account") }</button>
		</form>
	</section>
}

templ SignupCompleteLayout(d web.LayoutData, v SignupCompleteView) {
	@Layout(web.WithContent(d, SignupCompletePage(d, v)))
}
