package templates

import (
	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
)

// Dialog renders its children in a native modal dialog that dialog.js opens from any [data-dialog-open] control.
templ Dialog(d web.LayoutData, id string, title string) {
	<dialog
		id={ id }
		class="dialog backdrop:bg-black/50"
		aria-labelledby={ id + "-title" }
		data-dialog-close-on-success
	>
		<div class="max-h-[calc(100dvh-2rem)] w-[min(36rem,calc(100vw-2rem))] max-w-none gap-4 rounded-xl border border-border bg-card p-5 text-foreground shadow-lg [translate:-50%_-50%]">
			<header class="pe-8">
				<h2 id={ id + "-title" } class="text-lg font-semibold leading-none tracking-tight">{ title }</h2>
			</header>
			<section class="-mx-5 min-h-0 overflow-y-auto px-5">
				{ children... }
			</section>
			<button
				type="button"
				data-dialog-close
				aria-label={ d.Tr("dialog.close") }
				class="end-4 top-4 rounded-md p-1 text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring"
			>
				@icons.Icon("x", "h-4 w-4")
			</button>
		</div>
	</dialog>
	<script defer src={ d.Static("dialog.js") } nonce={ d.Nonce }></script>
}
