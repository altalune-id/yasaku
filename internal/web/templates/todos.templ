package templates

import (
	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
)

type TodosView struct {
	OrgSlug string
	ProjectID   string
	ProjectSlug string
	ProjectName string
	Items       []TodoRow
	Error       string
	ErrorCode string
}

// TodoList is the HTMX-swappable list section — POST to /todos targets #todo-list.
templ TodoList(d web.LayoutData, items []TodoRow) {
	<ul id="todo-list" class="mt-6 divide-y divide-base-300/50 rounded-lg border border-base-300 bg-base-100 shadow-sm">
		if len(items) == 0 {
			<li class="px-4 py-8 text-center text-sm text-base-content/70">{ d.Tr("todos.empty") }</li>
		}
		for _, t := range items {
			@TodoRowFragment(d, t)
		}
	</ul>
}

templ TodosPage(d web.LayoutData, v TodosView) {
	<section>
		<header class="flex items-baseline justify-between border-b border-base-300 pb-4">
			<div>
				<h1 class="text-2xl font-semibold text-base-content">{ d.Tr("nav.todos") }</h1>
				<p class="mt-1 text-sm text-base-content/70">{ v.ProjectName }</p>
			</div>
			<form
				method="post"
				action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/todos/clear")) }
				hx-post={ d.ProjectPath(v.ProjectSlug, "/todos/clear") }
				hx-nonce={ d.Nonce }
				hx-target="#todo-list"
				hx-swap="outerHTML"
				hx-disable="find button, find input"
				hx-status:4xx="target:#hx-error swap:innerHTML"
				hx-status:5xx="target:#hx-error swap:innerHTML"
				class="inline"
			>
				<button type="submit" class="inline-flex items-center gap-1.5 text-sm text-base-content/70 hover:text-base-content">
					@icons.Icon("trash-2", "h-4 w-4")
					<span>{ d.Tr("todos.clear_completed") }</span>
				</button>
			</form>
		</header>
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		<form
			method="post"
			action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/todos")) }
			hx-post={ d.ProjectPath(v.ProjectSlug, "/todos") }
			hx-nonce={ d.Nonce }
			hx-target="#todo-list"
			hx-swap="outerHTML"
			hx-disable="find button, find input"
			hx-status:4xx="target:#hx-error swap:innerHTML"
			hx-status:5xx="target:#hx-error swap:innerHTML"
			data-reset-on-success
			class="mt-6 flex gap-2"
		>
			<input
				name="title"
				type="text"
				required
				placeholder={ d.Tr("todos.placeholder") }
				class="input flex-1"
			/>
			<button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-content shadow-sm hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2">
				{ d.Tr("todos.add") }
			</button>
		</form>
		@TodoList(d, v.Items)
	</section>
}

templ TodosLayout(d web.LayoutData, v TodosView) {
	@Layout(web.WithContent(d, TodosPage(d, v)))
}
