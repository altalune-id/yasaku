package templates

import (
	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
)

const switcherDialogID = "switcher"

templ switcherRail(d web.LayoutData, projectIcon string) {
	<div class="hidden lg:block" data-org-switcher="rail">
		@AppDropdown(switcherRailTrigger(d), switcherLabel(d), "w-full", switcherTriggerClass(d), "start-0 top-full mt-2 max-h-[70dvh] w-72 min-w-full overflow-y-auto") {
			@switcherList(d, projectIcon)
		}
	</div>
}

templ switcherRailTrigger(d web.LayoutData) {
	<span class="min-w-0">
		if len(d.OtherOrgs) > 0 && d.ActiveOrg != nil {
			<span class="block truncate text-xs font-normal text-base-content/70">{ d.ActiveOrg.Name }</span>
		}
		<span class="block truncate font-semibold">{ switcherTitle(d) }</span>
	</span>
	@icons.Icon("chevrons-up-down", "size-4 shrink-0 opacity-70")
}

templ switcherPhoneTrigger(d web.LayoutData) {
	<button
		type="button"
		class="btn btn-ghost h-11 min-w-0 max-w-[60vw] gap-1 px-2 text-base font-bold"
		data-dialog-open={ switcherDialogID }
		aria-haspopup="dialog"
		aria-label={ switcherLabel(d) }
	>
		<span class="truncate">{ switcherTitle(d) }</span>
		@icons.Icon("chevron-down", "size-4 shrink-0 opacity-70")
	</button>
}

templ switcherSheet(d web.LayoutData, projectIcon string) {
	@AppModal(d, switcherDialogID, d.Tr("switcher.title")) {
		@switcherList(d, projectIcon)
	}
}

templ switcherList(d web.LayoutData, projectIcon string) {
	<ul class="menu w-full gap-0.5 p-0 [&_a]:min-h-11 [&_a]:content-center [&_a]:gap-3 [&_button]:min-h-11 [&_button]:content-center [&_button]:gap-3">
		if len(d.OtherOrgs) > 0 && d.ActiveOrg != nil {
			<li class="menu-title flex h-8 justify-center px-3 py-0 text-base-content/70">
				<span class="flex min-w-0 items-center gap-2">
					<span class="truncate">{ d.ActiveOrg.Name }</span>
					if d.ActiveOrg.System {
						<span class="badge badge-sm badge-ghost">{ d.Tr("common.system") }</span>
					}
				</span>
			</li>
		}
		if p := d.ActiveProject; p != nil {
			@switcherProject(d.ProjectPath(p.Slug, "/overview"), projectIcon, p.Name, true)
		}
		for _, p := range d.OtherProjects {
			@switcherProject(d.ProjectPath(p.Slug, "/overview"), projectIcon, p.Name, false)
		}
		if d.ActiveOrg != nil {
			<li>
				<a href={ templ.SafeURL(d.OrgPath("/projects/new")) }>
					@icons.Icon("plus", "size-4")
					{ d.Tr("nav.new_project") }
				</a>
			</li>
		}
		if len(d.OtherOrgs) > 0 {
			<li class="menu-title mt-1.5 flex h-8 justify-center px-3 py-0 text-base-content/70">{ d.Tr("switcher.other_orgs") }</li>
			for _, o := range d.OtherOrgs {
				<li>
					<a href={ templ.SafeURL(d.Href("/orgs/" + o.Slug + "/switch")) } title={ o.Name }>
						@icons.Icon("building-2", "size-4 shrink-0")
						<span class="min-w-0 flex-1 truncate">{ o.Name }</span>
						if o.System {
							<span class="badge badge-sm badge-ghost">{ d.Tr("common.system") }</span>
						}
						@icons.Icon("chevron-right", "size-4 shrink-0 rtl:rotate-180")
					</a>
				</li>
			}
		}
		if d.ActiveOrg != nil {
			<li class="mx-3 my-1.5" role="separator"></li>
			<li>
				<a href={ templ.SafeURL(d.Href("/orgs/" + d.ActiveOrg.Slug)) }>
					@icons.Icon("settings", "size-4")
					{ d.Tr("switcher.manage_org") }
				</a>
			</li>
		}
		if d.Caps.OrgCreation {
			<li>
				<a href={ templ.SafeURL(d.Href("/orgs/new")) }>
					@icons.Icon("plus", "size-4")
					{ d.Tr("nav.new_organization") }
				</a>
			</li>
		}
	</ul>
}

templ switcherProject(href, icon, name string, active bool) {
	<li>
		if active {
			<button type="button" data-dialog-close title={ name } class="menu-active" aria-current="page">
				@icons.Icon(icon, "size-4 shrink-0")
				<span class="min-w-0 flex-1 truncate">{ name }</span>
				@icons.Icon("check", "size-4 shrink-0")
			</button>
		} else {
			<a href={ templ.SafeURL(href) } title={ name }>
				@icons.Icon(icon, "size-4 shrink-0")
				<span class="min-w-0 flex-1 truncate">{ name }</span>
			</a>
		}
	</li>
}

func switcherTriggerClass(d web.LayoutData) string {
	if len(d.OtherOrgs) > 0 && d.ActiveOrg != nil {
		return "h-14 w-full justify-between gap-2 px-3 text-start"
	}
	return "h-11 w-full justify-between gap-2 px-3 text-start"
}

func switcherTitle(d web.LayoutData) string {
	if d.ActiveProject != nil {
		return d.ActiveProject.Name
	}
	if d.ActiveOrg != nil {
		return d.ActiveOrg.Name
	}
	return d.Tr("common.select_project")
}

func switcherLabel(d web.LayoutData) string {
	org := d.Tr("common.no_organization")
	if d.ActiveOrg != nil {
		org = d.ActiveOrg.Name
	}
	return d.Tr("switcher.label", "Org", org, "Project", switcherTitle(d))
}
