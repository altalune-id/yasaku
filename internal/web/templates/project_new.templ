package templates

import "altalune.id/yasaku/internal/web"

type ProjectNewView struct {
	OrgSlug   string
	Slug  string
	Name  string
	Error string
	ErrorCode string
	Blocked   bool
}

templ ProjectNewPage(d web.LayoutData, v ProjectNewView) {
	<section class="mx-auto max-w-xl">
		<header class="border-b border-base-300 pb-4">
			<h1 class="text-2xl font-semibold text-base-content">{ d.Tr("nav.create_project") }</h1>
			<p class="mt-1 text-sm text-base-content/70">
				{ d.Tr("project_new.subtitle_prefix") }
				if d.ActiveOrg != nil {
					<span class="font-medium text-base-content/90">{ d.ActiveOrg.Name }</span>.
				} else {
					{ d.Tr("project_new.subtitle_fallback") }
				}
			</p>
		</header>
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		<form method="post" action={ templ.SafeURL(d.Href("/orgs/" + v.OrgSlug + "/projects")) } class="mt-6 space-y-5" novalidate>
			{{ projectNameField := FieldProps{ID: "project-name", Label: d.Tr("common.name")} }}
			@FormField(projectNameField) {
				<input { projectNameField.Attrs()... } name="name" type="text" dir="auto" required autofocus value={ v.Name } placeholder={ d.Tr("project_new.name_placeholder") } class="input w-full"/>
			}
			{{ slug := FieldProps{ID: "project-slug", Label: d.Tr("common.slug"), Hint: d.Tr("common.slug_hint")} }}
			@FormField(slug) {
				<input name="slug" type="text" value={ v.Slug } placeholder={ d.Tr("project_new.slug_placeholder") } pattern="[a-z0-9-]+" dir="ltr" class="input w-full font-mono" { slug.Attrs()... }/>
			}
			<div class="flex items-center gap-3 pt-2">
				if v.Blocked {
					<button type="submit" class="btn btn-primary" disabled data-limit-blocked>{ d.Tr("nav.create_project") }</button>
				} else {
					<button type="submit" class="btn btn-primary">{ d.Tr("nav.create_project") }</button>
				}
				<a href={ templ.SafeURL(d.OrgPath("/projects")) } class="btn btn-ghost">{ d.Tr("common.cancel") }</a>
			</div>
		</form>
	</section>
}

templ ProjectNewLayout(d web.LayoutData, v ProjectNewView) {
	@Layout(web.WithContent(d, ProjectNewPage(d, v)))
}
