package templates

import (
	"strconv"

	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
)

// SettingsView is the project ledger settings page model.
type SettingsView struct {
	OrgSlug        string
	ProjectSlug    string
	ProjectName    string
	Timezone       string
	Timezones      []string
	Currency       string
	Currencies     []string
	PeriodStartDay int
	Saved          bool
	Error          string
	ErrorCode      string
	MCPEndpoint    string
	MCPScopes      []string
}

// settingsTimezoneField is one control: the curated zones come from the datalist, anything else is typed in.
templ settingsTimezoneField(d web.LayoutData, v SettingsView) {
	<div>
		<label for="settings-timezone" class="block text-sm font-medium text-foreground">{ d.Tr("settings.timezone") }</label>
		<input
			id="settings-timezone"
			name="timezone"
			type="text"
			required
			autocapitalize="off"
			autocomplete="off"
			spellcheck="false"
			list="settings-timezone-options"
			placeholder="Asia/Jakarta"
			value={ v.Timezone }
			class="mt-1.5 block w-full rounded-md border border-border bg-card px-3 py-2 text-base text-foreground placeholder:text-muted-foreground/70 shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1 sm:text-sm"
		/>
		<datalist id="settings-timezone-options">
			for _, tz := range v.Timezones {
				<option value={ tz }></option>
			}
		</datalist>
	</div>
}

templ settingsMCPBlock(d web.LayoutData, v SettingsView) {
	<section class="mt-10 rounded-lg border border-border bg-card p-4 shadow-sm sm:p-6">
		<h2 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-muted-foreground">
			@icons.Icon("globe", "h-4 w-4")
			{ d.Tr("settings.mcp") }
		</h2>
		<p class="mt-2 text-sm text-muted-foreground">{ d.Tr("settings.mcp_hint") }</p>
		<dl class="mt-4 space-y-3">
			<div>
				<dt class="text-xs text-muted-foreground">{ d.Tr("settings.mcp_endpoint") }</dt>
				<dd class="mt-1 break-all">
					<code class="select-all font-mono text-sm text-foreground">{ v.MCPEndpoint }</code>
				</dd>
			</div>
		</dl>
		<p class="mt-3 flex flex-wrap gap-2">
			for _, s := range v.MCPScopes {
				<code class="select-all rounded bg-muted px-2 py-0.5 font-mono text-xs text-foreground">{ s }</code>
			}
		</p>
	</section>
}

templ SettingsPage(d web.LayoutData, v SettingsView) {
	<section>
		<header class="border-b border-border pb-4">
			<h1 class="text-2xl font-semibold text-foreground">{ d.Tr("settings.title") }</h1>
			<p class="mt-1 text-sm text-muted-foreground">{ v.ProjectName }</p>
		</header>
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		if v.Saved {
			<div class="mt-4 rounded-md border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800 dark:border-emerald-900/50 dark:bg-emerald-950/40 dark:text-emerald-200">
				{ d.Tr("settings.saved") }
			</div>
		}
		<form
			method="post"
			action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/settings")) }
			class="mt-6 max-w-xl space-y-6"
		>
			@settingsTimezoneField(d, v)
			<div>
				<label for="settings-currency" class="block text-sm font-medium text-foreground">{ d.Tr("settings.currency") }</label>
				<select
					id="settings-currency"
					name="currency"
					class="mt-1.5 block w-full rounded-md border border-border bg-card px-3 py-2 text-base text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1 sm:text-sm"
				>
					for _, c := range v.Currencies {
						<option value={ c } selected?={ c == v.Currency }>{ c }</option>
					}
				</select>
			</div>
			<div>
				<label for="settings-start-day" class="block text-sm font-medium text-foreground">{ d.Tr("settings.period_start_day") }</label>
				<input
					id="settings-start-day"
					name="period_start_day"
					type="number"
					inputmode="numeric"
					min="1"
					max="28"
					required
					value={ strconv.Itoa(v.PeriodStartDay) }
					class="mt-1.5 block w-full rounded-md border border-border bg-card px-3 py-2 text-base tabular-nums text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1 sm:max-w-32 sm:text-sm"
				/>
				<p class="mt-1.5 text-xs text-muted-foreground">{ d.Tr("settings.period_start_day_hint") }</p>
			</div>
			<button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 sm:w-auto">
				@icons.Icon("check", "h-4 w-4")
				{ d.Tr("settings.save") }
			</button>
		</form>
		if d.Caps.MCPEnabled {
			@settingsMCPBlock(d, v)
		}
	</section>
}

templ SettingsLayout(d web.LayoutData, v SettingsView) {
	@Layout(web.WithContent(d, SettingsPage(d, v)))
}
