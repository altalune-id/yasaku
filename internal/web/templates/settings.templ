package templates

import (
	"fmt"
	"slices"
	"strconv"
	"time"

	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
	"altalune.id/yasaku/money"
)

// SettingsView is the project settings page model.
type SettingsView struct {
	OrgSlug        string
	OrgID          string
	ProjectSlug    string
	ProjectID      string
	ProjectName    string
	Name           string
	NameError      string
	NameSaved      bool
	CanRename      bool
	CanManage      bool
	System         bool
	Timezone       string
	Timezones      []string
	Currency       string
	Currencies     []string
	PeriodStartDay int
	StartDays      []int
	Saved          bool
	Error          string
	ErrorCode      string
	MCPEndpoint    string
	MCPScopes      []string
}

templ settingsGeneral(d web.LayoutData, v SettingsView) {
	if v.CanRename {
		<form method="post" action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/rename")) } novalidate data-dirty-form data-dirty-start?={ v.NameError != "" }>
			@FormSection(d.Tr("settings.general")) {
				@settingsGeneralFields(d, v)
				@settingsActions(d, d.Tr("settings.save_name"))
			}
		</form>
	} else {
		@FormSection(d.Tr("settings.general")) {
			@settingsGeneralFields(d, v)
		}
	}
}

func settingsNameField(d web.LayoutData, v SettingsView) FieldProps {
	p := FieldProps{ID: "settings-name", Label: d.Tr("settings.name"), Hint: d.Tr("settings.name_hint")}
	switch {
	case v.NameError != "":
		p.Error = d.Tr(v.NameError)
	case v.System:
		p.Hint, p.HintIcon = d.Tr("settings.name_locked"), "lock"
	case !v.CanRename:
		p.Hint, p.HintIcon = d.Tr("settings.name_member"), "lock"
	}
	return p
}

templ settingsGeneralFields(d web.LayoutData, v SettingsView) {
	{{ name := settingsNameField(d, v) }}
	@FormField(name) {
		<input
			name="name"
			dir="auto"
			type="text"
			value={ v.Name }
			maxlength="200"
			autocomplete="off"
			required
			readonly?={ !v.CanRename }
			class={ "input w-full text-base", templ.KV("input-error", name.Error != "") }
			{ name.Attrs()... }
		/>
	}
	@settingsCopyField(d, FieldProps{ID: "settings-project-id", Label: d.Tr("settings.project_id"), Hint: d.Tr("settings.project_id_hint")}, v.ProjectSlug)
}

templ settingsAdvanced(d web.LayoutData, v SettingsView) {
	@AppCollapse("", "border border-base-300 bg-base-100", textTitle(d.Tr("settings.advanced"))) {
		<div class="grid min-w-0 gap-3">
			@settingsCopyField(d, FieldProps{ID: "settings-project-uuid", Label: d.Tr("settings.project_uuid")}, v.ProjectID)
			@settingsCopyField(d, FieldProps{ID: "settings-org-uuid", Label: d.Tr("settings.org_uuid")}, v.OrgID)
		</div>
	}
}

templ settingsCopyField(d web.LayoutData, p FieldProps, value string) {
	@FormField(p) {
		<div class="join w-full">
			<input
				class="input join-item min-w-0 flex-1 font-mono text-sm"
				value={ value }
				dir="ltr"
				readonly
				{ p.Attrs()... }
			/>
			<button
				type="button"
				class="btn join-item"
				data-copy={ value }
				data-copy-text={ d.Tr("common.copy") }
				data-copy-label={ d.Tr("common.copy") + ": " + p.Label }
				data-copied-label={ d.Tr("common.copied") }
				aria-label={ d.Tr("common.copy") + ": " + p.Label }
			>
				@icons.Icon("copy", "size-4")
				<span class="inline-grid">
					<span data-copy-slot class="col-start-1 row-start-1">{ d.Tr("common.copy") }</span>
					<span aria-hidden="true" class="invisible col-start-1 row-start-1">{ d.Tr("common.copied") }</span>
				</span>
			</button>
		</div>
	}
}

templ settingsActions(d web.LayoutData, saveLabel string) {
	<div class="flex flex-wrap items-center justify-end gap-2">
		<span data-dirty-only hidden class="me-auto text-sm text-base-content/70">{ d.Tr("settings.unsaved") }</span>
		<button type="button" data-dirty-cancel hidden class="btn btn-ghost">{ d.Tr("common.cancel") }</button>
		<button type="submit" data-dirty-submit class="btn btn-primary">
			<span data-dirty-saving hidden class="loading loading-spinner loading-sm" aria-hidden="true"></span>
			<span data-dirty-label>{ saveLabel }</span>
			<span data-dirty-saving hidden>{ d.Tr("settings.saving") }</span>
		</button>
	</div>
}

func settingsTimezoneLabel(tz string) string {
	loc, err := time.LoadLocation(tz)
	if err != nil {
		return tz
	}
	abbr, offset := time.Now().In(loc).Zone()
	if abbr == tz {
		return tz
	}
	utc := "UTC"
	if offset != 0 {
		sign := "+"
		if offset < 0 {
			sign, offset = "-", -offset
		}
		utc += sign + strconv.Itoa(offset/3600)
		if m := offset % 3600 / 60; m != 0 {
			utc += fmt.Sprintf(":%02d", m)
		}
	}
	if abbr == "" || abbr[0] == '+' || abbr[0] == '-' {
		return tz + " (" + utc + ")"
	}
	return tz + " (" + abbr + ", " + utc + ")"
}

func settingsTimezoneOptions(v SettingsView) []string {
	if v.Timezone == "" || slices.Contains(v.Timezones, v.Timezone) {
		return v.Timezones
	}
	return append([]string{v.Timezone}, v.Timezones...)
}

templ settingsLedger(d web.LayoutData, v SettingsView) {
	{{ startDay := FieldProps{ID: "settings-start-day", Label: d.Tr("settings.period_start_day"), Hint: d.Tr("settings.period_start_day_hint")} }}
	<form method="post" action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/settings")) } data-dirty-form data-dirty-start?={ v.Error != "" }>
		@FormSection(d.Tr("settings.money")) {
			{{ settingsCurrencyField := FieldProps{ID: "settings-currency", Label: d.Tr("settings.currency")} }}
			@FormField(settingsCurrencyField) {
				<select { settingsCurrencyField.Attrs()... } name="currency" disabled?={ !v.CanManage } class="select w-full text-base">
					for _, c := range v.Currencies {
						<option value={ c } selected?={ c == v.Currency }>{ CurrencyLabel(d.Tr, money.Currency(c)) }</option>
					}
				</select>
			}
			{{ settingsTimezoneField := FieldProps{ID: "settings-timezone", Label: d.Tr("settings.timezone")} }}
			@FormField(settingsTimezoneField) {
				<select { settingsTimezoneField.Attrs()... } name="timezone" required disabled?={ !v.CanManage } class="select w-full text-base">
					for _, tz := range settingsTimezoneOptions(v) {
						<option value={ tz } selected?={ tz == v.Timezone }>{ settingsTimezoneLabel(tz) }</option>
					}
				</select>
			}
			@FormField(startDay) {
				<select { startDay.Attrs()... } name="period_start_day" required disabled?={ !v.CanManage } class="select w-full text-base">
					for _, day := range v.StartDays {
						<option value={ strconv.Itoa(day) } selected?={ day == v.PeriodStartDay }>{ d.Tr("settings.day_n", "Day", day) }</option>
					}
				</select>
			}
			if v.CanManage {
				@settingsActions(d, d.Tr("settings.save"))
			} else {
				<p class="flex items-center gap-2 text-sm text-base-content/70">
					@icons.Icon("lock", "size-4 shrink-0")
					<span>{ d.Tr("settings.ledger_member") }</span>
				</p>
			}
		}
	</form>
}

templ settingsMCPBlock(d web.LayoutData, v SettingsView) {
	<section class="flex min-w-0 flex-col gap-3 rounded-box border border-base-300 p-4" aria-labelledby="settings-mcp-title">
		<h2 id="settings-mcp-title" class="flex items-center gap-2 text-base font-semibold">
			@icons.Icon("globe", "size-4")
			{ d.Tr("settings.mcp") }
		</h2>
		<p class="text-sm text-base-content/70">{ d.Tr("settings.mcp_hint") }</p>
		<p class="text-xs text-base-content/70">{ d.Tr("settings.mcp_endpoint") }</p>
		<code class="select-all break-all font-mono text-sm">{ v.MCPEndpoint }</code>
		<p class="flex flex-wrap gap-2">
			for _, s := range v.MCPScopes {
				<code class="badge badge-ghost select-all font-mono">{ s }</code>
			}
		</p>
	</section>
}

templ SettingsPage(d web.LayoutData, v SettingsView) {
	<section class="flex flex-col gap-4 lg:gap-6">
		@PageHeader(d.Tr("settings.title"), "")
		<div class="flex max-w-xl flex-col gap-4 lg:gap-6 [&>[role=alert]]:mt-0">
			if v.Error != "" {
				@ErrorBanner(d, v.Error, v.ErrorCode)
			}
			if v.NameSaved {
				<div role="status" class="alert alert-soft alert-success">
					@icons.Icon("check", "size-4")
					<span>{ d.Tr("settings.name_saved") }</span>
				</div>
			}
			if v.Saved {
				<div role="status" class="alert alert-soft alert-success">
					@icons.Icon("check", "size-4")
					<span>{ d.Tr("settings.saved") }</span>
				</div>
			}
			@settingsGeneral(d, v)
			@settingsLedger(d, v)
			@settingsAdvanced(d, v)
			if d.Caps.MCPEnabled {
				@settingsMCPBlock(d, v)
			}
		</div>
	</section>
}

templ SettingsLayout(d web.LayoutData, v SettingsView) {
	@Layout(web.WithContent(d, SettingsPage(d, v)))
}
