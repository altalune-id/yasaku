package templates

import (
	"time"

	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
)

// TxFilter is one option in a filter select on the transactions page.
type TxFilter struct {
	Value    string
	Label    string
	Selected bool
}

// TxListView is the swappable transactions region: rows plus the cursor that loads the next page.
type TxListView struct {
	ProjectSlug string
	Rows        []TxRow
	NextQuery   string
	Error       string
	ErrorCode   string
	Compact     bool
}

// TransactionsView is the full transactions page: the add-transaction dialog, the filter bar and the list.
type TransactionsView struct {
	ProjectSlug string
	ProjectName string
	Form        TxFormView
	List        TxListView
	Search      string
	Wallets     []TxFilter
	Kinds       []TxFilter
	Categories  []TxFilter
	Periods     []TxFilter
	Toast       *TxToastView
}

// TxToastView is the toast a sheet save or a delete leaves for the next page; with Undo it carries the deleted entry's fields to record it again.
type TxToastView struct {
	ProjectSlug string
	Message     string
	Undo        bool
	Return      string
	Kind        string
	Amount      string
	WalletID    string
	ToWalletID  string
	CategoryID  string
	Date        string
	Note        string
}

// TxDetailView is one entry's detail; Return is the allowlisted page a delete goes back to, and PastDay labels Duplicate as "to today".
type TxDetailView struct {
	ProjectSlug string
	Row         TxRow
	RecordedAt  time.Time
	UpdatedAt   time.Time
	Locked      bool
	PastDay     bool
	Return      string
}

// TxAddDialogID is the add sheet's dialog id; any [data-dialog-open] opener with this id opens the sheet, and its href is the no-JS page.
const TxAddDialogID = "tx-add-dialog"

// TransactionList is the HTMX swap target every quick-add and filter request replaces.
templ TransactionList(d web.LayoutData, v TxListView) {
	<div id="tx-list" class="overflow-x-clip rounded-box border border-base-300 bg-base-100">
		if v.Error != "" {
			<div data-tx-error="1" class="px-4 pb-1 pt-3">
				@ErrorBanner(d, v.Error, v.ErrorCode)
			</div>
		}
		if len(v.Rows) == 0 {
			<p class="px-4 py-10 text-center text-sm text-base-content/70">{ d.Tr("tx.empty") }</p>
		}
		@TxRowsPage(d, v)
	</div>
}

// TxRowsPage is one page of rows plus its load-more button; the button swaps itself for the next page.
templ TxRowsPage(d web.LayoutData, v TxListView) {
	for _, row := range v.Rows {
		@TxRowItem(d, v.ProjectSlug, row)
	}
	if v.NextQuery != "" {
		<button
			type="button"
			hx-get={ d.ProjectPath(v.ProjectSlug, "/transactions") + v.NextQuery }
			hx-nonce={ d.Nonce }
			hx-target="this"
			hx-swap="outerHTML"
			hx-status:4xx="target:#hx-error swap:innerHTML"
			hx-status:5xx="target:#hx-error swap:innerHTML"
			class="btn btn-ghost btn-block rounded-none border-t border-base-300"
		>
			{ d.Tr("tx.load_more") }
		</button>
	}
}

templ TransactionsPage(d web.LayoutData, v TransactionsView) {
	<section class="flex flex-col gap-4">
		@PageHeader(d.Tr("tx.title"), v.ProjectName) {
			@AppButton(d.ProjectPath(v.ProjectSlug, "/transactions/new"), "btn-primary", templ.Attributes{"data-dialog-open": TxAddDialogID, "data-dialog-src": d.ProjectPath(v.ProjectSlug, "/transactions/new")}) {
				@icons.Icon("plus", "size-4")
				{ d.Tr("tx.add") }
			}
		}
		<form
			id="tx-filters"
			method="get"
			action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/transactions")) }
			hx-get={ d.ProjectPath(v.ProjectSlug, "/transactions") }
			hx-nonce={ d.Nonce }
			hx-target="#tx-list"
			hx-swap="outerHTML"
			hx-trigger="change, search, submit"
			hx-status:4xx="target:#hx-error swap:innerHTML"
			hx-status:5xx="target:#hx-error swap:innerHTML"
			class="grid grid-cols-2 gap-2 sm:grid-cols-5"
		>
			<input
				type="search"
				name="q"
				value={ v.Search }
				placeholder={ d.Tr("tx.search") }
				aria-label={ d.Tr("tx.search") }
				class="input w-full col-span-2 sm:col-span-1"
			/>
			@txFilterSelect(d, "period", d.Tr("tx.period"), v.Periods)
			@txFilterSelect(d, "wallet", d.Tr("tx.wallet"), v.Wallets)
			@txFilterSelect(d, "kind", d.Tr("tx.kind"), v.Kinds)
			@txFilterSelect(d, "category", d.Tr("tx.category"), v.Categories)
		</form>
		@TransactionList(d, v.List)
		@TxRowAssets(d)
		@TxToastHost(d, v.Toast)
	</section>
}

// TxToastHost is the ToastHost with the toast a sheet save or delete left, if any; render it in place of ToastHost on any page a sheet or delete returns to.
templ TxToastHost(d web.LayoutData, u *TxToastView) {
	if u == nil {
		@ToastHost()
	} else {
		<div id="toast" class="toast toast-center toast-bottom z-50 max-lg:mb-20">
			@txToastAlert(d, *u)
		</div>
	}
	<script src={ d.Static("undo.js") } nonce={ d.Nonce } defer></script>
}

templ txToastAlert(d web.LayoutData, u TxToastView) {
	if !u.Undo {
		<p role="status" class="alert alert-info" data-undo-toast data-undo-ms="5000">{ u.Message }</p>
	} else {
		@txUndoAlert(d, u)
	}
}

templ txUndoAlert(d web.LayoutData, u TxToastView) {
	<div role="status" class="alert" data-undo-toast data-undo-ms="8000">
		@icons.Icon("trash-2", "size-5 shrink-0")
		<span class="min-w-0">{ u.Message }</span>
		<form method="post" action={ templ.SafeURL(d.ProjectPath(u.ProjectSlug, "/transactions")) }>
			<input type="hidden" name="kind" value={ u.Kind }/>
			<input type="hidden" name="amount" value={ u.Amount }/>
			<input type="hidden" name="wallet_id" value={ u.WalletID }/>
			if u.ToWalletID != "" {
				<input type="hidden" name="to_wallet_id" value={ u.ToWalletID }/>
			}
			if u.CategoryID != "" {
				<input type="hidden" name="category_id" value={ u.CategoryID }/>
			}
			<input type="hidden" name="date" value={ u.Date }/>
			<input type="hidden" name="note" value={ u.Note }/>
			<input type="hidden" name="return" value={ u.Return }/>
			<button type="submit" class="btn btn-sm max-lg:btn-md">{ d.Tr("tx.undo") }</button>
		</form>
	</div>
}

templ txFilterSelect(d web.LayoutData, name, label string, opts []TxFilter) {
	<select name={ name } aria-label={ label } class="select w-full">
		<option value="">{ label + " · " + d.Tr("tx.filter_all") }</option>
		for _, o := range opts {
			<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
		}
	</select>
}

templ TransactionsLayout(d web.LayoutData, v TransactionsView) {
	@Layout(web.WithDialogs(web.WithContent(d, TransactionsPage(d, v)), txPageDialogs(d, v)))
}

templ txPageDialogs(d web.LayoutData, v TransactionsView) {
	@TxSheet(d, v.Form)
	@TxRowActions(d)
}

// TxSheet is the add sheet in the dialog host; render it through LayoutData.Dialogs on any page whose openers target TxAddDialogID.
templ TxSheet(d web.LayoutData, v TxFormView) {
	@AppSheet(TxAddDialogID, d.Tr("tx.add"), "sm:max-w-md lg:max-w-3xl") {
		@TransactionForm(d, txInDialog(v))
	}
}

templ TransactionFormPage(d web.LayoutData, v TxFormView, title string) {
	<section class="mx-auto flex w-full max-w-4xl flex-col gap-4">
		@PageHeader(title, "")
		<div class="rounded-box border border-base-300 bg-base-100">
			@TransactionForm(d, txStandalone(v))
		</div>
		if !v.RecordedAt.IsZero() {
			<p class="text-center text-xs text-base-content/70">
				{ d.Tr("tx.recorded_label") }
				@DateTime(d, v.RecordedAt)
				if v.UpdatedAt.After(v.RecordedAt) {
					{ " · " + d.Tr("tx.updated_label") }
					@DateTime(d, v.UpdatedAt)
				}
			</p>
		}
		if v.ID != "" {
			<form method="post" action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/transactions/"+v.ID+"/delete")) }>
				<button type="submit" class="btn btn-ghost btn-block text-error">
					@icons.Icon("trash-2", "size-4")
					{ d.Tr("tx.delete") }
				</button>
			</form>
		}
		@AppButton(d.ProjectPath(v.ProjectSlug, "/transactions"), "btn-ghost self-center", nil) {
			{ d.Tr("tx.title") }
		}
		@ToastHost()
	</section>
}

templ TransactionDetailPage(d web.LayoutData, v TxDetailView) {
	<section class="mx-auto flex w-full max-w-md flex-col gap-4">
		@PageHeader(d.Tr("tx.detail"), "")
		<div class="rounded-box border border-base-300 bg-base-100 p-4 sm:p-6">
			@txDetailBody(d, v)
			<p class="mt-4 text-center text-xs text-base-content/70">
				{ d.Tr("tx.recorded_label") }
				@DateTime(d, v.RecordedAt)
				if v.UpdatedAt.After(v.RecordedAt) {
					{ " · " + d.Tr("tx.updated_label") }
					@DateTime(d, v.UpdatedAt)
				}
			</p>
		</div>
		@AppButton(d.ProjectPath(v.ProjectSlug, "/transactions"), "btn-ghost self-center", nil) {
			{ d.Tr("tx.title") }
		}
	</section>
}

// TxDetailDrawer is one entry's detail as the end-side drawer the list rows load into the dialog host.
templ TxDetailDrawer(d web.LayoutData, v TxDetailView) {
	@AppDrawer(d, TxDetailDialogID(v.Row.ID), d.Tr("tx.detail")) {
		@txDetailBody(d, v)
	}
}

templ txDetailBody(d web.LayoutData, v TxDetailView) {
	<div class="flex min-w-0 items-center gap-3">
		<span class="grid size-12 shrink-0 place-items-center rounded-full bg-base-200 text-primary">
			@icons.Icon(txRowIcon(v.Row), "size-6")
		</span>
		<div class="min-w-0">
			<p class="truncate text-lg font-semibold">{ txRowTitle(d, v.Row) }</p>
			<p class="text-sm text-base-content/70">{ v.Row.KindLabel }</p>
		</div>
	</div>
	<p class={ "my-4 min-w-0 text-3xl font-extrabold tabular-nums break-words", txAmountClass(v.Row) }>{ SignedMoney(d, txSignedAmount(v.Row)) }</p>
	@KeyValue(d, KeyValueProps{Dense: true, Items: txDetailItems(d, v.Row)})
	if v.Locked {
		<div role="status" class="alert alert-soft alert-info mt-4 text-sm">
			@icons.Icon("lock", "size-5 shrink-0")
			<span>{ d.Tr("tx.locked") }</span>
		</div>
	}
	<div class="mt-6 grid grid-cols-1 gap-2">
		if v.Locked {
			<button type="button" class="btn btn-primary" disabled>
				@icons.Icon("pencil", "size-4")
				{ d.Tr("tx.edit_action") }
			</button>
		} else {
			@AppButton(d.ProjectPath(v.ProjectSlug, "/transactions/"+v.Row.ID+"/edit"), "btn-primary", nil) {
				@icons.Icon("pencil", "size-4")
				{ d.Tr("tx.edit_action") }
			}
		}
		<div class="grid grid-cols-2 gap-2">
			@AppButton(d.ProjectPath(v.ProjectSlug, "/transactions/new?from="+v.Row.ID), "", nil) {
				@icons.Icon("copy", "size-4")
				if v.PastDay {
					{ d.Tr("tx.duplicate_today") }
				} else {
					{ d.Tr("tx.duplicate") }
				}
			}
			<form method="post" action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/transactions/"+v.Row.ID+"/delete")) } class="grid">
				if v.Return != "" {
					<input type="hidden" name="return" value={ v.Return }/>
				}
				<button type="submit" class="btn btn-ghost text-error" disabled?={ v.Locked }>
					@icons.Icon("trash-2", "size-4")
					{ d.Tr("tx.delete") }
				</button>
			</form>
		</div>
	</div>
}

templ TransactionDetailLayout(d web.LayoutData, v TxDetailView) {
	@Layout(web.WithContent(d, TransactionDetailPage(d, v)))
}

func txDetailItems(d web.LayoutData, row TxRow) []KeyValueItem {
	items := []KeyValueItem{
		{Label: d.Tr("tx.category"), Value: row.CategoryName},
		{Label: d.Tr("tx.wallet"), Value: row.WalletName},
	}
	if row.Kind == "transfer" {
		items = []KeyValueItem{
			{Label: d.Tr("tx.from_wallet"), Value: row.WalletName},
			{Label: d.Tr("tx.to_wallet"), Value: row.ToWalletName},
		}
	}
	note := row.Note
	if note == "" {
		note = d.Tr("tx.note_none")
	}
	return append(items,
		KeyValueItem{Label: d.Tr("tx.date"), Node: LedgerDate(d, row.Day, &row.OccurredAt, Long())},
		KeyValueItem{Label: d.Tr("tx.note"), Value: note},
	)
}

templ TransactionFormLayout(d web.LayoutData, v TxFormView, title string) {
	@Layout(web.WithContent(d, TransactionFormPage(d, v, title)))
}

func txStandalone(v TxFormView) TxFormView {
	v.FullPage = true
	return v
}

func txInDialog(v TxFormView) TxFormView {
	v.InDialog = true
	return v
}
