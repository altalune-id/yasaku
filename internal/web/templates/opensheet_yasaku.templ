package templates

import (
	"context"
	"io"
	"slices"
	"strconv"
	"strings"
	"time"

	"altalune.id/yasaku/civil"
	"altalune.id/yasaku/internal/opensheetsync"
	"altalune.id/yasaku/internal/web"
	"altalune.id/yasaku/internal/web/icons"
)

// OpensheetTab is one contract tab as the tutorial shows it.
type OpensheetTab struct {
	LabelKey  string
	Slug      string
	Columns   []string
	HeaderTSV string
}

// OpensheetForm is the connection form's values; the API key is write-only and never rendered back.
type OpensheetForm struct {
	OSOrg             string
	OSProject         string
	TransactionsSheet string
	WalletsSheet      string
	CategoriesSheet   string
}

// OpensheetCheck is one tab's Test result.
type OpensheetCheck struct {
	LabelKey    string
	Sheet       string
	OK          bool
	Reachable   bool
	Unavailable bool
	// PrivateEndpoint marks a base URL that resolves to a private address while the server refuses private hosts.
	PrivateEndpoint bool
	IDColumn        bool
	Writable        bool
	Missing         string
	// MissingDeletedAt flags the one column people leave out: opensheet needs it to record a deletion.
	MissingDeletedAt bool
	// ColumnsDeferred marks a tab opensheet showed no columns for; the first sync checks them.
	ColumnsDeferred bool
	ContractReason  string
	Code            string
}

// OpensheetView is the Opensheet module page.
type OpensheetView struct {
	ProjectSlug  string
	CanManage    bool
	Linked       bool
	Enabled      bool
	Verified     bool
	AutoDisabled bool
	// AwaitingFirstSync is set until a sync lands after the last Save.
	AwaitingFirstSync bool
	LastSyncedAt      *time.Time
	LastError         string
	Pending           int64
	Failing           int64
	GivenUp           int64
	KeyHint           string
	Form              OpensheetForm
	Tabs              []OpensheetTab
	Checks            []OpensheetCheck
	NoticeKey         string
	ErrorKey          string
	ErrorMsg          string
	ErrorCode         string
	// State is one of off, paused, off_manual, failing, given_up, first, pending, ok; the headline key is opensheet.state.<State>.
	State          OpensheetState
	Streak         int
	ReasonKey      string
	SyncErrorCode  string
	AutoDisabledAt *time.Time
	VerifiedAt     *time.Time
	NextRetryAt    *time.Time
	Rows           []OpensheetRowError
	RowsMore       int
	// CanConnect is set when opensheet.audience is, so the page leads with Connect and keeps the API-key setup behind a collapse.
	CanConnect   bool
	OpensheetURL string
	// Access is how the project's grant stands: "", pending, ok, reconnect or member_left (opensheetsync.Access).
	Access          string
	ConnectKey      string
	ConnectCode     string
	// Setup names the step missing in opensheet before a pick: "", no_account or no_google.
	Setup        string
	SetupProject string
	SetupURL     string
	PickTargets  []OpensheetChoice
	SheetTitle   string
	SheetURL     string
	// GrantLink marks a link that uses the OAuth grant; its API-key settings stay hidden until Disconnect.
	GrantLink bool
}

// OpensheetChoice is one option of the picker.
type OpensheetChoice struct {
	ID    string
	Label string
}

func (v OpensheetView) picking() bool { return v.Access == "pending" && v.CanManage }

func (v OpensheetView) connectCard() bool { return v.CanConnect && !v.picking() && !v.Linked }

func (v OpensheetView) grantLost() bool { return v.Access == "reconnect" || v.Access == "member_left" }

// OpensheetRowError is one entry the mirror could not copy.
type OpensheetRowError struct {
	EntityKey   string
	Label       string
	OccurredOn  *civil.Date
	Attempts    int
	GivenUp     bool
	ReasonKey   string
	LastError   string
	NextRetryAt *time.Time
}

// SyncErrorInChecks reports whether the Test results repeat the last sync refusal: only next to a failing tab or one whose columns the Test could not see.
func (v OpensheetView) SyncErrorInChecks() bool {
	if v.LastError == "" {
		return false
	}
	return slices.ContainsFunc(v.Checks, func(c OpensheetCheck) bool { return !c.OK || c.ColumnsDeferred })
}

// CanEnable reports whether the switch may be turned on now.
func (v OpensheetView) CanEnable() bool { return v.CanManage && (v.Enabled || v.Verified) }

// OpensheetRemoveDialogID is the Remove confirmation dialog.
const OpensheetRemoveDialogID = "opensheet-remove"

const opensheetTimeMark = "\uE002"

func opensheetTimeParts(text string) (string, string, bool) {
	before, after, ok := strings.Cut(text, opensheetTimeMark)
	return before, after, ok
}

func (v OpensheetView) syncWord(d web.LayoutData) string {
	switch {
	case v.State == OpensheetPaused:
		return d.Tr("opensheet.sync_state.paused")
	case v.Enabled:
		return d.Tr("opensheet.sync_state.on")
	}
	return d.Tr("opensheet.sync_state.off")
}

func (v OpensheetView) statusDot() string {
	switch v.State {
	case OpensheetPaused:
		return "status-error"
	case OpensheetOffManual:
		return "status-neutral"
	case OpensheetFailing, OpensheetGivenUp:
		return "status-warning"
	case OpensheetFirst, OpensheetPending:
		return "status-info"
	}
	return "status-success"
}

func (v OpensheetView) rowsOpen() bool { return v.State == OpensheetFailing || v.State == OpensheetPaused }

func (v OpensheetView) rowCount() int { return len(v.Rows) + v.RowsMore }

func opensheetTimed(d web.LayoutData, text string, t *time.Time) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		before, after, ok := opensheetTimeParts(text)
		if !ok || t == nil {
			_, err := io.WriteString(w, templ.EscapeString(text))
			return err
		}
		if _, err := io.WriteString(w, templ.EscapeString(before)); err != nil {
			return err
		}
		if err := DateTime(d, *t).Render(ctx, w); err != nil {
			return err
		}
		_, err := io.WriteString(w, templ.EscapeString(after))
		return err
	})
}

templ OpensheetLayout(d web.LayoutData, v OpensheetView) {
	if v.Linked && v.CanManage {
		@Layout(web.WithDialogs(web.WithContent(d, OpensheetPage(d, v)), opensheetRemoveDialog(d, v)))
	} else {
		@Layout(web.WithContent(d, OpensheetPage(d, v)))
	}
}

templ opensheetRemoveDialog(d web.LayoutData, v OpensheetView) {
	@ConfirmModal(d, ConfirmModalProps{
		ID:           OpensheetRemoveDialogID,
		Title:        d.Tr("opensheet.remove"),
		Body:         d.Tr("opensheet.remove_confirm"),
		Action:       d.ProjectPath(v.ProjectSlug, "/opensheet/delete"),
		ConfirmLabel: d.Tr("opensheet.remove"),
		Attrs: templ.Attributes{
			"hx-post":       d.ProjectPath(v.ProjectSlug, "/opensheet/delete"),
			"hx-nonce":      d.Nonce,
			"hx-target":     "#opensheet-module",
			"hx-swap":       "outerHTML",
			"hx-disable":    "find button",
			"hx-status:4xx": "target:#hx-error swap:innerHTML",
			"hx-status:5xx": "target:#hx-error swap:innerHTML",
		},
	})
}

templ OpensheetPage(d web.LayoutData, v OpensheetView) {
	<section class="flex max-w-2xl flex-col gap-4 lg:gap-6">
		if v.CanConnect {
			@PageHeader(d.Tr("opensheet.connect.heading"), d.Tr("opensheet.connect.subtitle"))
		} else {
			@PageHeader(d.Tr("nav.opensheet"), d.Tr("opensheet.subtitle"))
		}
		@OpensheetModule(d, v)
	</section>
}

// OpensheetModule is the swappable module body: every successful action replaces #opensheet-module.
templ OpensheetModule(d web.LayoutData, v OpensheetView) {
	<div id="opensheet-module" class="flex flex-col gap-4 lg:gap-6">
		if !v.connectCard() {
			@opensheetConnectBanner(d, v)
		}
		if v.picking() && v.Setup != "" {
			@opensheetSetupNeeded(d, v)
		} else if v.picking() {
			@opensheetPicker(d, v)
		} else if v.Linked {
			@OpensheetStatus(d, v)
		} else if v.CanConnect {
			@opensheetConnect(d, v)
		} else {
			<section aria-labelledby="gs-setup-h" class="card min-w-0 border border-base-300 bg-base-100">
				<div class="card-body gap-3 p-4">
					<h2 id="gs-setup-h" class="font-semibold">{ d.Tr("opensheet.manual_title") }</h2>
					@opensheetSetup(d, v)
				</div>
			</section>
		}
		if !v.CanConnect {
			@opensheetSoon(d)
		}
	</div>
}

templ opensheetAction(d web.LayoutData, v OpensheetView, path string) {
	<form
		method="post"
		action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, path)) }
		hx-post={ d.ProjectPath(v.ProjectSlug, path) }
		hx-nonce={ d.Nonce }
		hx-target="#opensheet-module"
		hx-swap="outerHTML"
		hx-disable="find button"
		hx-status:422="target:#opensheet-status swap:outerHTML"
		hx-status:4xx="target:#hx-error swap:innerHTML"
		hx-status:5xx="target:#hx-error swap:innerHTML"
		class="contents"
	>
		{ children... }
	</form>
}

templ opensheetToggle(d web.LayoutData, v OpensheetView) {
	<form
		method="post"
		action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/opensheet/enabled")) }
		hx-post={ d.ProjectPath(v.ProjectSlug, "/opensheet/enabled") }
		hx-nonce={ d.Nonce }
		hx-trigger="change"
		hx-target="#opensheet-module"
		hx-swap="outerHTML"
		hx-status:422="target:#opensheet-status swap:outerHTML"
		hx-status:4xx="target:#hx-error swap:innerHTML"
		hx-status:5xx="target:#hx-error swap:innerHTML"
		class="flex items-center gap-2"
	>
		<label class="label min-h-11 cursor-pointer gap-2 text-sm text-base-content">
			<span>{ d.Tr("opensheet.sync_toggle") }</span>
			<input
				type="checkbox"
				name="enabled"
				value="true"
				checked?={ v.Enabled }
				disabled?={ !v.CanEnable() }
				data-opensheet-enabled={ strconv.FormatBool(v.Enabled) }
				aria-label={ d.Tr("opensheet.sync_toggle") }
				class="toggle toggle-primary"
			/>
			<span class="text-base-content/70">{ v.syncWord(d) }</span>
		</label>
		<input type="hidden" name="enabled" value="false"/>
		<noscript><button type="submit" class="btn btn-sm">{ d.Tr("opensheet.save") }</button></noscript>
	</form>
}

templ opensheetDetails(d web.LayoutData, raw string) {
	if raw != "" {
		<p class="text-xs" data-opensheet-status-last-error="true">
			{ d.Tr("opensheet.details") + ": " }
			<code dir="ltr" class="font-mono break-all">{ raw }</code>
		</p>
	}
}

templ opensheetReason(d web.LayoutData, v OpensheetView) {
	if v.ReasonKey != "" {
		<p>{ d.Tr(v.ReasonKey) }</p>
	}
}

templ opensheetGivenUp(d web.LayoutData, v OpensheetView) {
	<div role="alert" data-opensheet-given-up={ strconv.FormatInt(v.GivenUp, 10) } class={ flashClass("warn") + " items-start text-sm" }>
		@icons.Icon("info", "size-5 shrink-0")
		<p class="min-w-0">{ d.TrN("opensheet.state.given_up_body", int(v.GivenUp), "Max", opensheetsync.MaxRowAttempts) }</p>
	</div>
}

templ opensheetBanner(d web.LayoutData, v OpensheetView) {
	switch v.State {
		case OpensheetPaused:
			<div role="alert" data-opensheet-auto-disabled="1" class="alert alert-soft alert-error items-start text-sm">
				@icons.Icon("circle-pause", "size-5 shrink-0")
				<div class="flex min-w-0 flex-col gap-1">
					<p class="font-semibold">
						@opensheetTimed(d, d.Tr("opensheet.state.paused_title", "Time", opensheetTimeMark, "Max", opensheetsync.DisableAfter), v.AutoDisabledAt)
					</p>
					@opensheetReason(d, v)
					if v.CanManage {
						<p>{ d.Tr("opensheet.state.paused_fix") }</p>
					} else {
						<p>{ d.Tr("opensheet.member_hint") }</p>
					}
					<p>{ d.Tr("opensheet.state.paused_no_retry") }</p>
					@opensheetDetails(d, v.LastError)
				</div>
			</div>
		case OpensheetOffManual:
			<div role="status" class="alert alert-soft alert-info items-start text-sm">
				@icons.Icon("circle-pause", "size-5 shrink-0")
				<p class="min-w-0">{ d.Tr("opensheet.state.off_manual_body") }</p>
			</div>
		case OpensheetFailing:
			<div role="alert" data-opensheet-failing={ strconv.FormatInt(v.Failing, 10) } class={ flashClass("warn") + " items-start text-sm" }>
				@icons.Icon("info", "size-5 shrink-0")
				<div class="flex min-w-0 flex-col gap-1">
					<p>{ d.Tr("opensheet.state.failing_body") }</p>
					@opensheetReason(d, v)
					if v.Streak > 0 {
						<p class="font-semibold" data-opensheet-streak={ strconv.Itoa(v.Streak) }>{ d.Tr("opensheet.state.streak", "Count", v.Streak, "Max", opensheetsync.DisableAfter) }</p>
					} else {
						<p>{ d.Tr("opensheet.state.rows_never_pause") }</p>
					}
					if v.NextRetryAt != nil {
						<p>
							@opensheetTimed(d, d.Tr("opensheet.state.next_retry", "Time", opensheetTimeMark, "Max", opensheetsync.MaxRowAttempts), v.NextRetryAt)
						</p>
					} else {
						<p>{ d.Tr("opensheet.state.retry_soon") }</p>
					}
					@opensheetDetails(d, v.LastError)
				</div>
			</div>
			if v.GivenUp > 0 {
				@opensheetGivenUp(d, v)
			}
		case OpensheetGivenUp:
			@opensheetGivenUp(d, v)
		case OpensheetFirst:
			<div role="status" data-opensheet-awaiting-first-sync="true" class="alert alert-soft alert-info items-start text-sm">
				@icons.Icon("hourglass", "size-5 shrink-0")
				<div class="flex min-w-0 flex-col gap-1">
					<p>{ d.Tr("opensheet.state.first_body") }</p>
					@opensheetReason(d, v)
					@opensheetDetails(d, v.LastError)
				</div>
			</div>
	}
}

templ opensheetFact(label string) {
	<div class="min-w-0">
		<dt class="text-xs text-base-content/70">{ label }</dt>
		<dd class="font-semibold tabular-nums">{ children... }</dd>
	</div>
}

templ opensheetRows(d web.LayoutData, v OpensheetView) {
	@AppCollapseOpen("gs-rows", "border border-base-300", v.rowsOpen(), textTitle(d.Tr("opensheet.failing_rows", "Count", v.rowCount()))) {
		<ul class="flex flex-col">
			for _, r := range v.Rows {
				<li data-opensheet-row={ r.EntityKey } class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 border-b border-base-300 py-2 text-sm last:border-b-0">
					<span class="min-w-0">
						<span class="font-medium break-words">{ d.Tr(r.EntityKey) }</span>
						if r.Label != "" {
							<span class="break-words">{ r.Label }</span>
						}
						if r.OccurredOn != nil {
							<span class="text-base-content/70">
								{ " " }
								@LedgerDate(d, *r.OccurredOn, nil, Compact())
							</span>
						}
					</span>
					if r.ReasonKey != "" {
						<span class="text-base-content/70">{ d.Tr(r.ReasonKey, "Max", opensheetsync.MaxRowAttempts) }</span>
					}
					if r.NextRetryAt != nil && !r.GivenUp {
						<span class="basis-full text-xs text-base-content/70">
							@opensheetTimed(d, d.Tr("opensheet.state.next_retry", "Time", opensheetTimeMark, "Max", opensheetsync.MaxRowAttempts), r.NextRetryAt)
						</span>
					}
					if r.LastError != "" {
						<span class="basis-full">
							@opensheetDetails(d, r.LastError)
						</span>
					}
				</li>
			}
		</ul>
		if v.State == OpensheetPaused {
			<p class="text-xs text-base-content/70">{ d.Tr("opensheet.state.paused_no_retry") }</p>
		}
	}
}

// OpensheetStatus is the linked card: state headline, the Sync switch, the state banner, facts, failing rows and the link actions.
templ OpensheetStatus(d web.LayoutData, v OpensheetView) {
	<section id="opensheet-status" aria-labelledby="gs-h" class="card min-w-0 border border-base-300 bg-base-100">
		<div class="card-body gap-3 p-4">
			<h2 id="gs-h" class="font-semibold">{ d.Tr("opensheet.manual_title") }</h2>
			@pageBanner(d, v.ErrorKey, v.ErrorMsg, v.ErrorCode)
			if v.NoticeKey != "" {
				<p role="status" data-opensheet-notice={ v.NoticeKey } class="alert alert-soft alert-success text-sm">{ d.Tr(v.NoticeKey) }</p>
			}
			<div class="flex flex-wrap items-center justify-between gap-3">
				<p role="status" data-opensheet-state={ v.State } class="flex items-center gap-2 text-sm">
					<span aria-hidden="true" class="inline-grid *:[grid-area:1/1]">
						if v.State == OpensheetFirst || v.State == OpensheetPending {
							<span class={ "status animate-ping motion-reduce:hidden", v.statusDot() }></span>
						}
						<span class={ "status", v.statusDot() }></span>
					</span>
					<span class="font-medium">{ d.Tr(v.headlineKey(), "Max", opensheetsync.DisableAfter) }</span>
				</p>
				if v.CanManage {
					@opensheetToggle(d, v)
				} else {
					<span class="text-sm">{ d.Tr("opensheet.sync_toggle") + ": " + v.syncWord(d) }</span>
				}
			</div>
			@opensheetReconnect(d, v)
			@opensheetBanner(d, v)
			<dl data-opensheet-pending={ strconv.FormatInt(v.Pending, 10) } class="grid grid-cols-2 gap-3 rounded-box bg-base-200 p-3 sm:grid-cols-4">
				@opensheetFact(d.Tr("opensheet.status.last_sync")) {
					if v.LastSyncedAt != nil {
						@DateTime(d, *v.LastSyncedAt)
					} else {
						{ d.Tr("opensheet.fact.not_yet") }
					}
				}
				@opensheetFact(d.Tr("opensheet.fact.pending")) {
					{ strconv.FormatInt(v.Pending, 10) }
				}
				@opensheetFact(d.Tr("opensheet.fact.failing")) {
					{ strconv.FormatInt(v.Failing, 10) }
				}
				@opensheetFact(d.Tr("opensheet.fact.given_up", "Max", opensheetsync.MaxRowAttempts)) {
					{ strconv.FormatInt(v.GivenUp, 10) }
				}
			</dl>
			if len(v.Rows) > 0 {
				@opensheetRows(d, v)
			}
			<div class="flex flex-col">
				if v.SheetTitle != "" {
					<p class="flex min-w-0 flex-wrap items-center gap-x-2 text-sm break-words" data-opensheet-linked-sheet="true">
						<span>{ d.Tr("opensheet.linked_sheet", "Title", v.SheetTitle) }</span>
						if v.SheetURL != "" {
							<a href={ templ.SafeURL(v.SheetURL) } target="_blank" rel="noopener" class="link link-primary">{ d.Tr("opensheet.open_sheet") }</a>
						}
					</p>
				} else {
					<p class="min-w-0 text-sm break-words">{ d.Tr("opensheet.connected_target", "Target", v.Form.OSOrg+" / "+v.Form.OSProject) }</p>
				}
				if v.KeyHint != "" {
					<p class="min-w-0 text-sm break-words">{ d.Tr("opensheet.key_ending", "Hint", v.KeyHint) }</p>
				}
			</div>
			if v.CanManage {
				<div class="flex flex-wrap gap-2">
					@opensheetAction(d, v, "/opensheet/sync") {
						<button type="submit" disabled?={ !v.Enabled } class="btn btn-primary">
							@icons.Icon("refresh-cw", "size-4")
							{ d.Tr("opensheet.sync_now") }
						</button>
					}
					<button type="button" data-dialog-open={ OpensheetRemoveDialogID } aria-haspopup="dialog" class="btn btn-ghost text-error">
						@icons.Icon("unlink", "size-4")
						{ d.Tr("opensheet.remove") }
					</button>
				</div>
			} else {
				<p class="flex items-center gap-2 text-sm text-base-content/70" data-opensheet-read-only="1">
					@icons.Icon("lock", "size-4 shrink-0")
					<span>{ d.Tr("opensheet.member_hint") }</span>
				</p>
			}
			<p class="text-xs text-base-content/70">{ d.Tr("opensheet.numbers_note") }</p>
			if !v.GrantLink {
				@AppCollapseOpen("gs-settings", "border border-base-300", v.State == OpensheetPaused, textTitle(d.Tr("opensheet.form.title"))) {
					@opensheetSetup(d, v)
				}
			}
		</div>
	</section>
}

templ opensheetSetup(d web.LayoutData, v OpensheetView) {
	<div class="flex flex-col gap-3">
		@AppCollapse("gs-need", "border border-base-300", textTitle(d.Tr("opensheet.tutorial.title"))) {
			@opensheetTutorial(d, v)
		}
		@opensheetForm(d, v)
	</div>
}

templ opensheetTutorial(d web.LayoutData, v OpensheetView) {
	<ol id="opensheet-tutorial" class="flex list-decimal flex-col gap-3 ps-5 text-sm">
		<li class="flex flex-col gap-2">
			<p>{ d.Tr("opensheet.tutorial.step1") }</p>
			<ul class="flex flex-col gap-2">
				for _, tab := range v.Tabs {
					<li class="flex flex-col gap-2 rounded-box bg-base-200 p-3" data-opensheet-tab={ tab.Slug }>
						<div class="flex flex-wrap items-center justify-between gap-2">
							<span class="font-medium">{ d.Tr(tab.LabelKey) }</span>
							@opensheetCopyButton(d, tab.HeaderTSV, d.Tr("opensheet.tutorial.copy_header"), d.Tr("opensheet.tutorial.copy_header")+": "+d.Tr(tab.LabelKey))
						</div>
						<code dir="ltr" class="block overflow-x-auto whitespace-nowrap text-start font-mono text-xs text-base-content/70" data-opensheet-header={ tab.Slug }>
							for i, col := range tab.Columns {
								if i > 0 {
									<span aria-hidden="true">{ " | " }</span>
								}
								{ col }
							}
						</code>
					</li>
				}
			</ul>
		</li>
		<li class="flex flex-col gap-2">
			<p>{ d.Tr("opensheet.tutorial.step2") }</p>
			<ul dir="ltr" class="flex flex-wrap gap-2 font-mono text-xs text-base-content/70 rtl:justify-end" data-opensheet-slugs>
				for _, tab := range v.Tabs {
					<li>{ tab.Slug }</li>
				}
			</ul>
		</li>
		<li><p>{ d.Tr("opensheet.tutorial.step3") }</p></li>
	</ol>
}

templ opensheetCopyButton(d web.LayoutData, value, text, label string) {
	<button
		type="button"
		data-copy={ value }
		data-copy-text={ text }
		data-copy-label={ label }
		data-copied-label={ d.Tr("common.copied") }
		aria-label={ label }
		class="btn btn-sm max-lg:btn-md"
	>{ text }</button>
}

templ opensheetField(d web.LayoutData, v OpensheetView, id, name, label, value string) {
	{{ f := FieldProps{ID: id, Label: label} }}
	@FormField(f) {
		<input
			{ f.Attrs()... }
			name={ name }
			type="text"
			dir="ltr"
			required
			value={ value }
			disabled?={ !v.CanManage }
			autocomplete="off"
			spellcheck="false"
			class="input w-full font-mono"
		/>
	}
}

templ opensheetForm(d web.LayoutData, v OpensheetView) {
	<div id="opensheet-form-panel" class="flex flex-col gap-3">
		if !v.CanManage {
			<p class="flex items-center gap-2 text-sm text-base-content/70" data-opensheet-read-only="1">
				@icons.Icon("lock", "size-4 shrink-0")
				<span>{ d.Tr("opensheet.manager_only") }</span>
			</p>
		}
		<form
			id="opensheet-form"
			method="post"
			action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/opensheet")) }
			hx-post={ d.ProjectPath(v.ProjectSlug, "/opensheet") }
			hx-nonce={ d.Nonce }
			hx-target="#opensheet-module"
			hx-swap="outerHTML"
			hx-disable="find button"
			hx-status:422="target:#opensheet-checks swap:outerHTML"
			hx-status:4xx="target:#hx-error swap:innerHTML"
			hx-status:5xx="target:#hx-error swap:innerHTML"
			class="flex flex-col gap-3"
		>
			@FormSection(d.Tr("opensheet.form.title")) {
				<div class="grid gap-3 sm:grid-cols-2">
					@opensheetField(d, v, "opensheet-os-org", "os_org", d.Tr("opensheet.form.os_org"), v.Form.OSOrg)
					@opensheetField(d, v, "opensheet-os-project", "os_project", d.Tr("opensheet.form.os_project"), v.Form.OSProject)
				</div>
				{{ key := FieldProps{ID: "opensheet-api-key", Label: d.Tr("opensheet.form.api_key"), Hint: d.Tr("opensheet.form.api_key_new")} }}
				if v.KeyHint != "" {
					{{ key.Hint = d.Tr("opensheet.form.api_key_hint", "Hint", v.KeyHint) }}
				}
				@FormField(key) {
					<input
						{ key.Attrs()... }
						name="api_key"
						type="password"
						dir="ltr"
						autocomplete="new-password"
						spellcheck="false"
						disabled?={ !v.CanManage }
						if v.KeyHint != "" {
							placeholder={ "•••• " + v.KeyHint }
						}
						class="input w-full font-mono"
					/>
				}
				<div class="grid gap-3 sm:grid-cols-3">
					@opensheetField(d, v, "opensheet-tx-sheet", "transactions_sheet", d.Tr("opensheet.tab.transaction")+" · "+d.Tr("opensheet.form.sheet_slug"), v.Form.TransactionsSheet)
					@opensheetField(d, v, "opensheet-wallet-sheet", "wallets_sheet", d.Tr("opensheet.tab.wallet")+" · "+d.Tr("opensheet.form.sheet_slug"), v.Form.WalletsSheet)
					@opensheetField(d, v, "opensheet-category-sheet", "categories_sheet", d.Tr("opensheet.tab.category")+" · "+d.Tr("opensheet.form.sheet_slug"), v.Form.CategoriesSheet)
				</div>
			}
			if v.CanManage {
				<div class="flex flex-wrap gap-2">
					<button
						type="button"
						hx-post={ d.ProjectPath(v.ProjectSlug, "/opensheet/test") }
						hx-nonce={ d.Nonce }
						hx-target="#opensheet-checks"
						hx-swap="outerHTML"
						hx-status:422="target:#opensheet-checks swap:outerHTML"
						hx-status:4xx="target:#hx-error swap:innerHTML"
						hx-status:5xx="target:#hx-error swap:innerHTML"
						class="btn"
					>
						@icons.Icon("list-checks", "size-4")
						{ d.Tr("opensheet.test") }
					</button>
					<button type="submit" class="btn btn-primary">{ d.Tr("opensheet.save") }</button>
				</div>
			}
		</form>
		@OpensheetChecks(d, v)
	</div>
}

templ opensheetCheckMark(d web.LayoutData, ok bool, labelKey string) {
	<li class={ "flex items-center gap-1", templ.KV("text-success", ok), templ.KV("text-error", !ok) } data-opensheet-check={ labelKey } data-ok={ strconv.FormatBool(ok) }>
		if ok {
			@icons.Icon("check", "size-3.5")
		} else {
			@icons.Icon("x", "size-3.5")
		}
		<span class="text-base-content">{ d.Tr(labelKey) }</span>
	</li>
}

// OpensheetChecks is the Test checklist; a refused Save or Test swaps only this, so the typed form values, the key included, stay in the browser.
templ OpensheetChecks(d web.LayoutData, v OpensheetView) {
	<div id="opensheet-checks" class="flex flex-col gap-2 empty:hidden" aria-live="polite">
		@pageBanner(d, v.ErrorKey, v.ErrorMsg, v.ErrorCode)
		if len(v.Checks) > 0 {
			<h3 class="text-sm font-medium">{ d.Tr("opensheet.check.title") }</h3>
			if v.SyncErrorInChecks() {
				<p class="text-xs text-error" data-opensheet-last-sync-error="true">{ d.Tr("opensheet.check.last_sync_error", "Error", v.LastError) }</p>
			}
			<ul class="flex flex-col gap-2">
				for _, c := range v.Checks {
					<li class="flex flex-col gap-2 rounded-box border border-base-300 p-3 text-sm" data-opensheet-result={ c.Sheet } data-ok={ strconv.FormatBool(c.OK) }>
						<div class="flex flex-wrap items-center justify-between gap-2">
							<span class="font-medium">{ d.Tr(c.LabelKey) } <code dir="ltr" class="font-mono text-xs text-base-content/70">{ c.Sheet }</code></span>
							if c.OK {
								<span class="badge badge-sm badge-soft badge-success">{ d.Tr("opensheet.check.ok") }</span>
							} else {
								<span class="badge badge-sm badge-soft badge-error">{ d.Tr("opensheet.check.failed") } <code dir="ltr" class="font-mono">{ c.Code }</code></span>
							}
						</div>
						if c.Unavailable {
							<p class="text-xs text-base-content/70">{ d.Tr("opensheet.check.unavailable") }</p>
						} else if c.PrivateEndpoint {
							<p class="text-xs text-error" data-opensheet-private-endpoint={ c.Sheet }>{ d.Tr("opensheet.check.private_endpoint") }</p>
						} else {
							<ul class="flex flex-wrap gap-x-4 gap-y-1 text-xs">
								@opensheetCheckMark(d, c.Reachable, "opensheet.check.reachable")
								if c.Reachable {
									@opensheetCheckMark(d, c.IDColumn, "opensheet.check.id_column")
									@opensheetCheckMark(d, c.Writable, "opensheet.check.writable")
									if !c.ColumnsDeferred {
										@opensheetCheckMark(d, c.Missing == "", "opensheet.check.columns")
									}
								}
							</ul>
							if c.ColumnsDeferred && c.Missing == "" {
								<p class="text-xs text-base-content/70" data-opensheet-columns-deferred={ c.Sheet }>{ d.Tr("opensheet.check.columns_deferred") }</p>
							}
							if !c.Reachable {
								<p class="text-xs text-base-content/70">{ d.Tr("opensheet.check.unreachable_hint") }</p>
							}
							if c.Missing != "" {
								<p class="text-xs text-error" data-opensheet-missing={ c.Sheet }>{ d.Tr("opensheet.check.missing", "Columns", c.Missing) }</p>
							}
							if c.MissingDeletedAt {
								<p class="text-xs text-base-content/70" data-opensheet-deleted-at-hint={ c.Sheet }>{ d.Tr("opensheet.check.deleted_at_hint") }</p>
							}
							if c.ContractReason != "" {
								<p class="text-xs text-error">{ d.Tr("opensheet.check.contract", "Reason", c.ContractReason) }</p>
							}
						}
					</li>
				}
			</ul>
		}
	</div>
}

templ opensheetSoon(d web.LayoutData) {
	<section aria-labelledby="gs-soon-h" class="card border border-dashed border-base-content/30 bg-base-200">
		<div class="card-body gap-3 p-4">
			<div class="flex flex-wrap items-center gap-3">
				<span aria-hidden="true" class="grid size-11 shrink-0 place-items-center rounded-field bg-base-100 text-success">
					@icons.Icon("sheet", "size-5")
				</span>
				<div class="min-w-0 flex-1">
					<h2 id="gs-soon-h" class="font-semibold">{ d.Tr("opensheet.soon.title") }</h2>
					<p class="text-sm text-base-content/70">{ d.Tr("opensheet.soon.body") }</p>
				</div>
				<span class="badge badge-sm badge-outline">{ d.Tr("opensheet.soon.badge") }</span>
			</div>
			<ul class="steps steps-vertical text-sm">
				<li class="step text-start">{ d.Tr("opensheet.soon.step1") }</li>
				<li class="step text-start">{ d.Tr("opensheet.soon.step2") }</li>
				<li class="step text-start">{ d.Tr("opensheet.soon.step3") }</li>
			</ul>
		</div>
	</section>
}

templ opensheetConnectBanner(d web.LayoutData, v OpensheetView) {
	if v.ConnectKey != "" {
		<div role="alert" data-opensheet-connect-outcome={ v.ConnectKey } class={ flashClass("warn") + " items-start text-sm" }>
			@icons.Icon("info", "size-5 shrink-0")
			<div class="flex min-w-0 flex-col gap-2">
				<p>
					{ d.Tr(v.ConnectKey) }
					if v.ConnectCode != "" {
						{ " " }
						<code dir="ltr" class="font-mono text-xs">{ v.ConnectCode }</code>
					}
				</p>
			</div>
		</div>
	}
}

templ opensheetConnectButton(d web.LayoutData, v OpensheetView, label, size, errTarget string) {
	<form
		method="post"
		action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/opensheet/connect")) }
		hx-post={ d.ProjectPath(v.ProjectSlug, "/opensheet/connect") }
		hx-nonce={ d.Nonce }
		hx-swap="none"
		hx-status:4xx={ "target:" + errTarget + " swap:innerHTML" }
		hx-status:5xx={ "target:" + errTarget + " swap:innerHTML" }
		class="contents"
	>
		<button type="submit" class={ "btn btn-primary", size }>
			<span class="loading loading-spinner loading-sm htmx-indicator hidden in-[.htmx-request]:inline-block" aria-hidden="true"></span>
			{ label }
		</button>
	</form>
}

templ opensheetOpenLink(d web.LayoutData, v OpensheetView, class string) {
	<a href={ templ.SafeURL(v.OpensheetURL) } target="_blank" rel="noopener" class={ class }>
		{ d.Tr("opensheet.connect.open") }
	</a>
}

templ opensheetConnect(d web.LayoutData, v OpensheetView) {
	<section aria-labelledby="gs-connect-h" class="card min-w-0 border border-base-300 bg-base-100" data-opensheet-connect="true">
		<div class="card-body gap-4 p-4">
			<h2 id="gs-connect-h" class="sr-only">{ d.Tr("opensheet.connect.card_heading") }</h2>
			<p class="flex flex-wrap items-center gap-x-2 text-sm">
				<span>{ d.Tr("opensheet.connect.via") }</span>
				@opensheetOpenLink(d, v, "link link-primary inline-flex items-center gap-1")
			</p>
			<div class="flex flex-col gap-2">
				<h3 class="text-sm font-semibold">{ d.Tr("opensheet.connect.before") }</h3>
				<ul class="flex flex-col gap-1 text-sm">
					<li class="flex items-center gap-2">
						@icons.Icon("check", "size-4 shrink-0 text-success")
						<span>{ d.Tr("opensheet.connect.need_project") }</span>
					</li>
					<li class="flex items-center gap-2">
						@icons.Icon("check", "size-4 shrink-0 text-success")
						<span>{ d.Tr("opensheet.connect.need_google") }</span>
					</li>
				</ul>
			</div>
			@opensheetConnectBanner(d, v)
			if v.CanManage {
				<div class="flex flex-col gap-2">
					<div id="opensheet-connect-error" class="empty:hidden"></div>
					<div>
						if v.ConnectKey != "" {
							@opensheetConnectButton(d, v, d.Tr("opensheet.connect.again"), "", "#opensheet-connect-error")
						} else {
							@opensheetConnectButton(d, v, d.Tr("opensheet.connect.button"), "", "#opensheet-connect-error")
						}
					</div>
					<p class="text-xs text-base-content/70">{ d.Tr("opensheet.connect.hint") }</p>
				</div>
			} else {
				<p class="flex items-center gap-2 text-sm text-base-content/70" data-opensheet-read-only="1">
					@icons.Icon("lock", "size-4 shrink-0")
					<span>{ d.Tr("opensheet.member_hint") }</span>
				</p>
			}
			if v.CanManage {
				@AppCollapse("gs-api-key", "border border-base-300", textTitle(d.Tr("opensheet.connect.api_key_instead"))) {
					@opensheetSetup(d, v)
				}
			}
		</div>
	</section>
}

templ opensheetPicker(d web.LayoutData, v OpensheetView) {
	<section aria-labelledby="gs-pick-h" class="card min-w-0 border border-base-300 bg-base-100" data-opensheet-picker="true">
		<form
			method="post"
			action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/opensheet/provision")) }
			hx-post={ d.ProjectPath(v.ProjectSlug, "/opensheet/provision") }
			hx-nonce={ d.Nonce }
			hx-target="#opensheet-module"
			hx-swap="outerHTML"
			hx-disable="find button"
			hx-status:422="target:#opensheet-module swap:outerHTML"
			hx-status:4xx="target:#hx-error swap:innerHTML"
			hx-status:5xx="target:#hx-error swap:innerHTML"
			class="card-body gap-4 p-4"
		>
			<h2 id="gs-pick-h" class="font-semibold">{ d.Tr("opensheet.picker.title") }</h2>
			@pageBanner(d, v.ErrorKey, v.ErrorMsg, v.ErrorCode)
			{{ target := FieldProps{ID: "opensheet-pick-target", Label: d.Tr("opensheet.picker.target"), Hint: d.Tr("opensheet.picker.target_hint")} }}
			@FormField(target) {
				<select { target.Attrs()... } name="target" required class="select w-full">
					for i, c := range v.PickTargets {
						<option value={ c.ID } selected?={ i == 0 }>{ c.Label }</option>
					}
				</select>
			}
			<p class="text-sm">
				<a href={ templ.SafeURL(v.OpensheetURL) } target="_blank" rel="noopener" class="link">{ d.Tr("opensheet.picker.missing_link") }</a>
			</p>
			<p class="text-sm text-base-content/70">{ d.Tr("opensheet.picker.copy_note") }</p>
			<div class="flex flex-wrap gap-2">
				<button type="submit" class="btn btn-primary">
					<span class="loading loading-spinner loading-sm htmx-indicator hidden in-[.htmx-request]:inline-block" aria-hidden="true"></span>
					{ d.Tr("opensheet.picker.create") }
				</button>
				@opensheetCancelConnect(d, v)
			</div>
		</form>
	</section>
}

templ opensheetSetupNeeded(d web.LayoutData, v OpensheetView) {
	<section aria-labelledby="gs-setup-needed-h" class="card min-w-0 border border-base-300 bg-base-100" data-opensheet-setup-needed="true">
		<div class="card-body gap-3 p-4">
			if v.Setup == "no_account" {
				<h2 id="gs-setup-needed-h" class="font-semibold">{ d.Tr("opensheet.setup.no_project.title") }</h2>
				<p class="text-sm">{ d.Tr("opensheet.setup.no_project.body") }</p>
			} else {
				<h2 id="gs-setup-needed-h" class="font-semibold">{ d.Tr("opensheet.setup.no_google.title") }</h2>
				if v.SetupProject != "" {
					<p class="text-sm">{ d.Tr("opensheet.setup.no_google.body", "Project", v.SetupProject) }</p>
				} else {
					<p class="text-sm">{ d.Tr("opensheet.setup.no_google.body_many") }</p>
				}
			}
			<p class="text-sm text-base-content/70">{ d.Tr("opensheet.setup.return_hint") }</p>
			<div class="flex flex-wrap gap-2">
				<a href={ templ.SafeURL(v.SetupURL) } target="_blank" rel="noopener" class="btn btn-primary">
					if v.Setup == "no_account" {
						{ d.Tr("opensheet.setup.no_project.action") }
					} else {
						{ d.Tr("opensheet.setup.no_google.action") }
					}
				</a>
				<a href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/opensheet")) } class="btn">
					@icons.Icon("refresh-cw", "size-4")
					{ d.Tr("opensheet.setup.refresh") }
				</a>
				@opensheetCancelConnect(d, v)
			</div>
		</div>
	</section>
}

// NOTE: a plain htmx button, not a form, because the picker renders it inside its own form.
templ opensheetCancelConnect(d web.LayoutData, v OpensheetView) {
	<button
		type="button"
		data-opensheet-cancel-connect="true"
		hx-post={ d.ProjectPath(v.ProjectSlug, "/opensheet/delete") }
		hx-nonce={ d.Nonce }
		hx-target="#opensheet-module"
		hx-swap="outerHTML"
		hx-status:4xx="target:#hx-error swap:innerHTML"
		hx-status:5xx="target:#hx-error swap:innerHTML"
		class="btn btn-ghost"
	>{ d.Tr("opensheet.picker.cancel") }</button>
}

templ opensheetReconnect(d web.LayoutData, v OpensheetView) {
	if v.grantLost() {
		<div role="alert" data-opensheet-reconnect={ v.Access } class={ flashClass("warn") + " items-start text-sm" }>
			@icons.Icon("unlink", "size-5 shrink-0")
			<div class="flex min-w-0 flex-col gap-2">
				<p class="font-semibold">{ d.Tr("opensheet.reconnect.title") }</p>
				if v.Access == "member_left" {
					<p>{ d.Tr("opensheet.reconnect.member_left") }</p>
				} else {
					<p>{ d.Tr("opensheet.reconnect.body") }</p>
				}
				if v.CanManage && v.CanConnect {
					<div class="flex flex-wrap gap-2">
						@opensheetConnectButton(d, v, d.Tr("opensheet.reconnect.button"), "btn-sm", "#hx-error")
						<button type="button" data-dialog-open={ OpensheetRemoveDialogID } aria-haspopup="dialog" class="btn btn-ghost btn-sm text-error">
							{ d.Tr("opensheet.remove") }
						</button>
					</div>
				}
			</div>
		</div>
	}
}
