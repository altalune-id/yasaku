package templates

templ brandMark(class string) {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class={ "shrink-0 text-brand", class }>
		<path d="M5.5 7.5 15.6 4.1a1.5 1.5 0 0 1 2 1.4v2"></path>
		<path d="M3 10a2.5 2.5 0 0 1 2.5-2.5h13A2.5 2.5 0 0 1 21 10v8a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 18Z"></path>
		<path d="M21 11.5h-3.5a2.5 2.5 0 0 0 0 5H21"></path>
		<path d="M17.5 14h.01"></path>
	</svg>
}

templ brandName() {
	<span class="text-lg font-extrabold tracking-tight">{ AppName }</span>
}
