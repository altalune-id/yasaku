package templates

import "altalune.id/yasaku/internal/web"

type OrgNewView struct {
	Slug  string
	Name  string
	Error string
	ErrorCode string
	Blocked   bool
}

templ OrgNewPage(d web.LayoutData, v OrgNewView) {
	<section class="mx-auto max-w-xl">
		<header class="border-b border-base-300 pb-4">
			<h1 class="text-2xl font-semibold text-base-content">{ d.Tr("nav.create_organization") }</h1>
			<p class="mt-1 text-sm text-base-content/70">{ d.Tr("org_new.subtitle") }</p>
		</header>
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		<form method="post" action={ templ.SafeURL(d.Href("/orgs")) } class="mt-6 space-y-5" novalidate>
			{{ orgNameField := FieldProps{ID: "org-name", Label: d.Tr("common.name")} }}
			@FormField(orgNameField) {
				<input { orgNameField.Attrs()... } name="name" type="text" dir="auto" required autofocus value={ v.Name } placeholder={ d.Tr("org_new.name_placeholder") } class="input w-full"/>
			}
			{{ slug := FieldProps{ID: "org-slug", Label: d.Tr("common.slug"), Hint: d.Tr("common.slug_hint")} }}
			@FormField(slug) {
				<input name="slug" type="text" value={ v.Slug } placeholder={ d.Tr("org_new.slug_placeholder") } pattern="[a-z0-9-]+" dir="ltr" class="input w-full font-mono" { slug.Attrs()... }/>
			}
			<div class="flex items-center gap-3 pt-2">
				if v.Blocked {
					<button type="submit" class="btn btn-primary" disabled data-limit-blocked>{ d.Tr("nav.create_organization") }</button>
				} else {
					<button type="submit" class="btn btn-primary">{ d.Tr("nav.create_organization") }</button>
				}
				<a href={ templ.SafeURL(d.Href("/")) } class="btn btn-ghost">{ d.Tr("common.cancel") }</a>
			</div>
		</form>
	</section>
}

templ OrgNewLayout(d web.LayoutData, v OrgNewView) {
	@Layout(web.WithContent(d, OrgNewPage(d, v)))
}
