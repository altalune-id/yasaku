# Binaries and build output
/bin/
/dist/
*.exe

# Test + coverage
*.out
*.test
coverage.*
.cover/

# Environment
.env
.env.local
.env.*
!.env.example

# Signing artifacts and keys
*.sig
*.pem

# Local state
*.db
*.db-journal
~/.yasaku/

# Editor
.idea/
*.swp
.DS_Store

# Node toolchain (pnpm-managed buf CLI)
node_modules/
.pnpm-store/

# SDD workspace (scratch, not shipped)
/.superpowers/
/docs/superpowers/

# App data
.yasaku-data
.cache

# Debugging / profiling
*.prof
.playwright-mcp

# Local compose stack data (postgres bind mount, etc.).
# Track the dir via .gitkeep, ignore every child (pg, future subdirs).
/docker/data/*
!/docker/data/.gitkeep

# Vendored UI assets fetched by scripts/ui-vendor.sh (charts.js is hand-written and tracked)
/internal/web/static/htmx.min.js
/internal/web/static/easymde.min.js
/internal/web/static/easymde.min.css
/internal/web/static/echarts.min.js
/internal/web/static/basecoat.css
/internal/web/static/app.css
/internal/web/static/app.tailwind.css
