#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"
set -e

zero=0000000000000000000000000000000000000000
echo "→ verify signatures on outgoing commits"
while read -r _ local_sha _ remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes"
    else
        range="${remote_sha}..${local_sha}"
    fi
    for c in $(git rev-list $range); do
        if ! git verify-commit "$c" >/dev/null 2>&1; then
            echo "commit $c is not GPG/SSH-signed — server-side branch protection will reject it." >&2
            echo "fix: git config commit.gpgsign true && git rebase --exec 'git commit --amend --no-edit -S' <base>" >&2
            exit 1
        fi
    done
done

git fetch --quiet origin main 2>/dev/null || echo "warn: cannot fetch origin/main — using the local ref"
has_main=
git rev-parse --verify --quiet origin/main >/dev/null && has_main=1

echo "→ gofmt -l ."
if [ -n "$(gofmt -l .)" ]; then
    echo "gofmt: the following files need formatting:" >&2
    gofmt -l . >&2
    exit 1
fi

echo "→ go vet ./..."
go vet ./...

echo "→ pnpm exec buf lint"
pnpm exec buf lint

echo "→ go tool gen-config-example --check"
go tool gen-config-example --check
echo "→ go tool gen-config-example --format=yaml --check"
go tool gen-config-example --format=yaml --check

echo "→ go tool i18n-lint --check"
go tool i18n-lint --check

echo "→ go tool comment-lint ."
go tool comment-lint .

echo "→ golangci-lint run"
golangci-lint run --timeout=3m ./...

echo "→ buf breaking vs origin/main"
if [ -z "$has_main" ]; then
    echo "warn: no origin/main — skipping buf breaking"
elif git ls-tree -r origin/main --name-only | grep -q '\.proto$'; then
    pnpm exec buf breaking --against '.git#branch=origin/main' || {
        echo "buf breaking failed — proto API surface may have broken"; exit 1;
    }
else
    echo "warn: origin/main has no .proto files — skipping buf breaking"
fi

echo "→ goreleaser check"
if command -v goreleaser >/dev/null 2>&1; then
    goreleaser check
else
    echo "warn: goreleaser not installed — skipping (brew install goreleaser to enable)"
fi

serial=
[ -n "$TEST_PG_DSN" ] && serial="-p 1"

if [ -n "$PREPUSH_FULL" ] || [ -z "$has_main" ]; then
    echo "→ go test -race -shuffle=on $serial ./..."
    go test -race -shuffle=on $serial ./...
else
    pkgs=$(git diff --name-only origin/main...HEAD | while IFS= read -r f; do
        d=$(dirname "$f" | sed 's#^testdata\(/.*\)\{0,1\}$#.#; s#/testdata\(/.*\)\{0,1\}$##')
        while [ "$d" != "." ]; do
            if ls "$d"/*.go >/dev/null 2>&1; then
                echo "./$d"
                break
            fi
            d=$(dirname "$d")
        done
    done | sort -u)
    if [ -z "$pkgs" ]; then
        echo "→ go test: no Go package changed vs origin/main — skipping (PREPUSH_FULL=1 runs every test)"
    else
        echo "→ go test -race -shuffle=on $serial (packages changed vs origin/main; PREPUSH_FULL=1 runs every test)"
        go test -race -shuffle=on $serial $pkgs
    fi
fi

echo "→ pre-push OK"
