# yasaku — auto-generated from internal/platform/config struct tags.
# DO NOT edit by hand. Run `go tool gen-config-example` to regenerate.
#
# Awareness markers on each field (in [brackets] above the env var):
#   required   — must be non-empty for the app to boot (in the applicable mode)
#   bootstrap  — set once at first-run; changing later has no effect or breaks things
#   secret     — never commit; use env vars or a secret store
#   mode:X     — only applies in the given mode (selfhosted | cloud)
#
# Fields split into two top-level sections:
#   BOOTSTRAP — locked at first boot, changing later is NOT SAFE
#   RUNTIME   — safe to change via env + restart
#
# RHS shows the built-in default when present. Secret fields intentionally
# emit no RHS value, even if a default exists internally.


# ════════════════════════════════════════════════════════════════════
#   BOOTSTRAP — set once at first boot; changing later is NOT SAFE
# ════════════════════════════════════════════════════════════════════
#
# Fields in this section lock in behavior for the lifetime of the deployment:
#   - Changing them via env vars after first boot has NO effect on already-
#     persisted data (e.g., db.driver is set at first migration; switching
#     from sqlite→postgres requires a full data migration, not an env flip).
#   - Some fields are secrets used to sign existing tokens/cookies
#     (http.stateSecret) — rotating invalidates in-flight sessions.
#   - Some fields are database-layer decisions (schema, tablePrefix) that
#     require SQL-level intervention to change.
#
# Read every line here BEFORE first `yasaku serve`. Set them deliberately.
#
# ────────────────────────────────────────────────────────────────────

# ─── db ───
# [required, bootstrap] db.driver
YASAKU_DB_DRIVER=sqlite
# [bootstrap] db.schema
YASAKU_DB_SCHEMA=public
# [bootstrap] db.tablePrefix
YASAKU_DB_TABLE_PREFIX=yasaku_
# [bootstrap] db.role
YASAKU_DB_ROLE=
# [secret, bootstrap] db.migrator.dsn
YASAKU_DB_MIGRATOR_DSN=
# [bootstrap] db.migrator.role
YASAKU_DB_MIGRATOR_ROLE=
# [bootstrap] db.reader.role
YASAKU_DB_READER_ROLE=
# [bootstrap] db.allowBypassRLS
YASAKU_DB_ALLOW_BYPASS_RLS=

# ─── genesis ───
# [bootstrap, secret] genesis.password
YASAKU_GENESIS_PASSWORD=

# ── cloud only ──
# [bootstrap, mode:cloud] genesis.breakGlass
YASAKU_GENESIS_BREAK_GLASS=false

# ─── http ───
# [required, secret, bootstrap] http.stateSecret
YASAKU_HTTP_STATE_SECRET=

# ─── i18n ───
# [required, bootstrap] i18n.defaultLocale
YASAKU_I18N_DEFAULT_LOCALE=en-US

# ─── log ───
# [bootstrap] log.redactPatterns
YASAKU_LOG_REDACT_PATTERNS=

# ─── mcp ───
# [bootstrap] mcp.enabled
YASAKU_MCP_ENABLED=false
# [bootstrap] mcp.audience
YASAKU_MCP_AUDIENCE=

# ─── mode ───
# [required, bootstrap] mode
YASAKU_MODE=selfhosted

# ─── scheduler ───
# [bootstrap] scheduler.enabled
YASAKU_SCHEDULER_ENABLED=true
# [bootstrap] scheduler.timezone
YASAKU_SCHEDULER_TIMEZONE=UTC

# ─── security ───
# [required, secret, bootstrap] security.encryptionKey
YASAKU_SECURITY_ENCRYPTION_KEY=

# ─── tenant ───
# [bootstrap] tenant.rlsEnforce
YASAKU_TENANT_RLS_ENFORCE=true
# [bootstrap] tenant.singletonOrg.slug
YASAKU_TENANT_SINGLETON_ORG_SLUG=default
# [bootstrap] tenant.singletonOrg.name
YASAKU_TENANT_SINGLETON_ORG_NAME=Default Organization
# [bootstrap] tenant.tenantScopedTables
YASAKU_TENANT_TENANT_SCOPED_TABLES=

# ─── tokens ───

# ── cloud only ──
# [required, mode:cloud, bootstrap] tokens.audience
YASAKU_TOKENS_AUDIENCE=urn:yasaku:api


# ════════════════════════════════════════════════════════════════════
#   RUNTIME — safe to change via env + restart
# ════════════════════════════════════════════════════════════════════
#
# Fields in this section can be adjusted between deployments without
# affecting persisted data. Restarting the app picks up the new values.
#
# ────────────────────────────────────────────────────────────────────

# ─── api ───
# api.enabled
YASAKU_API_ENABLED=true
# api.openapi.enabled
YASAKU_API_OPENAPI_ENABLED=true
# api.openapi.requireBasicAuth
YASAKU_API_OPENAPI_REQUIRE_BASIC_AUTH=true
# api.openapi.basicAuthUser
YASAKU_API_OPENAPI_BASIC_AUTH_USER=
# [secret] api.openapi.basicAuthPassword
YASAKU_API_OPENAPI_BASIC_AUTH_PASSWORD=

# ─── compliance ───
# compliance.termsURL
YASAKU_COMPLIANCE_TERMS_URL=
# compliance.privacyURL
YASAKU_COMPLIANCE_PRIVACY_URL=
# compliance.requireAcceptance
YASAKU_COMPLIANCE_REQUIRE_ACCEPTANCE=

# ─── db ───
# [required, secret] db.dsn
YASAKU_DB_DSN=
# [secret] db.reader.dsn
YASAKU_DB_READER_DSN=
# db.reader.maxOpenConns
YASAKU_DB_READER_MAX_OPEN_CONNS=
# db.reader.maxIdleConns
YASAKU_DB_READER_MAX_IDLE_CONNS=
# db.reader.connMaxLifetime
YASAKU_DB_READER_CONN_MAX_LIFETIME=
# db.reader.connMaxIdleTime
YASAKU_DB_READER_CONN_MAX_IDLE_TIME=
# db.health.interval
YASAKU_DB_HEALTH_INTERVAL=30s
# db.health.timeout
YASAKU_DB_HEALTH_TIMEOUT=2s
# db.autoMigrate
YASAKU_DB_AUTO_MIGRATE=true
# db.maxOpenConns
YASAKU_DB_MAX_OPEN_CONNS=
# db.maxIdleConns
YASAKU_DB_MAX_IDLE_CONNS=
# db.connMaxLifetime
YASAKU_DB_CONN_MAX_LIFETIME=
# db.connMaxIdleTime
YASAKU_DB_CONN_MAX_IDLE_TIME=
# db.connectTimeout
YASAKU_DB_CONNECT_TIMEOUT=30s
# db.connectBackoff
YASAKU_DB_CONNECT_BACKOFF=250ms

# ─── genesis ───
# genesis.email
YASAKU_GENESIS_EMAIL=

# ─── http ───
# [required] http.addr
YASAKU_HTTP_ADDR=:5150
# http.basePath
YASAKU_HTTP_BASE_PATH=
# [required] http.baseURL
YASAKU_HTTP_BASE_URL=
# http.cookieSecure
YASAKU_HTTP_COOKIE_SECURE=false
# http.robotsTxt
YASAKU_HTTP_ROBOTS_TXT=

# ─── log ───
# log.level
YASAKU_LOG_LEVEL=info
# log.format
YASAKU_LOG_FORMAT=json
# log.addSource
YASAKU_LOG_ADD_SOURCE=

# ─── mail ───
# mail.driver
YASAKU_MAIL_DRIVER=console
# mail.from
YASAKU_MAIL_FROM=no-reply@yasaku.local
# mail.smtp.host
YASAKU_MAIL_SMTP_HOST=
# mail.smtp.port
YASAKU_MAIL_SMTP_PORT=587
# mail.smtp.user
YASAKU_MAIL_SMTP_USER=
# [secret] mail.smtp.pass
YASAKU_MAIL_SMTP_PASS=
# mail.smtp.tls
YASAKU_MAIL_SMTP_TLS=true
# [secret] mail.resend.apiKey
YASAKU_MAIL_RESEND_API_KEY=
# mail.resend.endpoint
YASAKU_MAIL_RESEND_ENDPOINT=
# mail.resend.maxAttempts
YASAKU_MAIL_RESEND_MAX_ATTEMPTS=3

# ─── mcp ───
# mcp.audienceOverride
YASAKU_MCP_AUDIENCE_OVERRIDE=
# mcp.challengeToken
YASAKU_MCP_CHALLENGE_TOKEN=
# mcp.appsUI
YASAKU_MCP_APPS_UI=false

# ─── observability ───
# observability.reporter.minSeverity
YASAKU_OBSERVABILITY_REPORTER_MIN_SEVERITY=error
# observability.reporter.sinks
YASAKU_OBSERVABILITY_REPORTER_SINKS=

# ─── oidc ───
# oidc.resource
YASAKU_OIDC_RESOURCE=
# oidc.scopes
YASAKU_OIDC_SCOPES=openid,email,profile
# oidc.redirectPort
YASAKU_OIDC_REDIRECT_PORT=
# oidc.buttonLabel
YASAKU_OIDC_BUTTON_LABEL=
# oidc.buttonLogoURL
YASAKU_OIDC_BUTTON_LOGO_URL=
# oidc.endSessionOnLogout
YASAKU_OIDC_END_SESSION_ON_LOGOUT=

# ── cloud only ──
# [required, mode:cloud] oidc.issuer
YASAKU_OIDC_ISSUER=
# [required, mode:cloud] oidc.clientID
YASAKU_OIDC_CLIENT_ID=
# [required, mode:cloud, secret] oidc.clientSecret
YASAKU_OIDC_CLIENT_SECRET=

# ─── onboard ───
# [secret] onboard.setupToken
YASAKU_ONBOARD_SETUP_TOKEN=

# ─── scheduler ───
# scheduler.shutdownGrace
YASAKU_SCHEDULER_SHUTDOWN_GRACE=30s

# ─── session ───
# session.path
YASAKU_SESSION_PATH=~/.yasaku/session.json

# ─── telemetry ───
# telemetry.otlp.endpoint
YASAKU_TELEMETRY_OTLP_ENDPOINT=
# telemetry.otlp.protocol
YASAKU_TELEMETRY_OTLP_PROTOCOL=
# telemetry.otlp.insecure
YASAKU_TELEMETRY_OTLP_INSECURE=
# [secret] telemetry.otlp.headers
YASAKU_TELEMETRY_OTLP_HEADERS=
# telemetry.tracing.enabled
YASAKU_TELEMETRY_TRACING_ENABLED=false
# telemetry.tracing.sampleRatio
YASAKU_TELEMETRY_TRACING_SAMPLE_RATIO=
# telemetry.metrics.enabled
YASAKU_TELEMETRY_METRICS_ENABLED=false
# telemetry.metrics.exportInterval
YASAKU_TELEMETRY_METRICS_EXPORT_INTERVAL=30s
# telemetry.metrics.prometheus.enabled
YASAKU_TELEMETRY_METRICS_PROMETHEUS_ENABLED=false
# telemetry.metrics.prometheus.addr
YASAKU_TELEMETRY_METRICS_PROMETHEUS_ADDR=:9091
# telemetry.metrics.prometheus.path
YASAKU_TELEMETRY_METRICS_PROMETHEUS_PATH=/metrics

# ─── tenant ───
# tenant.personalOrgSlugFallback
YASAKU_TENANT_PERSONAL_ORG_SLUG_FALLBACK=personal
# tenant.personalProjectSlug
YASAKU_TENANT_PERSONAL_PROJECT_SLUG=default

# ─── tokens ───
# tokens.jwksCacheTTL
YASAKU_TOKENS_JWKS_CACHE_TTL=
# tokens.clockSkew
YASAKU_TOKENS_CLOCK_SKEW=60s
# tokens.supportedAlgs
YASAKU_TOKENS_SUPPORTED_ALGS=RS256,ES256
# tokens.acceptRS256
YASAKU_TOKENS_ACCEPT_RS256=

# ── cloud only ──
# [required, mode:cloud] tokens.issuer
YASAKU_TOKENS_ISSUER=
# [required, mode:cloud] tokens.jwksURL
YASAKU_TOKENS_JWKS_URL=
